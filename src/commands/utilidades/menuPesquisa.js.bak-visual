'use strict';

/**
 * Menu Pesquisa — so fontes ativas (sem API + Pexels/Unsplash/Claude)
 * Nao altera outros menus.
 */

function boxMenu() {
  return (
    '╭──〔 📚 𝐌𝐄𝐍𝐔 𝐏𝐄𝐒𝐐𝐔𝐈𝐒𝐀 〕──╮\n' +
    '│\n' +
    '│  🔎 *GERAL*\n' +
    '│  ◈ *pesquisa* <texto>\n' +
    '│  ◈ *wikipedia* / *wiki* <texto>\n' +
    '│  ◈ *duckduckgo* / *ddg* <texto>\n' +
    '│\n' +
    '│  💻 *DOCS / CODIGO*\n' +
    '│  ◈ *mdn* <texto>\n' +
    '│  ◈ *npm* <pacote>\n' +
    '│  ◈ *pypi* <pacote>\n' +
    '│\n' +
    '│  🔬 *CIENCIA*\n' +
    '│  ◈ *arxiv* <tema>\n' +
    '│  ◈ *pubmed* <tema>\n' +
    '│  ◈ *openalex* <tema>\n' +
    '│\n' +
    '│  🖼️ *IMAGENS*\n' +
    '│  ◈ *imagem* <texto>\n' +
    '│  ◈ *openverseimg* <texto>\n' +
    '│  ◈ *wikimediacommons* <texto>\n' +
    '│  ◈ *pexels* <texto> 🔑\n' +
    '│  ◈ *unsplash* <texto> 🔑\n' +
    '│\n' +
    '│  🎬 *VIDEO*\n' +
    '│  ◈ *video* / *videosearch* <texto>\n' +
    '│  ◈ *openversevid* <texto>\n' +
    '│\n' +
    '│  🤖 *IA*\n' +
    '│  ◈ *bia* / *ia* <texto>\n' +
    '│  ◈ *claude* <texto> 🔑\n' +
    '│\n' +
    '│  📋 *UTIL*\n' +
    '│  ◈ *fontesativas*\n' +
    '│  ◈ *catalogocompleto*\n' +
    '│\n' +
    '│  🔑 = precisa API no .env\n' +
    '╰──〔 𝐁𝐄𝐀𝐓𝐑𝐈𝐙 𝐁𝐎𝐓 〕──╯'
  );
}

async function doPesquisa(ctx) {
  const q = (ctx.args || []).join(' ').trim();
  if (!q) return ctx.reply('Ex: *pesquisa inteligencia artificial*');
  try {
    const engine = require('../../services/search/engine');
    if (engine && engine.searchWeb) {
      const r = await engine.searchWeb(q);
      if (r) {
        return ctx.reply(
          '╭──〔 🔎 PESQUISA 〕──╮\n' +
          '│ 🔍 ' + q.slice(0, 80) + '\n' +
          '│ 🌐 ' + (r.source || 'web') + '\n' +
          '│\n' +
          '│ ' + String(r.summary || '').slice(0, 700).replace(/\n/g, '\n│ ') + '\n' +
          (r.url ? '│ 🔗 ' + r.url + '\n' : '') +
          '╰──────────────────╯'
        );
      }
    }
  } catch (e) {}
  try {
    const p = require('../../services/search/providers');
    if (p.wikipedia) {
      const r = await p.wikipedia(q);
      return ctx.reply(
        '📖 *Wikipedia*\n' + String(r.summary || '').slice(0, 900) + (r.url ? '\n🔗 ' + r.url : '')
      );
    }
  } catch (e2) {}
  return ctx.reply('❌ Sem resultado para: ' + q);
}

async function doImagem(ctx) {
  const q = (ctx.args || []).join(' ').trim();
  if (!q) return ctx.reply('Ex: *imagem gato*');
  try { await ctx.reply('🖼️ A procurar...'); } catch (x) {}
  try {
    const p = require('../../services/search/providers');
    let r = null;
    if (p.openverseImage) try { r = await p.openverseImage(q); } catch (e) {}
    if (!r && p.wikimediaImage) try { r = await p.wikimediaImage(q); } catch (e) {}
    if (!r && p.pexelsImage) try { r = await p.pexelsImage(q); } catch (e) {}
    if (!r) return ctx.reply('❌ Sem imagem.');
    const cap = '🖼️ *' + (r.source || 'Imagem') + '*\n🔎 ' + q;
    if (typeof ctx.sendImage === 'function') return ctx.sendImage(r.imageUrl, cap);
    if (ctx.sock && ctx.jid) {
      return ctx.sock.sendMessage(ctx.jid, { image: { url: r.imageUrl }, caption: cap });
    }
    return ctx.reply(cap + '\n' + r.imageUrl);
  } catch (err) {
    return ctx.reply('❌ Erro na imagem.');
  }
}

async function doVideo(ctx) {
  const q = (ctx.args || []).join(' ').trim();
  if (!q) return ctx.reply('Ex: *video natureza*');
  try {
    const p = require('../../services/search/providers');
    if (p.openverseVideo) {
      const r = await p.openverseVideo(q);
      return ctx.reply(
        '╭──〔 🎬 VIDEO 〕──╮\n' +
        '│ 🔎 ' + q + '\n' +
        '│ 🎬 ' + String(r.title || '').slice(0, 80) + '\n' +
        '│ 🌐 ' + (r.source || 'Openverse') + '\n' +
        (r.pageUrl ? '│ 🔗 ' + r.pageUrl + '\n' : '') +
        '╰────────────────╯'
      );
    }
  } catch (e) {}
  return ctx.reply('❌ Sem video nas fontes publicas.');
}

module.exports = [
  {
    name: 'menupesquisa',
    aliases: ['menupesq', 'pesquisamenu', 'menu pesquisa'],
    category: 'utilidades',
    description: 'Menu Pesquisa',
    async handler(ctx) {
      return ctx.reply(boxMenu());
    }
  },
  {
    name: 'pesquisa',
    aliases: ['search', 'buscar'],
    category: 'utilidades',
    description: 'Pesquisa web',
    handler: doPesquisa
  },
  {
    name: 'imagem',
    aliases: ['imgsearch', 'buscarimagem'],
    category: 'utilidades',
    description: 'Busca imagem',
    handler: doImagem
  },
  {
    name: 'video',
    aliases: ['buscarvideo'],
    category: 'utilidades',
    description: 'Busca video',
    handler: doVideo
  }
];
