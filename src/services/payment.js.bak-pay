/**
 * Serviço de detecção e validação de pagamentos
 * M-Pesa / E-Mola / M-Kash
 */

const db = require('../database');
const { getDb } = require('../database');

/**
 * Analisa comprovativo e tenta vincular a um pedido
 */
function analyzePayment(paymentData, senderJid) {
  const database = getDb();
  const { transactionId, value, fee, destinationNumber, destinationName, provider, date, time, raw } = paymentData;

  // 1. Verifica se o ID já foi usado
  if (transactionId) {
    const existing = database.prepare('SELECT * FROM payments WHERE transaction_id = ?').get(transactionId);
    if (existing) {
      return {
        status: 'PAGAMENTO_JA_UTILIZADO',
        message: '⚠️ Esta transação já foi utilizada anteriormente.',
        payment: existing
      };
    }
  }

  // 2. Busca pedidos pendentes que batem com valor/número
  let order = null;
  const pendingOrders = database.prepare(`
    SELECT * FROM orders 
    WHERE status = 'pending' 
    ORDER BY created_at DESC
  `).all();

  for (const o of pendingOrders) {
    let score = 0;
    if (value && Math.abs(o.value_expected - value) < 0.01) score += 3;
    if (destinationNumber && o.number_expected && destinationNumber.includes(o.number_expected.slice(-9))) score += 2;
    if (destinationName && o.name_expected && destinationName.toLowerCase().includes(o.name_expected.toLowerCase().slice(0, 5))) score += 1;

    if (score >= 3) {
      order = o;
      break;
    }
  }

  // 3. Determina status
  let status = 'PAGAMENTO_NAO_ENCONTRADO';
  let message = '';

  if (!transactionId && !value) {
    status = 'PAGAMENTO_INVALIDO';
    message = '❌ Pagamento não confirmado. Dados insuficientes no comprovativo.';
  } else if (order) {
    // Valor bate?
    if (value && Math.abs(order.value_expected - value) > 0.5) {
      status = 'PAGAMENTO_SUSPEITO';
      message = '⚠️ Pagamento em análise. Valor diferente do esperado.';
    } else {
      status = 'PAGAMENTO_VALIDO';
      message = '✅ *Pagamento confirmado!*';
    }
  } else if (value) {
    status = 'PAGAMENTO_SUSPEITO';
    message = '⚠️ Pagamento em análise. Nenhum pedido correspondente encontrado automaticamente.';
  } else {
    status = 'PAGAMENTO_INVALIDO';
    message = '❌ Pagamento não confirmado.';
  }

  // 4. Salva no banco
  const insert = database.prepare(`
    INSERT INTO payments (
      order_id, transaction_id, provider, value_received, fee,
      destination_number, destination_name, date, time, raw_message, status
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `);

  const info = insert.run(
    order ? order.id : null,
    transactionId || null,
    provider,
    value || null,
    fee || null,
    destinationNumber || null,
    destinationName || null,
    date || null,
    time || null,
    raw,
    status
  );

  // 5. Se válido e tem pedido, marca pedido como pago
  if (status === 'PAGAMENTO_VALIDO' && order) {
    database.prepare(`UPDATE orders SET status = 'paid' WHERE id = ?`).run(order.id);
  }

  const paymentRecord = database.prepare('SELECT * FROM payments WHERE id = ?').get(info.lastInsertRowid);

  return {
    status,
    message,
    payment: paymentRecord,
    order
  };
}

/**
 * Formata resposta de detecção
 */
function formatDetectionReply(paymentData, analysis) {
  const { provider, transactionId, value, destinationName, date, time } = paymentData;
  const provName = { mpesa: 'M-Pesa', emola: 'E-Mola', mkash: 'M-Kash' }[provider] || provider;

  let text = `🧾 *Comprovativo detectado (${provName})*\n\n`;
  if (transactionId) text += `🔑 Chave: \`${transactionId}\`\n`;
  if (destinationName) text += `🏦 Destino: ${destinationName}\n`;
  if (value) text += `💵 Valor: ${value.toFixed(2)} MT\n`;
  if (date || time) text += `⏰ Recebido em: ${time || ''} ${date || ''}\n`;
  text += `\n${analysis.message}\n`;

  if (analysis.status === 'PAGAMENTO_VALIDO') {
    text += `\n💰 Valor: ${value?.toFixed(2) || '?'} MT\n`;
    text += `🧾 Transação: ${transactionId || '?'}\n`;
    text += `📌 Status: PAGAMENTO_VALIDO`;
  }

  return text;
}

module.exports = {
  analyzePayment,
  formatDetectionReply
};
