      const r = divine.makePact(n.data, id);
      if (!r.ok) return ctx.reply(r.msg);
      save(ctx, n.group, n.data);
      await ctx.reply('PACTO com ' + r.god.emoji + ' ' + r.god.name);
    }},
  { name: 'iskpacto_quebrar', category: 'isekai',
