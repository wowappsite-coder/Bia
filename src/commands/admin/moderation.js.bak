          text += `${i + 1}. @${a.id.replace('@s.whatsapp.net', '')}\n`;
        });
        await ctx.reply(text, { mentions: admins.map(a => a.id) });
      } catch {
        await ctx.reply('❌ Erro.');
      }
    }
