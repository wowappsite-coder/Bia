    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      try {
        await ctx.sock.groupParticipantsUpdate(ctx.jid, [target], 'remove');
        const used = String((ctx.command || (ctx.parsed && ctx.parsed.command) || 'ban')).toLowerCase();
        const kind = (used === 'kick' || used === 'expulsar' || used === 'remover' || used === 'remove') ? 'kick' : 'ban';
        await ctx.reply(formatBanKickMsg(ctx, target, kind), { mentions: [target] });
      } catch (e) {
        await ctx.reply('❌ Não foi possível remover. Verifique se o bot é admin.');
      }
    }
  },
