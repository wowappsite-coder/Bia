/**
 * Trivia / Quiz — perguntas dificeis + dia a dia internacional
 * Enquete + resposta por letra (A-F) ou numero (1-6)
 * Primeiro a acertar ganha ponto | rankingtrivia
 */
const { tag } = require('../../utils/mention');

let getDb = null;
try {
  getDb = require('../../database').getDb;
} catch (_) {}

const active = new Map(); // groupJid -> { q, opts, correct: number[], msgId, answered }
const bags = new Map();   // groupJid -> indices restantes

function ensureTable() {
  if (!getDb) return;
  try {
    getDb().exec(`
      CREATE TABLE IF NOT EXISTS trivia_scores (
        group_jid TEXT NOT NULL,
        user_jid TEXT NOT NULL,
        points INTEGER DEFAULT 0,
        PRIMARY KEY (group_jid, user_jid)
      )
    `);
  } catch (_) {}
}

function addPoint(groupJid, userJid) {
  ensureTable();
  if (!getDb) return;
  try {
    const db = getDb();
    const row = db.prepare(
      'SELECT points FROM trivia_scores WHERE group_jid = ? AND user_jid = ?'
    ).get(groupJid, userJid);
    if (row) {
      db.prepare(
        'UPDATE trivia_scores SET points = points + 1 WHERE group_jid = ? AND user_jid = ?'
      ).run(groupJid, userJid);
    } else {
      db.prepare(
        'INSERT INTO trivia_scores (group_jid, user_jid, points) VALUES (?, ?, 1)'
      ).run(groupJid, userJid);
    }
  } catch (e) {
    console.error('[trivia] score', e.message);
  }
}

function getRanking(groupJid, limit) {
  ensureTable();
  if (!getDb) return [];
  try {
    return getDb().prepare(
      'SELECT user_jid, points FROM trivia_scores WHERE group_jid = ? ORDER BY points DESC LIMIT ?'
    ).all(groupJid, limit || 10);
  } catch (_) {
    return [];
  }
}

function shuffle(a) {
  const arr = a.slice();
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const t = arr[i];
    arr[i] = arr[j];
    arr[j] = t;
  }
  return arr;
}

/** correct: indices originais das respostas certas (0-based) */

function loadQuestions() {
  const parts = [];
  for (let i = 1; i <= 4; i++) {
    try {
      parts.push.apply(parts, require('./trivia_q' + i));
    } catch (e) {
      // parte ainda nao existe
    }
  }
  return parts.length ? parts : [];
}
const QUESTIONS = loadQuestions();

function pickQuestion(groupJid) {
  let bag = bags.get(groupJid);
  if (!bag || !bag.length) {
    bag = shuffle(QUESTIONS.map(function (_, i) { return i; }));
    bags.set(groupJid, bag);
  }
  const idx = bag.pop();
  return QUESTIONS[idx];
}

/** Embaralha opcoes e recalcula indices corretos */
function prepareQuestion(item) {
  const indexed = item.opts.map(function (text, i) {
    return { text: text, wasCorrect: item.correct.indexOf(i) !== -1 };
  });
  // garantir que respostas certas entram
  const must = indexed.filter(function (x) { return x.wasCorrect; });
  const rest = shuffle(indexed.filter(function (x) { return !x.wasCorrect; }));
  // exatamente 4 opcoes
  let pick = must.concat(rest).slice(0, 4);
  // se tiver menos de 4, preencher com o que houver
  while (pick.length < 4 && rest.length) {
    const n = rest.pop();
    if (n && pick.indexOf(n) === -1) pick.push(n);
  }
  pick = shuffle(pick).slice(0, 4);
  const opts = pick.map(function (x) { return x.text; });
  const correct = [];
  pick.forEach(function (x, i) {
    if (x.wasCorrect) correct.push(i);
  });
  // se por algum motivo nao houver correta, marca a 0
  if (!correct.length) correct.push(0);
  return { q: item.q, opts: opts, correct: correct };
}

function letters() {
  return ['A', 'B', 'C', 'D', 'E', 'F'];
}

async function sendTrivia(ctx) {
  if (!ctx.isGroup) {
    return ctx.reply('❌ Trivia so em *grupos*.');
  }
  if (active.has(ctx.jid) && !active.get(ctx.jid).answered) {
    return ctx.reply('⚠️ Ja ha uma trivia aberta neste grupo.\nResponde com *A-F* ou *1-6*.');
  }

  const raw = pickQuestion(ctx.jid);
  const item = prepareQuestion(raw);
  const L = letters();
  const lines = item.opts.map(function (o, i) {
    return L[i] + ') ' + o;
  });

  const header =
    '╭──〔 🧠 𝐓𝐑𝐈𝐕𝐈𝐀 〕──╮\n' +
    '> ' + item.q + '\n' +
    '❀────────────────❀\n' +
    lines.map(function (l) { return '◈┃ ' + l; }).join('\n') + '\n' +
    '╰──────────────────╯\n' +
    '> Responde com a *letra* (A-F) ou *numero* (1-6)\n' +
    '> Quem acertar *primeiro* ganha 1 ponto';

  await ctx.reply(header);

  try {
    const pollSent = await ctx.sock.sendMessage(ctx.jid, {
      poll: {
        name: item.q.length > 100 ? item.q.slice(0, 97) + '...' : item.q,
        values: item.opts.map(function (o, i) {
          return (L[i] + ') ' + o).slice(0, 100);
        }),
        selectableCount: 1
      }
    });
    if (pollSent && pollSent.key) {
      item._pollKey = pollSent.key;
      item._pollMsg = pollSent.message ? { message: pollSent.message } : pollSent;
    }
  } catch (e) {
    console.error('[trivia] poll', e.message);
  }

  active.set(ctx.jid, {
    q: item.q,
    opts: item.opts,
    correct: item.correct,
    answered: false,
    startedAt: Date.now(),
    pollKey: item._pollKey || null,
    pollMsg: item._pollMsg || null,
    pollValues: item.opts.slice()
  });
}

function parseAnswer(text) {
  if (!text) return -1;
  const t = String(text).trim().toUpperCase();
  if (/^[A-F]$/.test(t)) return t.charCodeAt(0) - 65;
  if (/^[1-6]$/.test(t)) return parseInt(t, 10) - 1;
  // "A)" ou "resposta B"
  const m = t.match(/\b([A-F])\b/);
  if (m) return m[1].charCodeAt(0) - 65;
  const n = t.match(/\b([1-6])\b/);
  if (n) return parseInt(n[1], 10) - 1;
  return -1;
}

async function tryAnswer(ctx, idx) {
  const g = active.get(ctx.jid);
  if (!g || g.answered) return false;
  if (idx < 0 || idx >= g.opts.length) {
    await ctx.reply('❌ Opcao invalida. Usa A-' + letters()[g.opts.length - 1] + ' ou 1-' + g.opts.length);
    return true;
  }

  const ok = g.correct.indexOf(idx) !== -1;
  if (!ok) {
    await ctx.reply('❌ Errado, ' + tag(ctx.sender) + '!\nTenta outra opcao.', {
      mentions: [ctx.sender]
    });
    return true;
  }

  g.answered = true;
  addPoint(ctx.jid, ctx.sender);
  const correctTexts = g.correct.map(function (i) {
    return letters()[i] + ') ' + g.opts[i];
  }).join(' · ');

  await ctx.reply(
    '╭──〔 ✅ 𝐂𝐄𝐑𝐓𝐎 〕──╮\n' +
      '◈┃ ' + tag(ctx.sender) + ' acertou primeiro!\n' +
      '◈┃ Resposta: *' + correctTexts + '*\n' +
      '◈┃ +1 ponto no ranking\n' +
      '╰──────────────────╯\n' +
      '> *trivia* — nova pergunta\n' +
      '> *rankingtrivia* — classificacao',
    { mentions: [ctx.sender] }
  );
  return true;
}

function makeLetterHandler(letter, idx) {
  return {
    name: letter.toLowerCase(),
    aliases: [],
    category: 'bn',
    description: 'Resposta trivia ' + letter,
    handler: async (ctx) => {
      if (!ctx.isGroup || !active.has(ctx.jid)) return;
      const g = active.get(ctx.jid);
      if (!g || g.answered) return;
      await tryAnswer(ctx, idx);
    }
  };
}

module.exports = [
  {
    name: 'trivia',
    aliases: ['quiz', 'perguntatrivia', 'triviaquiz'],
    category: 'bn',
    description: 'Pergunta de trivia (grupo)',
    groupOnly: true,
    handler: async (ctx) => sendTrivia(ctx)
  },
  {
    name: 'rankingtrivia',
    aliases: ['ranktrivia', 'triviarank', 'toptrivia'],
    category: 'bn',
    description: 'Ranking de trivia do grupo',
    groupOnly: true,
    handler: async (ctx) => {
      const rows = getRanking(ctx.jid, 10);
      if (!rows.length) {
        return ctx.reply('📊 Ainda nao ha pontos de trivia neste grupo.\nUsa *trivia* para comecar!');
      }
      let t = '╭──〔 🏆 𝐑𝐀𝐍𝐊𝐈𝐍𝐆 𝐓𝐑𝐈𝐕𝐈𝐀 〕──╮\n';
      const mentions = [];
      rows.forEach(function (r, i) {
        const medal = ['🥇', '🥈', '🥉'][i] || ((i + 1) + '.');
        t += '◈┃ ' + medal + ' ' + tag(r.user_jid) + ' — *' + r.points + '* pts\n';
        mentions.push(r.user_jid);
      });
      t += '╰──────────────────╯';
      await ctx.reply(t, { mentions: mentions });
    }
  },
  // letras A-F (so contam se trivia ativa)
  makeLetterHandler('A', 0),
  makeLetterHandler('B', 1),
  makeLetterHandler('C', 2),
  makeLetterHandler('D', 3),
  makeLetterHandler('E', 4),
  makeLetterHandler('F', 5),
  // numeros 1-6 — podem colidir com Connect4; so respondem se trivia ativa E nao for so connect4
  {
    name: 'trivia1',
    aliases: [],
    category: 'bn',
    description: 'Resposta 1 trivia',
    handler: async () => {}
  }
];

// Respostas numericas 1-6 via nomes que o parser pega: registramos handlers que escutam body
// Melhor: exportar tryAnswer e letras; numeros ja existem no connect4.
// Adicionamos no final handlers que o registry registra como '1'.. se connect4 nao consumir.

// Patch: re-export com numeros que so atuam em trivia
const numHandlers = [1, 2, 3, 4, 5, 6].map(function (n) {
  return {
    name: 'trivianum' + n,
    aliases: [],
    category: 'bn',
    description: 'num trivia',
    handler: async function () {}
  };
});

// Substituir module.exports para incluir answer por texto no comando generico
module.exports = module.exports.filter(function (c) {
  return c.name !== 'trivia1';
});

// Comando interno: se alguem mandar so o numero, o connect4.js pode ter '1'-'7'.
// No connect4, se nao ha jogo c4, return silencioso — trivia precisa do mesmo.
// Por isso registamos NO MESMO padrao mas com prioridade: no handler 1-6 do trivia file
// usamos nomes unicos e tambem um comando "responder"

module.exports.push({
  name: 'responder',
  aliases: ['resposta', 'answer'],
  category: 'bn',
  description: 'Responder trivia: responder A',
  groupOnly: true,
  handler: async (ctx) => {
    if (!active.has(ctx.jid)) {
      return ctx.reply('Nenhuma trivia aberta. Usa *trivia*.');
    }
    const idx = parseAnswer((ctx.args || []).join(' ') || ctx.text);
    if (idx < 0) return ctx.reply('Usa: *responder A* (ou B, C...)');
    await tryAnswer(ctx, idx);
  }
});


// API externa (numeros via connect4 hook)
module.exports.tryAnswerExternal = async function (ctx, idx) {
  if (!ctx.isGroup || !active.has(ctx.jid)) return false;
  const g = active.get(ctx.jid);
  if (!g || g.answered) return false;
  return tryAnswer(ctx, idx);
};


/** API para index.js — voto na enquete */
module.exports.active = active;
module.exports.handlePollVote = async function (sock, groupJid, voterJid, selectedIndexes) {
  const g = active.get(groupJid);
  if (!g || g.answered) return false;
  if (!selectedIndexes || !selectedIndexes.length) return false;
  const idx = selectedIndexes[0];
  // simular ctx minimo
  const ctx = {
    jid: groupJid,
    sender: voterJid,
    isGroup: true,
    reply: async (text, opts) => sock.sendMessage(groupJid, { text: text, ...(opts || {}) }),
    sock: sock
  };
  return tryAnswer(ctx, idx);
};
module.exports.tryAnswerExternal = async function (ctx, idx) {
  if (!ctx.isGroup || !active.has(ctx.jid)) return false;
  const g = active.get(ctx.jid);
  if (!g || g.answered) return false;
  return tryAnswer(ctx, idx);
};
