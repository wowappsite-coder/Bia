const MSGS_DONO = [
  '👑 Só o Dono abre este menu. Tu não és o chefão. 😂',
  '🚫 Menu Dono: entrada VIP. Teu nome não está na lista.',
  '🤨 ADM também não passa daqui. Só o Owner. KKKK.',
  '🛡️ Área do trono. Sem coroa, sem entrada. 😂',
  '😂 Tentou menudono sem ser dono... corajoso e negado.',
  '🔐 Exclusivo do proprietário do bot. Volta pro menu normal.',
  '🤣 O Dono olhou de longe e disse: "Não."',
