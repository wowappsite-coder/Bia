
/* BEATRIZ_WRAP_SENDMESSAGE */
function beatrizWrapSockSend(sock) {
  if (!sock || sock.__beatrizTypingWrapped) return sock;
  var original = sock.sendMessage.bind(sock);
  sock.sendMessage = async function (jid, content, options) {
    var isBotOut =
      content &&
      (content.text ||
        content.caption ||
        content.image ||
        content.video ||
        content.audio ||
        content.document ||
        content.sticker);
    if (isBotOut && jid) {
      try {
        if (typeof sock.sendPresenceUpdate === "function") {
          await sock.sendPresenceUpdate("composing", jid);
        }
      } catch (_e) {}
      var ms = 2500 + Math.floor(Math.random() * 2500);
      await new Promise(function (r) {
        setTimeout(r, ms);
      });
    }
    try {
      return await original(jid, content, options);
    } finally {
      try {
        if (isBotOut && jid && typeof sock.sendPresenceUpdate === "function") {
          await sock.sendPresenceUpdate("paused", jid);
        }
      } catch (_e2) {}
    }
  };
  sock.__beatrizTypingWrapped = true;
  return sock;
}

global.BOT_READY_AT = Date.now();
/**
 * BEATRIZ BOT - Entry Point
 */
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason, fetchLatestBaileysVersion, makeCacheableSignalKeyStore } = require('@whiskeysockets/baileys');
const pino = require('pino');
const qrcode = require('qrcode-terminal');
const path = require('path');
const fs = require('fs');

const config = require('./config');
const { initDatabase, getUser, updateUser, getGroup, isBlacklisted, log, setScope } = require('./database');
const { loadCommands } = require('./commands/loader');
const registry = require('./commands/registry');
const commandMedia = require('./services/commandMedia');
const commandLinks = require('./services/commandLinks');
const commandAudio = require('./services/commandAudio');
const { parseMessage } = require('./utils/parser');
const msgCache = require('./utils/msgCache');
const afkHook = require('./commands/grupo/afk');
const welcomeHook = require('./services/welcomeHook');
const Context = require('./utils/context');
const sendQueue = require('./utils/sendQueue');
const { registerMenuCommands } = require('./utils/menu');
const { analyzePayment, formatDetectionReply, setPendingMegas, handlePendingNumber } = require('./services/payment');
const { checkSecurity, checkSubscription } = require('./middlewares/security');
const welcomeBanner = require('./services/welcomeBanner');

// Logger
const logger = pino({ level: config.logLevel });
let commandsLoaded = false;

async function startBot() {
  // Garante pastas
  [config.sessionPath, config.logPath, path.dirname(config.dbPath)].forEach(d => {
    if (!fs.existsSync(d)) fs.mkdirSync(d, { recursive: true });
  });

  // Banco
  initDatabase();

  // Comandos (só uma vez — reconexão não duplica)
  if (!commandsLoaded) {
    loadCommands();
    registerMenuCommands();
    commandsLoaded = true;
  }

  const stats = registry.stats();
  console.log(`\n🤖 ${config.botName}`);
  console.log(`📦 Comandos principais: ${stats.totalMain}`);
  console.log(`🔗 Aliases: ${stats.totalAliases}`);
  console.log(`👑 Dono: ${config.ownerNumber}\n`);

  const { state, saveCreds } = await useMultiFileAuthState(config.sessionPath);
  const { version } = await fetchLatestBaileysVersion();

  const sock = makeWASocket({
    version,
    auth: {
      creds: state.creds,
      keys: makeCacheableSignalKeyStore(state.keys, logger)
    },
    printQRInTerminal: false,
    logger: pino({ level: 'silent' }),
    generateHighQualityLinkPreview: false,
    syncFullHistory: false,
    markOnlineOnConnect: true,
    getMessage: async () => undefined
  });
  beatrizWrapSockSend(sock);

  try { sendQueue.wrapSocket(sock); } catch (e) { console.error('[SEC QUEUE] wrap', e && e.message); }

  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', async (update) => {
    const { connection, lastDisconnect, qr } = update;
    if (qr) {
      console.log('\n📱 Escaneie o QR Code:\n');
      qrcode.generate(qr, { small: true });
    }
    if (connection === 'open') {
      console.log(`✅ ${config.botName} conectado!`);
      log('system', 'Bot conectado');
    }
    if (connection === 'close') {
      const code = lastDisconnect?.error?.output?.statusCode;
      const shouldReconnect = code !== DisconnectReason.loggedOut;
      console.log('Conexão fechada. Código:', code, 'Reconectar:', shouldReconnect);
      if (shouldReconnect) {
        setTimeout(() => startBot(), 3000);
      } else {
        console.log('Deslogado. Apague a pasta session e reinicie.');
      }
    }
  });

  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    for (const msg of messages) {
      try {
        if (!msg.message || msg.key.remoteJid === 'status@broadcast') continue;

        // === TRIVIA POLL VOTE ===
        try {
          if (msg.message && msg.message.pollUpdateMessage) {
            const jid = msg.key.remoteJid;
            if (jid && jid.endsWith('@g.us')) {
              let trivia;
              try { trivia = require('./commands/bn/trivia'); } catch (_) {}
              if (trivia && trivia.active) {
                const g = trivia.active.get(jid);
                if (g && !g.answered) {
                  const voter = msg.key.participant || msg.participant || msg.key.remoteJid;
                  // Tentar obter indices votados
                  let indexes = [];
                  const pu = msg.message.pollUpdateMessage;
                  // Algumas versoes trazem vote com selectedOptions (Buffer hashes)
                  // Sem decrypt: se so ha 4 opcoes e 1 voto, usamos texto A-D pelo fallback
                  if (pu.pollCreationMessageKey && g.pollKey) {
                    try {
                      const { getAggregateVotesInPollMessage } = require('@whiskeysockets/baileys');
                      // precisa da mensagem original do poll — guardada em g.pollMsg se existir
                      if (g.pollMsg && getAggregateVotesInPollMessage) {
                        const agg = getAggregateVotesInPollMessage({
                          message: g.pollMsg,
                          pollUpdates: [pu]
                        });
                        // agg = [{ name, voters }]
                        if (Array.isArray(agg)) {
                          for (let i = 0; i < agg.length; i++) {
                            const voters = agg[i].voters || [];
                            if (voters.some(function (v) {
                              return String(v).includes(String(voter).split('@')[0]) || v === voter;
                            })) {
                              indexes.push(i);
                            }
                          }
                        }
                      }
                    } catch (e) {
                      console.error('[trivia agg]', e.message);
                    }
                  }
                  if (indexes.length && typeof trivia.handlePollVote === 'function') {
                    await trivia.handlePollVote(sock, jid, voter, indexes);
                    continue;
                  }
                }
              }
            }
          }
        } catch (e) {
          console.error('[trivia poll]', e.message);
        }

        const body = msg.message?.conversation
          || msg.message?.extendedTextMessage?.text
          || msg.message?.imageMessage?.caption
          || '';
        console.log('[MSG]', type || '-', (msg.key?.remoteJid || '').slice(0, 25), body.slice(0, 30));
        await handleMessage(sock, msg);
      } catch (e) {
        console.error('[MSG ERROR]', e);
      }
    }
  });

  // Welcome / Goodbye
  sock.ev.on('group-participants.update', async (update) => {
    try {
      const g0 = getGroup(update.id);
      await welcomeHook.handleAdd(sock, update, g0);
    } catch (e) { console.error('[welcomeHook]', e.message); }

    try {
      const g = getGroup(update.id);
      if (update.action === 'add' && Number(g.welcome) === 1 && false /* welcomeHook */) {
        for (const p of update.participants) {
          const tag = '@' + String(p).split('@')[0].split(':')[0];
          const caption = [
            'Seja bem-vindo(a) ' + tag + ' ao grupo!',
            'E um prazer ter voce aqui. Esperamos que aproveite e participe bastante!'
          ].join('\n');
          let sent = false;
          try {
            if (welcomeBanner && typeof welcomeBanner.buildWelcomeMedia === 'function') {
              const media = await welcomeBanner.buildWelcomeMedia(sock, update.id, p);
              if (media && media.buffer) {
                await sock.sendMessage(update.id, {
                  image: media.buffer,
                  caption: '👋 ' + caption + ' 💚',
                  mentions: [p]
                });
                sent = true;
              }
            }
          } catch (e) {
            console.error('[welcomeBanner]', e && e.message ? e.message : e);
          }
          if (!sent) {
            try {
              let text = 'Bem-vindo(a) ' + tag + ' ao grupo!';
              try {
                const custom = require('./database').getSetting('welcome_msg');
                if (custom) {
                  text = String(custom).replace(/@user/g, tag).replace(/\{group\}/g, (g.name || 'grupo'));
                }
              } catch (_) {}
              await sock.sendMessage(update.id, { text, mentions: [p] });
            } catch (e2) {
              console.error('[welcome text]', e2 && e2.message ? e2.message : e2);
            }
          }
        }
      }
      if (update.action === 'remove' && Number(g.goodbye) === 1) {
        for (const p of update.participants) {
          await sock.sendMessage(update.id, {
            text: `👋 @${p.split('@')[0]} saiu do grupo.`,
            mentions: [p]
          });
        }
      }
    } catch (e) {
      console.error('Group update error', e.message);
    }
  });

  // Anti-delete: avisa quando mensagem é apagada (se ativado no grupo)
  sock.ev.on('messages.delete', async (item) => {
    try {
      const keys = item.keys || (item.key ? [item.key] : []);
      for (const key of keys) {
        if (!key?.remoteJid || !key.remoteJid.endsWith('@g.us')) continue;
        const g = getGroup(key.remoteJid);
        if (!g || !g.antidelete) continue;
        const who = key.participant || key.remoteJid;
        await sock.sendMessage(key.remoteJid, {
          text: `🗑️ Mensagem apagada detectada (anti-delete)\nPor: @${String(who).split('@')[0]}`,
          mentions: [who]
        }).catch(() => {});
      }
    } catch (e) {
      console.error('antidelete error', e.message);
    }
  });

  return sock;
}


  // --- MUTE: apaga mensagem de quem esta mutado ---
  function muteIdKey(j) {
    return String(j || '')
      .split('@')[0]
      .split(':')[0]
      .replace(/\D/g, '');
  }
  function isUserMuted(mutados, senderJid, msgKey) {
    const list = Array.isArray(mutados) ? mutados : [];
    if (!list.length) return false;
    const candidates = [
      senderJid,
      msgKey && msgKey.participant,
      msgKey && msgKey.participantPn,
      msgKey && msgKey.remoteJidAlt
    ].filter(Boolean);
    const keys = candidates.map(muteIdKey).filter(Boolean);
    for (let i = 0; i < list.length; i++) {
      const mk = muteIdKey(list[i]);
      if (!mk) continue;
      if (list[i] === senderJid) return true;
      for (let k = 0; k < keys.length; k++) {
        if (keys[k] && (keys[k] === mk || keys[k].endsWith(mk) || mk.endsWith(keys[k]))) return true;
      }
    }
    return false;
  }


function pickBlockedCmdMsg() {
  const MSGS = [
    '🚫 *COMANDO BLOQUEADO!*\nTu achou que isso aqui era terra sem lei? 💀',
    '⛔ *ACESSO NEGADO!*\nEsse comando foi de base. 🪦😂',
    '🚫 *IHUUU…*\nTentou usar comando bloqueado. O sistema já viu tua ousadia. 👁️💀',
    '💀 *ESSE COMANDO ESTÁ MAIS BLOQUEADO*\nQue tua sorte hoje. 😂',
    '🔒 *COMANDO BLOQUEADO!*\nVai tentar outro antes que eu bloqueie até teu bom senso. 🤡',
    '🚨 *CALMA, HACKER!*\nEsse comando foi bloqueado pelo dono. 🤣',
    '👑 *ACESSO RESTRITO!*\nEsse comando é disponível somente para o dono do bot. 🔐',
    '💀 *NEGADO!*\nSó o dono 👑 pode usar esse comando. Tu não tem esse passe. 😂',
    '🚫 *OPA!*\nEsse comando não está disponível no momento. Tenta outro. 😭',
    '🔒 *ESSE COMANDO FOI PRESO!*\nE não tem previsão de liberdade. 🗿😂',
    '🤨 *TU TENTOU MESMO?*\nEsse comando está bloqueado. 💀',
    '🚨 *SISTEMA DETECTOU OUSADIA!*\nComando bloqueado com sucesso. 😂🔥'
  ];
  return MSGS[Math.floor(Math.random() * MSGS.length)];
}

function isCommandBlocked(ctx, cmdName) {
  if (!cmdName) return false;
  try {
    if (ctx.isOwner && ctx.isOwner()) return false;
  } catch (_) {}
  const name = String(cmdName).toLowerCase();
  // global
  try {
    const { getSetting } = require('./database');
    let glob = [];
    try { glob = JSON.parse(getSetting('blocked_cmds_global', '[]') || '[]'); } catch (_) {}
    if (Array.isArray(glob) && (glob.includes(name) || glob.includes(cmdName))) return true;
  } catch (_) {}
  // grupo
  if (ctx.isGroup) {
    try {
      const g = ctx.group;
      let blocked = [];
      try { blocked = JSON.parse((g && g.blocked_cmds) || '[]'); } catch (_) {}
      if (Array.isArray(blocked) && (blocked.includes(name) || blocked.includes(cmdName))) return true;
    } catch (_) {}
  }
  return false;
}

async function handleMessage(sock, msg) {
  if (!msg.message) return;
  try { msgCache.saveMessage(msg); } catch (_) {}
  // ignora eco do próprio bot (mas loga se for debug)
  if (msg.key.fromMe) return;
  if (msg.key.remoteJid === 'status@broadcast') return;

  const sender = msg.key.participantPn || msg.key.participant || msg.key.remoteJidAlt || msg.key.remoteJid;
  const jid = msg.key.remoteJid;
  // Isola economia/XP/RPG por grupo
  try { setScope(jid && jid.endsWith('@g.us') ? jid : 'global'); } catch (_) {}

  // Blacklist
  if (isBlacklisted(sender)) return;

  // Mute: apaga qualquer mensagem (texto, figurinha, midia...) de usuario mutado
  if (jid.endsWith('@g.us')) {
    try {
      const gMute = getGroup(jid);
      let mutados = [];
      try { mutados = JSON.parse((gMute && gMute.mutados) || '[]'); } catch (_) {}
      if (isUserMuted(mutados, sender, msg.key)) {
        try {
          await sock.sendMessage(jid, { delete: msg.key });
        } catch (e) {
          console.error('[mute] delete', e.message);
        }
        return;
      }
    } catch (e) {
      console.error('[mute]', e.message);
    }
  }


  if (jid.endsWith('@g.us')) {
    try {
      if (afkHook && typeof afkHook.onMessage === 'function') {
        await afkHook.onMessage(sock, msg, sender, jid);
      }
    } catch (_) {}
  }

  // Segurança em tempo real (anti-link, anti-img, etc.)
  if (jid.endsWith('@g.us')) {
    const blocked = await checkSecurity(sock, msg);
    if (blocked) return;

    // Assinatura / aluguel vencido
    if (!config.isOwner(sender)) {
      const sub = checkSubscription(jid);
      if (!sub.ok) {
        // Permite apenas menu/ping básicos quando bloqueado? Bloqueia comandos.
        const parsedEarly = parseMessage(msg);
        if (parsedEarly && parsedEarly.command) {
          const free = [
            'menu', 'ping', 'aluguel', 'assinatura', 'planosaluguel',
            'owner', 'info', 'dono', 'menualuguel', 'menu aluguel',
            'ativarbot', 'ativar', 'renovarbot', 'renovar',
            'desativarbot', 'cancelaraluguel', 'statusaluguel',
            'planos', 'addplano', 'setplano'
          ];
          if (!free.includes(parsedEarly.command)) {
            const ownerNum = config.ownerDisplay || config.ownerNumber;
            await sock.sendMessage(jid, {
              text:
                '⚠️ *ALUGUEL INATIVO / EXPIRADO* ⚠️\n\n' +
                'Este grupo não tem plano ativo.\n' +
                'Digite *aluguel* para ver os planos.\n\n' +
                '📩 Contratação: fale com o Owner\n' +
                '📞 ' + ownerNum + '\n\n' +
                '📢 *Canal oficial:*\n' +
                'https://whatsapp.com/channel/0029Vb6PhNkATRSjN3udCi26\n\n' +
                '👥 *Grupo oficial:*\n' +
                'https://chat.whatsapp.com/IBGTzlxazMP6DQOckdfZR0'
            }, { quoted: msg }).catch(() => {});
            return;
          }
        }
      }
    }
  }

  // Atualiza user stats (+ contagem por tipo de midia)
  try {
    const user = getUser(sender);
    const m = msg.message || {};
    const patch = {
      messages: (user.messages || 0) + 1,
      xp: (user.xp || 0) + config.xpPerMessage,
      level: Math.floor(((user.xp || 0) + config.xpPerMessage) / 100) + 1,
      pushname: msg.pushName || user.pushname
    };
    if (m.stickerMessage) patch.msg_stickers = (user.msg_stickers || 0) + 1;
    if (m.imageMessage) patch.msg_images = (user.msg_images || 0) + 1;
    if (m.audioMessage || m.pttMessage) patch.msg_audios = (user.msg_audios || 0) + 1;
    if (m.videoMessage) patch.msg_videos = (user.msg_videos || 0) + 1;
    updateUser(sender, patch);
  } catch {}

  // Parse
  
  try {
    if (global.BOT_READY_AT && msg.messageTimestamp) {
      const ts = Number(msg.messageTimestamp) * (String(msg.messageTimestamp).length <= 10 ? 1000 : 1);
      if (ts && ts < global.BOT_READY_AT - 2000) return;
    }
  } catch (_) {}
  const parsed = parseMessage(msg);

  // --- numero megas apos pagamento (84/85 9 digitos) ---
  try {
    const bodyTxt = (parsed && (parsed.text || parsed.body)) || '';
    if (jid.endsWith('@g.us') && bodyTxt) {
      console.log('[PENDING] try number', bodyTxt, 'from', sender);
      const doneNum = await handlePendingNumber(sock, msg, sender, jid, bodyTxt);
      if (doneNum) return;
    }
  } catch (e) { console.error('[PENDING handle]', e); }

  if (!parsed) {
    try {
      const { extractText } = require('./utils/parser');
      const t = extractText(msg) || '';
      if (jid.endsWith('@g.us') && t) {
        const done2 = await handlePendingNumber(sock, msg, sender, jid, t);
        if (done2) return;
      }
    } catch (_) {}
    return;
  }

  // === PREFIX_ONLY_FILTER ===
  try {
    if (parsed && parsed.command && !parsed.hasPrefix && !parsed.isPayment) {
      const j = msg.key.remoteJid;
      if (j && String(j).endsWith('@g.us')) {
        let only = false;
        try {
          const { getGroupSetting } = require('./database');
          const v = getGroupSetting(j, 'prefix_only', '0');
          only = String(v) === '1' || v === 1;
        } catch (_) {}
        if (only) {
          console.log('[PREFIX_ONLY] bloqueado sem prefixo:', parsed.command);
          return;
        }
      }
    }
  } catch (e) {
    console.error('[PREFIX_ONLY]', e && e.message);
  }

// Pagamento sem prefixo
  if (parsed.isPayment && parsed.paymentData) {
    const analysis = analyzePayment(parsed.paymentData, sender, jid.endsWith("@g.us") ? jid : null);
    const reply = formatDetectionReply(parsed.paymentData, analysis);
    await sock.sendMessage(msg.key.remoteJid, { text: reply }, { quoted: msg });
    log('payment', analysis.status, sender, parsed.paymentData);
    try {
      if (analysis.status === 'PAGAMENTO_VALIDO') {
        const pd = parsed.paymentData || {};
        setPendingMegas(msg.key.remoteJid, sender, {
          value: pd.value,
          transactionId: pd.transactionId,
          provider: pd.provider,
          providerName: ({ mpesa: 'M-Pesa', emola: 'E-Mola', mkash: 'M-Kash' })[pd.provider] || pd.provider
        });
      }
    } catch (e) { console.error('[pending megas]', e.message); }
    return;
  }

  try {
    if (jid.endsWith('@g.us') && parsed && !parsed.command && (parsed.text || parsed.body)) {
      const txt = parsed.text || parsed.body || '';
      const done = await handlePendingNumber(sock, msg, sender, jid, txt);
      if (done) return;
    }
  } catch (e) { console.error('[handlePendingNumber]', e.message); }

  if (!parsed.command) return;

  const cmd = registry.get(parsed.command);
  if (!cmd) return;

  // Contexto
  const ctx = new Context(sock, msg, parsed);

  // Checks de permissão
  if (cmd.ownerOnly && !ctx.isOwner()) {
    return ctx.reply('❌ Apenas o dono.');
  }
  if (cmd.botAdminOnly && !ctx.isBotAdmin()) {
    return ctx.reply('❌ Apenas administradores do bot.');
  }
  if (cmd.groupOnly && !ctx.isGroup) {
    return ctx.reply('❌ Apenas em grupos.');
  }
  if (cmd.privateOnly && ctx.isGroup) {
    return ctx.reply('❌ Apenas no privado.');
  }
  if (cmd.adminOnly && ctx.isGroup) {
    const isAdm = await ctx.isGroupAdmin() || ctx.isOwner() || ctx.isBotAdmin();
    if (!isAdm) return ctx.reply('❌ Apenas administradores do grupo.');
  }

  // Comandos bloqueados (grupo + global)
  try {
    if (isCommandBlocked(ctx, cmd.name) || isCommandBlocked(ctx, parsed && parsed.command)) {
      return ctx.reply(pickBlockedCmdMsg());
    }
  } catch (_) {}

  // Mute / grupo extras
  if (ctx.isGroup) {
    try {
      const g = ctx.group;
      // Mute
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      if (mutados.includes(sender)) return;
    } catch {}
  }


  // Modo Internet: so categoria internet (+ excecoes) neste grupo
  try {
    if (ctx.isGroup && !(ctx.isOwner && ctx.isOwner())) {
      const { getGroupSetting } = require('./database');
      const modo = String(getGroupSetting(ctx.jid, 'modo_internet', '0') || '0');
      if (modo === '1') {
        const cat = String((cmd && cmd.category) || '').toLowerCase();
        const nome = String((cmd && cmd.name) || '').toLowerCase();
        const freeNames = [
          'ping', 'menu', 'menuinternet', 'menualuguel', 'aluguel', 'assinatura',
          'planosaluguel', 'owner', 'dono', 'info', 'tabela', 'vertabela', 'net',
          'megas', 'catalogo', 't', 'planos', 'produtos', 'pedido', 'compra',
          'addproduto', 'addtabela', 'deltabela', 'delproduto', 'tabelapadrao',
          'limpartabela', 'configpagamento', 'pagamento', 'modointernet'
        ];
        const okCat = cat === 'internet' || cat === 'aluguel';
        const okName = freeNames.indexOf(nome) >= 0;
        if (!okCat && !okName) {
          return; // modo internet: silencioso
        }
      }
    }
  } catch (e) {
    console.error('[modointernet]', e.message);
  }

  // Anti-spam simples
  // (pode expandir)

  // XP comando
  try {
    const u = ctx.user;
    updateUser(sender, {
      commands_used: (u.commands_used || 0) + 1,
      xp: (u.xp || 0) + config.xpPerCommand
    });
  } catch {}


  // AUTO_REACT_FILTER — so comandos essenciais
  try {
    var essential = {
      menu:1, menudono:1, menuadm:1, menugrupo:1, menuinternet:1, menubn:1,
      menudiversao:1, menustickers:1, menuimagem:1, menuseguranca:1, menuutilidades:1,
      menurpg:1, menuxp:1, menueconomia:1, menualuguel:1, menudownload:1, menumodos:1,
      ping:1, info:1, dono:1, owner:1, aluguel:1, planosaluguel:1, ajuda:1, help:1
    };
    var cname = String((cmd && cmd.name) || (parsed && parsed.command) || '').toLowerCase();
    if (essential[cname] || (cname.indexOf('menu') === 0)) {
      var AUTO_REACT_EMOJIS = require('./utils/autoReactEmojis');
      var emoji = AUTO_REACT_EMOJIS[Math.floor(Math.random() * AUTO_REACT_EMOJIS.length)];
      ctx.react(emoji).catch(function () {});
    }
  } catch (_) {}


  // Executa
  try {
    let mediaWrap = null;
  try { mediaWrap = commandMedia.wrapContext(ctx, cmd.name, (parsed && parsed.args) || [], [cmd.name].concat(cmd.aliases || []).concat([(parsed && parsed.command) || ''])); } catch (_) {}
  await cmd.handler(ctx);
    try { await commandLinks.sendLink(ctx, cmd.name, cmd.aliases || []); } catch (e3) { console.error('[commandLinks]', e3.message); }
    try { /* SEC_CMD_LOG */ const st = sendQueue.stats(); if (st.burstEvents && st.chainLen > 1) console.log('[SEC] cmd', parsed.command, st); } catch (_) {}
    try {
      const aInfo = commandAudio.resolve(cmd.name, (parsed && parsed.args) || [], [cmd.name].concat(cmd.aliases || []).concat([(parsed && parsed.command) || '']));
      if (aInfo) await commandAudio.sendAudio(ctx, aInfo);
    } catch (e3) { console.error('[commandAudio]', e3.message); }
    try {
      if (mediaWrap && mediaWrap.info && !mediaWrap.used) {
        await commandMedia.sendOnly(ctx, mediaWrap.info);
      }
    } catch (e2) { console.error('[commandMedia]', e2.message); }
  } catch (e) {
    console.error(`[CMD ERROR] ${cmd.name}:`, e);
    log('cmd_error', `${cmd.name}: ${e.message}`, sender);
    await ctx.reply('❌ Ocorreu um erro ao executar o comando.').catch(() => {});
  }
}

// Start
startBot().catch(e => {
  console.error('Falha ao iniciar:', e);
  process.exit(1);
});
