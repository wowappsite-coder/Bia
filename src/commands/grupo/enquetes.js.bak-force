function shuffle(a){const arr=a.slice();for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));const t=arr[i];arr[i]=arr[j];arr[j]=t;}return arr;}
function pick(list,map,g){let bag=map.get(g);if(!bag||!bag.length){bag=shuffle(list);map.set(g,bag);}return bag.pop();}
async function sendPoll(ctx,name,values){try{await ctx.sock.sendMessage(ctx.jid,{poll:{name,values,selectableCount:1}});}catch(e){await ctx.reply('Nao criou enquete.\n'+name+'\n- '+values.join('\n- '));}}
module.exports=[
{name:'confissao',aliases:['confess'],category:'grupo',groupOnly:true,handler:async(ctx)=>{const item=pick(CONF,bags.confissao,ctx.jid);await ctx.reply('🪞 *CONFISSAO*\n\n'+item.q);await sendPoll(ctx,item.q,item.opts);}},
{name:'perguntou',aliases:['pollrapida'],category:'grupo',groupOnly:true,handler:async(ctx)=>{const item=pick(PERGUNTOU,bags.perguntou,ctx.jid);await ctx.reply('❓ *PERGUNTOU*\n\n'+item.q);await sendPoll(ctx,item.q,item.opts);}},
{name:'pergunta',aliases:['enquete','poll'],category:'grupo',groupOnly:true,handler:async(ctx)=>{const item=pick(PERGUNTA,bags.pergunta,ctx.jid);await ctx.reply('🧠 *PERGUNTA*\n\n'+item.q);await sendPoll(ctx,item.q,item.opts);}}
];
