      await ctx.reply(`📅 *Data*\n${now.toLocaleDateString('pt-MZ', { timeZone: config.timezone, weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}`);
    }
  },
  {
    name: 'calcular',
    aliases: ['calc', 'calculadora'],
    category: 'utilidades',
    description: 'Calcula expressão matemática',
    usage: '!calcular 2+2*3',
    handler: async (ctx) => {
      const expr = ctx.text.replace(/[^0-9+\-*/().%\s]/g, '');
      if (!expr) return ctx.reply('❌ Use: !calcular 2+2');
      try {
        // Avaliação segura básica
        const result = Function(`"use strict"; return (${expr})`)();
        if (typeof result !== 'number' || !isFinite(result)) throw new Error('Inválido');
        await ctx.reply(`🧮 *Resultado*\n\`${expr}\` = *${result}*`);
      } catch {
        await ctx.reply('❌ Expressão inválida.');
      }
    }
  },
  {
    name: 'porcentagem',
    aliases: ['porcento', 'percent'],
    category: 'utilidades',
    description: 'Calcula porcentagem',
    usage: '!porcentagem 20 150',
    handler: async (ctx) => {
      const [a, b] = ctx.args.map(Number);
      if (isNaN(a) || isNaN(b)) return ctx.reply('❌ Use: !porcentagem 20 150 (20% de 150)');
      const res = (a / 100) * b;
      await ctx.reply(`📊 ${a}% de ${b} = *${res.toFixed(2)}*`);
    }
  },
  {
    name: 'regra3',
    aliases: ['regra_de_tres', 'rtres'],
    category: 'utilidades',
    description: 'Regra de três simples',
    usage: '!regra3 2 4 6',
    handler: async (ctx) => {
      const [a, b, c] = ctx.args.map(Number);
      if ([a, b, c].some(isNaN)) return ctx.reply('❌ Use: !regra3 A B C  (A está para B assim como C está para X)');
      const x = (b * c) / a;
      await ctx.reply(`📐 *Regra de 3*\n${a} → ${b}\n${c} → *${x.toFixed(2)}*`);
    }
  },
  {
    name: 'temperatura',
    aliases: ['temp', 'convertertemp'],
    category: 'utilidades',
    description: 'Converte temperatura C/F/K',
    usage: '!temperatura 30C',
    handler: async (ctx) => {
      const input = (ctx.args[0] || '').toUpperCase();
      const match = input.match(/^([\d.]+)([CFK])$/);
      if (!match) return ctx.reply('❌ Use: !temperatura 30C ou 86F ou 300K');
      const val = parseFloat(match[1]);
      const unit = match[2];
      let c, f, k;
      if (unit === 'C') { c = val; f = c * 9/5 + 32; k = c + 273.15; }
      else if (unit === 'F') { f = val; c = (f - 32) * 5/9; k = c + 273.15; }
      else { k = val; c = k - 273.15; f = c * 9/5 + 32; }
      await ctx.reply(`🌡 *Temperatura*\nCelsius: ${c.toFixed(2)}°C\nFahrenheit: ${f.toFixed(2)}°F\nKelvin: ${k.toFixed(2)}K`);
    }
  },
  {
    name: 'idade',
    aliases: ['age'],
    category: 'utilidades',
    description: 'Calcula idade a partir da data de nascimento',
    usage: '!idade 15/08/2000',
    handler: async (ctx) => {
      const input = ctx.args[0];
      if (!input) return ctx.reply('❌ Use: !idade DD/MM/AAAA');
      const parts = input.split(/[\/\-]/);
      if (parts.length !== 3) return ctx.reply('❌ Formato: DD/MM/AAAA');
      const [d, m, y] = parts.map(Number);
      const birth = new Date(y, m - 1, d);
      if (isNaN(birth.getTime())) return ctx.reply('❌ Data inválida.');
      const now = new Date();
      let age = now.getFullYear() - birth.getFullYear();
      const md = now.getMonth() - birth.getMonth();
      if (md < 0 || (md === 0 && now.getDate() < birth.getDate())) age--;
      await ctx.reply(`🎂 Idade: *${age} anos*`);
    }
  },
  {
    name: 'uuid',
    aliases: ['guid'],
    category: 'utilidades',
    description: 'Gera um UUID',
    handler: async (ctx) => {
      await ctx.reply(`🔑 \`${uuidv4()}\``);
    }
  },
  {
    name: 'senha',
    aliases: ['password', 'gerarsenha'],
    category: 'utilidades',
    description: 'Gera senha aleatória',
    usage: '!senha 16',
    handler: async (ctx) => {
      const len = Math.min(Math.max(parseInt(ctx.args[0]) || 12, 6), 64);
      const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*';
      let pass = '';
      for (let i = 0; i < len; i++) pass += chars[Math.floor(Math.random() * chars.length)];
      await ctx.reply(`🔐 *Senha gerada (${len}):*\n\`${pass}\``);
    }
  },
  {
    name: 'base64',
    aliases: ['b64'],
    category: 'utilidades',
    description: 'Codifica texto em Base64',
    usage: '!base64 texto',
    handler: async (ctx) => {
      if (!ctx.text) return ctx.reply('❌ Use: !base64 seu texto');
      const encoded = Buffer.from(ctx.text).toString('base64');
      await ctx.reply(`📦 *Base64:*\n\`${encoded}\``);
    }
  },
  {
    name: 'decode',
    aliases: ['decodificar', 'b64decode'],
    category: 'utilidades',
    description: 'Decodifica Base64',
    usage: '!decode textobase64',
    handler: async (ctx) => {
      if (!ctx.text) return ctx.reply('❌ Use: !decode textobase64');
      try {
        const decoded = Buffer.from(ctx.text, 'base64').toString('utf8');
        await ctx.reply(`📦 *Decodificado:*\n${decoded}`);
      } catch {
        await ctx.reply('❌ Base64 inválido.');
      }
    }
  },
  {
    name: 'contador',
    aliases: ['count', 'contar'],
    category: 'utilidades',
    description: 'Conta caracteres/palavras',
    usage: '!contador texto',
    handler: async (ctx) => {
      const t = ctx.text || '';
      if (!t) return ctx.reply('❌ Envie um texto.');
      const chars = t.length;
      const words = t.trim().split(/\s+/).filter(Boolean).length;
      const lines = t.split('\n').length;
      await ctx.reply(`📊 *Contagem*\nCaracteres: ${chars}\nPalavras: ${words}\nLinhas: ${lines}`);
    }
  },
  {
    name: 'status',
    aliases: ['botstatus'],
    category: 'utilidades',
    description: 'Status do sistema',
    handler: async (ctx) => {
      const freeMem = (os.freemem() / 1024 / 1024).toFixed(0);
      const totalMem = (os.totalmem() / 1024 / 1024).toFixed(0);
      const load = os.loadavg()[0].toFixed(2);
      await ctx.reply(`🖥 *Status do Sistema*\nMemória livre: ${freeMem}MB / ${totalMem}MB\nLoad: ${load}\nPlataforma: ${os.platform()}\nArch: ${os.arch()}`);
    }
  }
];
