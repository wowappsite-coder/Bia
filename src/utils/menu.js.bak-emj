  dono: { emoji: '👑', title: 'MENU DONO' },
  admin: { emoji: '🛡️', title: 'MENU ADM' },
  grupo: { emoji: '👥', title: 'MENU GRUPO' },
  internet: { emoji: '🌐', title: 'MENU INTERNET' },
  bn: { emoji: '🎮', title: 'MENU BN' },
  diversao: { emoji: '🎭', title: 'MENU DIVERSÃO' },
  stickers: { emoji: '🎴', title: 'MENU STICKERS' },
  imagem: { emoji: '🖼️', title: 'MENU IMAGEM' },
  seguranca: { emoji: '🛡️', title: 'MENU SEGURANÇA' },
  utilidades: { emoji: '🧰', title: 'MENU UTILIDADES' },
  rpg: { emoji: '❤️', title: 'MENU RPG/FAMÍLIA' },
  xp: { emoji: '⭐', title: 'MENU XP/RANK' },
  economia: { emoji: '💰', title: 'MENU ECONOMIA' },
  aluguel: { emoji: '🏠', title: 'MENU ALUGUEL' },
  jogos: { emoji: '🎮', title: 'MENU JOGOS' },
  custom: { emoji: '✨', title: 'CUSTOM' },
  outros: { emoji: '📦', title: 'OUTROS' }
};

function generateMainMenu(ctx) {
  if (ctx && theme.useNewTheme(ctx)) {
    const _jid = (ctx && ctx.sender) ? ctx.sender : '';
    const _token = String(_jid).split('@')[0] || 'user';
    const _now = new Date();
    const _hora = String(_now.getHours()).padStart(2, '0') + ':' + String(_now.getMinutes()).padStart(2, '0');
    return theme.mainMenuTheme(registry.stats(), config.botName, '!', {
      mentionToken: _token,
      ownerName: 'Ebai',
      hora: _hora
    });
  }

  const stats = registry.stats();
  const total = (stats && stats.totalMain) != null ? stats.totalMain : '?';
  const pref = (config.prefixes && config.prefixes[0]) ? config.prefixes[0] : '!';

  const lines = [
    '╭──〔 𝐈𝐍𝐅𝐎 〕──╮',
    '> 𝐏𝐫𝐞𝐟𝐢𝐱𝐨: ' + pref,
    '> 𝐄𝐱: ' + pref + '𝐦𝐞𝐧𝐮',
    '> 𝐀𝐥𝐠𝐮𝐧𝐬 𝐜𝐨𝐦𝐚𝐧𝐝𝐨𝐬 𝐩𝐨𝐝𝐞𝐦 𝐟𝐮𝐧𝐜𝐢𝐨𝐧𝐚𝐫 𝐬𝐞𝐦 𝐩𝐫𝐞𝐟𝐢𝐱𝐨',
    '> 𝐄𝐱: 𝐦𝐞𝐧𝐮',
    '❀────────────────❀',
    '╭──〔 🌸 𝐌𝐄𝐍𝐔𝐒 〕──╮',
    '◈┃👑 𝗠𝗲𝗻𝘂 𝗗𝗼𝗻𝗼',
    '◈┃🛡️ 𝗠𝗲𝗻𝘂 𝗔𝗗𝗠',
    '◈┃👥 𝗠𝗲𝗻𝘂 𝗚𝗿𝘂𝗽𝗼',
    '◈┃🌐 𝗠𝗲𝗻𝘂 𝗜𝗻𝘁𝗲𝗿𝗻𝗲𝘁',
    '◈┃🎮 𝗠𝗲𝗻𝘂 𝗕𝗡',
    '◈┃🎭 𝗠𝗲𝗻𝘂 𝗗𝗶𝘃𝗲𝗿𝘀ã𝗼',
    '◈┃🎴 𝗠𝗲𝗻𝘂 𝗦𝘁𝗶𝗰𝗸𝗲𝗿𝘀',
    '◈┃🎨 𝗠𝗲𝗻𝘂 𝗜𝗺𝗮𝗴𝗲𝗺',
    '◈┃🔐 𝗦𝗲𝗴𝘂𝗿𝗮𝗻ç𝗮',
    '◈┃🧰 𝗨𝘁𝗶𝗹𝗶𝗱𝗮𝗱𝗲𝘀',
    '◈┃❤️ 𝗥𝗣𝗚/𝗙𝗮𝗺𝗶𝗹𝗶𝗮',
    '◈┃⭐ 𝗫𝗣/𝗥𝗔𝗡𝗞',
    '◈┃💰 𝗘𝗰𝗼𝗻𝗼𝗺𝗶𝗮',
    '◈┃🏠 𝗔𝗹𝘂𝗴𝘂𝗲𝗹',
    '◈┃📥 𝗠𝗲𝗻𝘂 𝗗𝗼𝘄𝗻𝗹𝗼𝗮𝗱',
    '◈┃📚 𝗠𝗲𝗻𝘂 𝗣𝗲𝘀𝗾𝘂𝗶𝘀𝗮',
    '◈┃⚙️ 𝗠𝗲𝗻𝘂 𝗠𝗼𝗱𝗼𝘀',
    '◈┃🎮 𝗠𝗲𝗻𝘂 𝗪𝗲𝗯𝗚𝗮𝗺𝗲𝘀',
    '╰──────────────────╯',
    '╭──〔 𝐒𝐈𝐒𝐓𝐄𝐌𝐀 〕──╮',
    '*🥏┃' + total + ' C͟O͟M͟A͟N͟D͟O͟S͟*',
    '*🥏┃P͟R͟E͟F͟I͟X͟O͟: ' + pref + '*',
    '❀────────────────❀',
    '',
    '      ──〔 𝐁𝐄𝐀𝐓𝐑𝐈𝐙 𝐁𝐎𝐓 〕──'
  ];
  return lines.join(String.fromCharCode(10));
}



/* BTZ_MENU_GROUPS_V1 — so visual, nao cria comandos */
function btzGroupCommands(category, cmds) {
  const list = (cmds || []).filter(function (c) {
    if (!c || c.hideFromMenu) return false;
    const n = String(c.name || '').toLowerCase();
    if (/^[0-9abc]$/i.test(n)) return false;
    if (/^h[1-8]$/.test(n) || n === 'hep') return false;
    return true;
  });

  const JOGO_KEYS = [
    'jogodavelha','ttt','connect4','c4','forca','hangman','trivia','quiz','eununca',
    'quemsueu','whoami','verdadeoudesafio','vod','ppt','jokenpo','moeda','coin','dado','dice',
    'jogar','j1','j2','j3','j4','j5','j6','j7','j8','j9','aceitarvelha','recusarvelha',
    'aceitarttt','recusarttt','aceitar4','recusar4','aceitac4','cancelar4','desistir','letra',
    'responder','resposta','perguntaseu','question','rankingtrivia','ranktrivia','ngl','enviar',
    'enviarppp','ppp','fc','resetefc','resetejdv','velha'
  ];
  const RANK_KEYS = [
    'rankgado','rankgay','ranklindo','ranklinda','rankfeio','rankgostoso','rankgostosa',
    'rankcorno','rankrico','rankpobre','rankotaku','rankbebado','rankpau','rankputa',
    'rankputo','ranksafado','ranksafada','rankempresario','rankempresaria','ranknazista'
  ];

  function matchKeys(c, keys) {
    const n = String(c.name || '').toLowerCase();
    const als = (c.aliases || []).map(function (a) { return String(a).toLowerCase(); });
    if (keys.indexOf(n) >= 0) return true;
    for (let i = 0; i < als.length; i++) if (keys.indexOf(als[i]) >= 0) return true;
    // prefixo rank*
    if (keys === RANK_KEYS && n.indexOf('rank') === 0) return true;
    return false;
  }

  const cat = String(category || '').toLowerCase();
  const groups = [];

  if (cat === 'bn' || cat === 'diversao' || cat === 'jogos') {
    const ranks = list.filter(function (c) { return matchKeys(c, RANK_KEYS); });
    const jogos = list.filter(function (c) { return matchKeys(c, JOGO_KEYS) && !matchKeys(c, RANK_KEYS); });
    const used = {};
    ranks.concat(jogos).forEach(function (c) { used[String(c.name).toLowerCase()] = 1; });
    const inter = list.filter(function (c) { return !used[String(c.name).toLowerCase()]; });
    if (inter.length) groups.push({ title: '🎯 INTERAÇÃO', items: inter });
    if (jogos.length) groups.push({ title: '🎮 JOGOS', items: jogos });
    if (ranks.length) groups.push({ title: '🎐 RANKS', items: ranks });
  } else if (cat === 'admin') {
    const modKeys = ['ban','kick','adv','advdel','advlist','advreset','mute','desmute','mutelist','hidetag','marcar','marcar2','promover','rebaixar','remover','add'];
    const gpKeys = ['abrirgrupo','fechargrupo','linkgp','revlinkgp','nomegp','descgp','setregras','bemvindo','saida','modoadm'];
    const mod = list.filter(function (c) { return matchKeys(c, modKeys); });
    const gp = list.filter(function (c) { return matchKeys(c, gpKeys); });
    const used = {};
    mod.concat(gp).forEach(function (c) { used[String(c.name).toLowerCase()] = 1; });
    const rest = list.filter(function (c) { return !used[String(c.name).toLowerCase()]; });
    if (mod.length) groups.push({ title: '🛡️ MODERAÇÃO', items: mod });
    if (gp.length) groups.push({ title: '👥 GRUPO', items: gp });
    if (rest.length) groups.push({ title: '📦 OUTROS', items: rest });
  } else if (cat === 'dono') {
    const sysKeys = ['reiniciar','restart','desligar','shutdown','backup','logs','stats','setprefix'];
    const cmdKeys = ['addcmd1','addcmd2','addcmd3','delcmd','editcmd','listcmd','addadmin','deladmin'];
    const midKeys = ['setmedia','delmedia','listmedia','setaudio','delaudio','listaudio','migratemedia'];
    const sys = list.filter(function (c) { return matchKeys(c, sysKeys); });
    const cmds = list.filter(function (c) { return matchKeys(c, cmdKeys); });
    const mid = list.filter(function (c) { return matchKeys(c, midKeys); });
    const used = {};
    sys.concat(cmds, mid).forEach(function (c) { used[String(c.name).toLowerCase()] = 1; });
    const rest = list.filter(function (c) { return !used[String(c.name).toLowerCase()]; });
    if (sys.length) groups.push({ title: '⚙️ SISTEMA', items: sys });
    if (cmds.length) groups.push({ title: '📝 COMANDOS', items: cmds });
    if (mid.length) groups.push({ title: '🖼️ MÍDIA', items: mid });
    if (rest.length) groups.push({ title: '📦 OUTROS', items: rest });
  } else {
    // menus sem sub-regras: uma seccao unica (mantem ordem A-Z)
    groups.push({ title: null, items: list.slice().sort(function (a, b) {
      return String(a.name).localeCompare(String(b.name));
    }) });
  }

  // ordenar items dentro de cada grupo
  groups.forEach(function (g) {
    g.items.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
  });
  return groups;
}

function shouldHideFromCategoryMenu(cmd) {
  if (!cmd) return true;
  if (cmd.hideFromMenu) return true;
  const n = String(cmd.name || '').toLowerCase();
  if (/^[0-9]$/.test(n)) return true;
  if (/^[abc]$/.test(n)) return true;
  if (/^h[1-8]$/.test(n)) return true;
  if (n === 'hep') return true;
  return false;
}


function generateCategoryMenu(category, ctx) {
  if (ctx && theme.useNewTheme(ctx)) {
    const meta = CATEGORY_META[category] || { emoji: '📦', title: String(category).toUpperCase() };
    const cmds = registry.getByCategory(category);
    return theme.categoryMenuTheme(meta, cmds, '!', category);
  }
  const meta = CATEGORY_META[category] || { emoji: '📦', title: String(category).toUpperCase() };
  const raw = registry.getByCategory(category);
  const prefix = (config.prefixes && config.prefixes[0]) || '!';
  const groups = btzGroupCommands(category, raw);
  const total = groups.reduce(function (n, g) { return n + g.items.length; }, 0);
  if (!total) return '❌ Nenhum comando na categoria *' + meta.title + '*';

  const title = (meta.emoji ? meta.emoji + ' ' : '') + meta.title;
  let text = '╭──〔 ' + title + ' 〕──╮\n';
  for (let g = 0; g < groups.length; g++) {
    const gr = groups[g];
    if (gr.title) {
      text += '│\n│ ' + gr.title + '\n';
    }
    for (let i = 0; i < gr.items.length; i++) {
      const cmd = gr.items[i];
      let line = prefix + cmd.name;
      if (cmd.aliases && cmd.aliases.length) line += ' (' + cmd.aliases.slice(0, 1).join(', ') + ')';
      text += '◈┃ ' + line + '\n';
    }
  }
  text += '╰──────────────────╯\n';
  text += 'Total: ' + total + ' comandos\n';
  text += '❀────────────────❀';
  return text;
}

// Comandos de submenu
function registerMenuCommands() {
  const cats = Object.keys(CATEGORY_META);
  for (const cat of cats) {
    if (cat === 'custom' || cat === 'outros') continue;
    registry.register({
      name: `menu${cat}`,
      aliases: [`menu ${cat}`, `menú${cat}`],
      category: 'utilidades',
      description: `Abre o menu ${cat}`,
      handler: async (ctx) => {
        await ctx.reply(generateCategoryMenu(cat, ctx));
      }
    });
  }

  // Atalhos comuns
  const shortcuts = {
    'menuadm': 'admin',
    'menuadmin': 'admin',
    'menubn': 'bn',
    'menudono': 'dono',
    'menugrupo': 'grupo',
    'menuinternet': 'internet',
    'menusticker': 'stickers',
    'menustickers': 'stickers',
    'menuimg': 'imagem',
    'menuimagem': 'imagem',
    'menuseguranca': 'seguranca',
    'menurpg': 'rpg',
    'menufamilia': 'rpg',
    'menuxp': 'xp',
    'menurank': 'xp',
    'menueconomia': 'economia',
    'menualuguel': 'aluguel',
    'menudiversao': 'diversao',
    'menuutilidades': 'utilidades',
    'menutil': 'utilidades',
    'menusticker': 'stickers',
    'menufig': 'stickers',
    'menufigurinhas': 'stickers'
  };

  for (const [name, cat] of Object.entries(shortcuts)) {
    if (!registry.get(name)) {
      registry.register({
        name,
        category: 'utilidades',
        description: `Atalho menu ${cat}`,
        handler: async (ctx) => {
          await ctx.reply(generateCategoryMenu(cat, ctx));
        }
      });
    }
  }
}

module.exports = {
  generateMainMenu,
  generateCategoryMenu,
  registerMenuCommands,
  CATEGORY_META
};
