  {
    name: 'marcar',
    aliases: ['tagall', 'todos'],
    category: 'admin',
    description: 'Marca todos com lista',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      try {
        const meta = await ctx.getGroupMetadata();
        let text = (ctx.text || '📢 Marcação geral') + '\n\n';
        const mentions = [];
        meta.participants.forEach((p, i) => {
          text += `${i + 1}. @${p.id.split('@')[0]}\n`;
          mentions.push(p.id);
        });
        await ctx.sock.sendMessage(ctx.jid, { text, mentions });
      } catch {
        await ctx.reply('❌ Erro.');
      }
    }
  },
