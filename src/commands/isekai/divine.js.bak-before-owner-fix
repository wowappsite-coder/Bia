const { isOwnerJid } = require('../../utils/ownerCheck');
const isekaiDb = require('../../isekai/db');
const divine = require('../../isekai/divine');

function need(ctx) {
  const g = isekaiDb.scopeGroup(ctx);
  const d = isekaiDb.getPlayerData(ctx.sender, g);
  if (!d || !d.race) return { ok: false, msg: 'Cria personagem: iskiniciar Nome' };
  divine.ensureDivine(d);
  divine.clearExpiredBlessings(d);
  return { ok: true, data: d, group: g };
}
function save(ctx, g, d) { isekaiDb.savePlayerData(ctx.sender, g, d); }
function arg0(ctx) {
  if (ctx.args && ctx.args[0]) return String(ctx.args[0]).toLowerCase();
  const t = String(ctx.text || '').trim().split(/\s+/);
  return (t[0] || '').toLowerCase();
}
function isOwnerCtx(ctx) {
  try {
    if (typeof ctx.isOwner = (== 'function') return !!ctx.isOwner()) || (typeof isOwnerJid==='function' && isOwnerJid(ctx.sender||ctx.senderJid||ctx.participant||'')); /* BTZ_OWNER_ASSIGN */
    if (ctx.owner === true) return true;
  } catch (_) {}
  return false;
}

module.exports = [
  { name: 'iskdeuses', category: 'isekai',
    handler: async (ctx) => {
      let t = 'DEUSES\n\n';
      divine.GODS.forEach(function (g) { t += g.emoji + ' ' + g.name + ' [' + g.id + ']\n'; });
      t += '\niskorar <id> | iskoferecer <id> iene|item\niskpacto <id> | iskbencaos';
      await ctx.reply(t);
    }},
  { name: 'iskbencaos', category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx); if (!n.ok) return ctx.reply(n.msg);
      const b = n.data.blessings || [];
      if (!b.length) return ctx.reply('Sem bencaos.\nOra com favor alto: iskorar luz');
      let t = 'BENCAOS\n\n';
      b.forEach(function (x) {
        const m = Math.max(0, Math.ceil((x.until - Date.now()) / 60000));
        t += x.name + ' (\~' + m + 'min)\n';
      });
      await ctx.reply(t);
    }},
  { name: 'iskorar', category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx); if (!n.ok) return ctx.reply(n.msg);
      const id = arg0(ctx);
      if (!id) return ctx.reply('Uso: iskorar luz');
      const r = divine.pray(n.data, id);
      if (!r.ok) return ctx.reply(r.msg);
      save(ctx, n.group, n.data);
      let msg = 'Oraste a ' + r.god.emoji + ' ' + r.god.name + '\nFavor: ' + r.favor;
      if (r.blessed) msg += '\nRecebeste: ' + r.blessed;
      await ctx.reply(msg);
    }},
  { name: 'iskoferecer', category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx); if (!n.ok) return ctx.reply(n.msg);
      const parts = (ctx.args && ctx.args.length) ? ctx.args.map(String) : String(ctx.text || '').trim().split(/\s+/).filter(Boolean);
      const godId = (parts[0] || '').toLowerCase();
      const item = (parts[1] || 'iene').toLowerCase();
      if (!godId) return ctx.reply('Uso: iskoferecer luz iene\nou iskoferecer luz cristal');
      const r = divine.offer(n.data, godId, item);
      if (!r.ok) return ctx.reply(r.msg);
      save(ctx, n.group, n.data);
      await ctx.reply('Oferenda a ' + r.god.name + '\nFavor ' + r.favor + ' (+' + r.delta + ')');
    }},
  { name: 'iskpacto', category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx); if (!n.ok) return ctx.reply(n.msg);
      const id = arg0(ctx);
      if (!id) {
        if (n.data.pact) return ctx.reply('Pacto: ' + n.data.pact.name + '\nQuebrar: iskpacto_quebrar');
        return ctx.reply('Uso: iskpacto luz\nRequer favor >= 40 e Y80');
