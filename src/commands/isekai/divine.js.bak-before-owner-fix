  { name: 'ativartrapaça', aliases: ['ativartrapaca', 'isktrapaca'], category: 'isekai',
    handler: async (ctx) => {
      if (!isOwnerCtx(ctx)) return ctx.reply('Sem permissao.');
      global.__isekaiCheat = global.__isekaiCheat || {};
      global.__isekaiCheat[ctx.sender] = !global.__isekaiCheat[ctx.sender];
      console.log('[isekai-admin]', ctx.sender, 'cheat', global.__isekaiCheat[ctx.sender]);
      await ctx.reply(
        'Trapaca Isekai: ' + (global.__isekaiCheat[ctx.sender] ? 'ON' : 'OFF') +
        '\nFerramentas: iskgiveiene | isksetlevel | iskreviver'
      );
    }},
  { name: 'iskgiveiene', category: 'isekai',
    handler: async (ctx) => {
      if (!isOwnerCtx(ctx)) return ctx.reply('Sem permissao.');
      if (!(global.__isekaiCheat && global.__isekaiCheat[ctx.sender])) return ctx.reply('Ativa ativartrapaca primeiro.');
      const n = need(ctx); if (!n.ok) return ctx.reply(n.msg);
      const amt = parseInt(arg0(ctx) || '100', 10) || 100;
      n.data.iene = (n.data.iene || 0) + Math.min(10000, Math.max(1, amt));
      save(ctx, n.group, n.data);
      console.log('[isekai-admin]', ctx.sender, 'giveiene', amt);
      await ctx.reply('Admin: IENE = ' + n.data.iene);
    }},
  { name: 'isksetlevel', category: 'isekai',
    handler: async (ctx) => {
      if (!isOwnerCtx(ctx)) return ctx.reply('Sem permissao.');
