const { pickMonster, pickBoss } = require('./monsters');
let applyLootFn = null;
try { applyLootFn = require('./economy').applyLoot; } catch (_) {}
const battles = new Map();
const pendingDuel = new Map();

function keyOf(jid, group) { return (group || 'global') + '|' + jid; }
function rand(a, b) { return Math.floor(Math.random() * (b - a + 1)) + a; }
function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
function getBattle(jid, group) { return battles.get(keyOf(jid, group)) || null; }
function setBattle(jid, group, state) { battles.set(keyOf(jid, group), state); }
function clearBattle(jid, group) { battles.delete(keyOf(jid, group)); }

function calcDamage(attacker, defender, skill) {
  const a = attacker.attrs || {};
  const d = defender.attrs || defender;
  const isMagic = skill && (skill.type === 'magia' || skill.type === 'suporte');
  let base = skill ? (skill.power || 10) : ((a.forca || 10) + rand(0, 4));
  if (skill && isMagic) base = base + Math.floor((a.magia || 0) * 0.4);
  else if (skill) base = base + Math.floor((a.forca || 0) * 0.35);
  const def = d.defesa != null ? d.defesa : (d.def || 0);
  let dmg = Math.max(1, base - Math.floor(def * 0.35) + rand(-2, 3));
  const critChance = clamp(5 + Math.floor((a.precisao || 10) / 10) + Math.floor((a.sorte || 10) / 20), 5, 35);
  const crit = Math.random() * 100 < critChance;
  if (crit) dmg = Math.floor(dmg * 1.6);
  const hitChance = clamp(75 + (a.precisao || 10) - (d.agilidade || d.spd || 10), 40, 95);
  const hit = Math.random() * 100 < hitChance;
  return { dmg: hit ? dmg : 0, crit: crit, hit: hit, miss: !hit };
}

function startPve(playerData, opts) {
  opts = opts || {};
  const mon = opts.boss ? pickBoss(playerData.level) : pickMonster(playerData.level);
  mon.hpMax = mon.hp;
  mon.attrs = { defesa: mon.def, agilidade: mon.spd, forca: mon.atk };
  return {
    type: opts.boss ? 'boss' : 'pve',
    enemy: mon,
    phaseIdx: 0,
    playerHp: playerData.hp,
    playerMana: playerData.mana,
    turn: 'player',
    defending: false
  };
}

function startDungeon(playerData) {
  return {
    type: 'dungeon',
    room: 1,
    maxRooms: 3 + rand(0, 2),
    battle: startPve(playerData, {}),
    playerHp: playerData.hp,
    playerMana: playerData.mana
  };
}

function applyPlayerAttack(state, playerData, skill) {
  const lines = [];
  if (skill) {
    if ((skill.mana || 0) > state.playerMana) {
      return { ok: false, msg: 'Mana insuficiente (' + state.playerMana + '/' + (skill.mana || 0) + ')' };
    }
    state.playerMana -= skill.mana || 0;
    lines.push('Usaste ' + (skill.emoji || '') + ' *' + skill.name + '*');
  } else {
    lines.push('Ataque basico!');
  }
  const r = calcDamage({ attrs: playerData.attrs }, { attrs: state.enemy.attrs, defesa: state.enemy.def, agilidade: state.enemy.spd }, skill || null);
  if (r.miss) lines.push('Errou o ataque!');
  else {
    state.enemy.hp = Math.max(0, state.enemy.hp - r.dmg);
    lines.push((r.crit ? 'CRITICO! ' : '') + 'Causaste *' + r.dmg + '* de dano.');
    lines.push((state.enemy.emoji || '') + ' ' + state.enemy.name + ' HP: ' + state.enemy.hp + '/' + state.enemy.hpMax);
  }
  if (state.type === 'boss' && state.enemy.phases) {
    const ratio = state.enemy.hp / state.enemy.hpMax;
    for (let i = 0; i < state.enemy.phases.length; i++) {
      const p = state.enemy.phases[i];
      if (ratio <= p.at && state.phaseIdx <= i) {
        state.phaseIdx = i + 1;
        state.enemy.atk = Math.floor(state.enemy.atk * (p.atkMod || 1.3));
        lines.push(p.msg);
      }
    }
  }
  if (state.enemy.hp <= 0) return { ok: true, lines: lines, victory: true };
  const er = calcDamage(
    { attrs: { forca: state.enemy.atk, precisao: 12, sorte: 10, magia: state.enemy.atk } },
    { attrs: playerData.attrs },
    null
  );
  let edmg = er.dmg;
  if (state.defending) {
    edmg = Math.max(1, Math.floor(edmg * 0.5));
    lines.push('Defesa reduziu o dano!');
  }
  state.defending = false;
  if (er.miss) lines.push(state.enemy.name + ' errou!');
  else {
    state.playerHp = Math.max(0, state.playerHp - edmg);
    lines.push((state.enemy.emoji || '') + ' ' + state.enemy.name + ' causou *' + edmg + '*!');
    lines.push('Teu HP: ' + state.playerHp + '/' + playerData.hpMax);
  }
  if (state.playerHp <= 0) return { ok: true, lines: lines, defeat: true };
  return { ok: true, lines: lines };
}

function tryFlee(state, playerData) {
  const chance = clamp(40 + (playerData.attrs.agilidade || 10) - (state.enemy.spd || 5) + Math.floor((playerData.attrs.sorte || 10) / 10), 15, 85);
  return { ok: Math.random() * 100 < chance, chance: chance };
}

function reward(playerData, enemy) {
  const xp = enemy.xp || 10;
  let iene = 0;
  if (enemy.iene) iene = rand(enemy.iene[0], enemy.iene[1]);
  playerData.xp = (playerData.xp || 0) + xp;
  playerData.iene = (playerData.iene || 0) + iene;
  let leveled = false;
  while (playerData.xp >= (playerData.xpNext || 100)) {
    playerData.xp -= playerData.xpNext || 100;
    playerData.level = (playerData.level || 1) + 1;
    playerData.xpNext = 100 + playerData.level * 40;
    playerData.hpMax = (playerData.hpMax || 100) + 8;
    playerData.manaMax = (playerData.manaMax || 50) + 5;
    leveled = true;
  }
  playerData.hp = Math.min(playerData.hpMax, Math.max(1, playerData.hp));
  playerData.mana = Math.min(playerData.manaMax, playerData.mana);
  return { xp: xp, iene: iene, leveled: leveled, level: playerData.level };
}

function challengeDuel(fromJid, fromName, toJid, group) {
  pendingDuel.set(toJid + '|' + (group || 'global'), { from: fromJid, fromName: fromName, to: toJid, group: group || 'global', at: Date.now() });
}
function getPending(toJid, group) { return pendingDuel.get(toJid + '|' + (group || 'global')) || null; }
function clearPending(toJid, group) { pendingDuel.delete(toJid + '|' + (group || 'global')); }

function startDuel(aData, bData, aJid, bJid, group) {
  const state = {
    type: 'pvp',
    group: group || 'global',
    a: { jid: aJid, name: aData.name, hp: 10, hpMax: 10, mana: Math.min(30, aData.mana || 30), manaMax: Math.min(30, aData.manaMax || 30), attrs: aData.attrs, skills: aData.skills || [] },
    b: { jid: bJid, name: bData.name, hp: 10, hpMax: 10, mana: Math.min(30, bData.mana || 30), manaMax: Math.min(30, bData.manaMax || 30), attrs: bData.attrs, skills: bData.skills || [] },
    turn: aJid,
    defending: null
  };
  setBattle(aJid, group, state);
  setBattle(bJid, group, state);
  return state;
}

function formatDuel(state) {
  const t = state.turn === state.a.jid ? state.a.name : state.b.name;
  return 'DUELO ISEKAI\n\n' + state.a.name + ' HP ' + state.a.hp + '/10 MP ' + state.a.mana + '\nVS\n' + state.b.name + ' HP ' + state.b.hp + '/10 MP ' + state.b.mana + '\n\nTurno: ' + t + '\niskatacar | iskusar <hab> | iskdefender';
}

function duelAction(state, actorJid, action, skillName) {
  if (state.turn !== actorJid) return { ok: false, msg: 'Nao e o teu turno.' };
  const me = state.a.jid === actorJid ? state.a : state.b;
  const foe = state.a.jid === actorJid ? state.b : state.a;
  const lines = [];
  if (action === 'defend') {
    state.defending = actorJid;
    lines.push(me.name + ' defende!');
  } else if (action === 'skill') {
    const skills = me.skills || [];
    const sk = skills.find(function (s) {
      return String(s.name).toLowerCase().indexOf(String(skillName || '').toLowerCase()) >= 0 || String(s.id).toLowerCase() === String(skillName || '').toLowerCase();
    });
    if (!sk) return { ok: false, msg: 'Nao tens essa habilidade. iskhabilidades' };
    if ((sk.mana || 0) > me.mana) return { ok: false, msg: 'Mana insuficiente.' };
    me.mana -= sk.mana || 0;
    const r = calcDamage({ attrs: me.attrs }, { attrs: foe.attrs }, sk);
    lines.push((sk.emoji || '') + ' ' + sk.name);
    if (r.miss) lines.push('Errou!');
    else {
      let dmg = r.dmg;
      if (state.defending === foe.jid) { dmg = Math.max(1, Math.floor(dmg * 0.5)); lines.push('Reduzido!'); }
      foe.hp = Math.max(0, foe.hp - dmg);
      lines.push((r.crit ? 'CRIT ' : '') + 'Dano ' + dmg + ' -> HP ' + foe.hp + '/10');
    }
    state.defending = null;
  } else {
    const r = calcDamage({ attrs: me.attrs }, { attrs: foe.attrs }, null);
    lines.push('Ataque basico');
    if (r.miss) lines.push('Errou!');
    else {
      let dmg = Math.max(1, Math.min(4, Math.floor(r.dmg / 3)));
      if (state.defending === foe.jid) { dmg = Math.max(1, Math.floor(dmg * 0.5)); lines.push('Reduzido!'); }
      foe.hp = Math.max(0, foe.hp - dmg);
      lines.push((r.crit ? 'CRIT ' : '') + 'Dano ' + dmg + ' -> HP ' + foe.hp + '/10');
    }
    state.defending = null;
  }
  if (foe.hp <= 0) return { ok: true, lines: lines, winner: me, loser: foe, over: true };
  state.turn = foe.jid;
  return { ok: true, lines: lines, over: false };
}

module.exports = {
  getBattle, setBattle, clearBattle, startPve, startDungeon, applyPlayerAttack, tryFlee, reward,
  challengeDuel, getPending, clearPending, startDuel, formatDuel, duelAction, battles
};
