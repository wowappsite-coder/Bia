/**
 * BEATRIZ BOT - Entry Point
 */
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason, fetchLatestBaileysVersion, makeCacheableSignalKeyStore } = require('@whiskeysockets/baileys');
const pino = require('pino');
const qrcode = require('qrcode-terminal');
const path = require('path');
const fs = require('fs');

const config = require('./config');
const { initDatabase, getUser, updateUser, getGroup, isBlacklisted, log, setScope } = require('./database');
const { loadCommands } = require('./commands/loader');
const registry = require('./commands/registry');
const commandMedia = require('./services/commandMedia');
const { parseMessage } = require('./utils/parser');
const msgCache = require('./utils/msgCache');
const afkHook = require('./commands/grupo/afk');
const Context = require('./utils/context');
const { registerMenuCommands } = require('./utils/menu');
const { analyzePayment, formatDetectionReply } = require('./services/payment');
const { checkSecurity, checkSubscription } = require('./middlewares/security');
const welcomeBanner = require('./services/welcomeBanner');

// Logger
const logger = pino({ level: config.logLevel });
let commandsLoaded = false;

async function startBot() {
  // Garante pastas
  [config.sessionPath, config.logPath, path.dirname(config.dbPath)].forEach(d => {
    if (!fs.existsSync(d)) fs.mkdirSync(d, { recursive: true });
  });

  // Banco
  initDatabase();

  // Comandos (só uma vez — reconexão não duplica)
  if (!commandsLoaded) {
    loadCommands();
    registerMenuCommands();
    commandsLoaded = true;
  }

  const stats = registry.stats();
  console.log(`\n🤖 ${config.botName}`);
  console.log(`📦 Comandos principais: ${stats.totalMain}`);
  console.log(`🔗 Aliases: ${stats.totalAliases}`);
  console.log(`👑 Dono: ${config.ownerNumber}\n`);

  const { state, saveCreds } = await useMultiFileAuthState(config.sessionPath);
  const { version } = await fetchLatestBaileysVersion();

  const sock = makeWASocket({
    version,
    auth: {
      creds: state.creds,
      keys: makeCacheableSignalKeyStore(state.keys, logger)
    },
    printQRInTerminal: false,
    logger: pino({ level: 'silent' }),
    generateHighQualityLinkPreview: false,
    syncFullHistory: false,
    markOnlineOnConnect: true,
    getMessage: async () => undefined
  });

  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', async (update) => {
    const { connection, lastDisconnect, qr } = update;
    if (qr) {
      console.log('\n📱 Escaneie o QR Code:\n');
      qrcode.generate(qr, { small: true });
    }
    if (connection === 'open') {
      console.log(`✅ ${config.botName} conectado!`);
      log('system', 'Bot conectado');
    }
    if (connection === 'close') {
      const code = lastDisconnect?.error?.output?.statusCode;
      const shouldReconnect = code !== DisconnectReason.loggedOut;
      console.log('Conexão fechada. Código:', code, 'Reconectar:', shouldReconnect);
      if (shouldReconnect) {
        setTimeout(() => startBot(), 3000);
      } else {
        console.log('Deslogado. Apague a pasta session e reinicie.');
      }
    }
  });

  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    for (const msg of messages) {
      try {
        if (!msg.message || msg.key.remoteJid === 'status@broadcast') continue;
        const body = msg.message?.conversation
          || msg.message?.extendedTextMessage?.text
          || msg.message?.imageMessage?.caption
          || '';
        console.log('[MSG]', type || '-', (msg.key?.remoteJid || '').slice(0, 25), body.slice(0, 30));
        await handleMessage(sock, msg);
      } catch (e) {
        console.error('[MSG ERROR]', e);
      }
    }
  });

  // Welcome / Goodbye
  sock.ev.on('group-participants.update', async (update) => {
    try {
      const g = getGroup(update.id);
      if (update.action === 'add' && g.welcome) {
        for (const p of update.participants) {
          const tag = '@' + String(p).split('@')[0].split(':')[0];
          const caption =
            '👋 Seja bem-vindo(a) ' + tag + ' ao grupo!\n' +
            'É um prazer ter você aqui. Esperamos que aproveite e participe bastante! 💚';
          let sent = false;
          try {
            const media = await welcomeBanner.buildWelcomeMedia(sock, update.id, p);
            if (media && media.buffer) {
              await sock.sendMessage(update.id, {
                image: media.buffer,
                caption,
                mentions: [p]
              });
              sent = true;
            }
          } catch (e) {
            console.error('[welcomeBanner]', e.message);
          }
          if (!sent) {
            const text = (require('./database').getSetting('welcome_msg') || 'Bem-vindo @user!')
              .replace('@user', tag)
              .replace('{group}', g.name || 'grupo');
            await sock.sendMessage(update.id, { text, mentions: [p] });
          }
        }
      }
      if (update.action === 'remove' && g.goodbye) {
        for (const p of update.participants) {
          await sock.sendMessage(update.id, {
            text: `👋 @${p.split('@')[0]} saiu do grupo.`,
            mentions: [p]
          });
        }
      }
    } catch (e) {
      console.error('Group update error', e.message);
    }
  });

  // Anti-delete: avisa quando mensagem é apagada (se ativado no grupo)
  sock.ev.on('messages.delete', async (item) => {
    try {
      const keys = item.keys || (item.key ? [item.key] : []);
      for (const key of keys) {
        if (!key?.remoteJid || !key.remoteJid.endsWith('@g.us')) continue;
        const g = getGroup(key.remoteJid);
        if (!g || !g.antidelete) continue;
        const who = key.participant || key.remoteJid;
        await sock.sendMessage(key.remoteJid, {
          text: `🗑️ Mensagem apagada detectada (anti-delete)\nPor: @${String(who).split('@')[0]}`,
          mentions: [who]
        }).catch(() => {});
      }
    } catch (e) {
      console.error('antidelete error', e.message);
    }
  });

  return sock;
}

async function handleMessage(sock, msg) {
  if (!msg.message) return;
  try { msgCache.saveMessage(msg); } catch (_) {}
  // ignora eco do próprio bot (mas loga se for debug)
  if (msg.key.fromMe) return;
  if (msg.key.remoteJid === 'status@broadcast') return;

  const sender = msg.key.participantPn || msg.key.participant || msg.key.remoteJidAlt || msg.key.remoteJid;
  const jid = msg.key.remoteJid;
  // Isola economia/XP/RPG por grupo
  try { setScope(jid && jid.endsWith('@g.us') ? jid : 'global'); } catch (_) {}

  // Blacklist
  if (isBlacklisted(sender)) return;

  if (jid.endsWith('@g.us')) {
    try {
      if (afkHook && typeof afkHook.onMessage === 'function') {
        await afkHook.onMessage(sock, msg, sender, jid);
      }
    } catch (_) {}
  }

  // Segurança em tempo real (anti-link, anti-img, etc.)
  if (jid.endsWith('@g.us')) {
    const blocked = await checkSecurity(sock, msg);
    if (blocked) return;

    // Assinatura / aluguel vencido
    if (!config.isOwner(sender)) {
      const sub = checkSubscription(jid);
      if (!sub.ok) {
        // Permite apenas menu/ping básicos quando bloqueado? Bloqueia comandos.
        const parsedEarly = parseMessage(msg);
        if (parsedEarly && parsedEarly.command) {
          const free = ['menu', 'ping', 'aluguel', 'assinatura', 'planosaluguel', 'owner', 'info', 'dono', 'menu aluguel', 'menualuguel'];
          if (!free.includes(parsedEarly.command)) {
            const ownerNum = config.ownerDisplay || config.ownerNumber;
            await sock.sendMessage(jid, {
              text:
                '⚠️ *ALUGUEL INATIVO / EXPIRADO* ⚠️\n\n' +
                'Este grupo não tem plano ativo.\n' +
                'Digite *aluguel* para ver os planos.\n\n' +
                '📩 Contratação: fale com o Owner\n' +
                '📞 ' + ownerNum
            }, { quoted: msg }).catch(() => {});
            return;
          }
        }
      }
    }
  }

  // Atualiza user stats
  try {
    const user = getUser(sender);
    updateUser(sender, {
      messages: (user.messages || 0) + 1,
      xp: (user.xp || 0) + config.xpPerMessage,
      level: Math.floor(((user.xp || 0) + config.xpPerMessage) / 100) + 1,
      pushname: msg.pushName || user.pushname
    });
  } catch {}

  // Parse
  const parsed = parseMessage(msg);
  if (!parsed) return;

  // Pagamento sem prefixo
  if (parsed.isPayment && parsed.paymentData) {
    const analysis = analyzePayment(parsed.paymentData, sender);
    const reply = formatDetectionReply(parsed.paymentData, analysis);
    await sock.sendMessage(msg.key.remoteJid, { text: reply }, { quoted: msg });
    log('payment', analysis.status, sender, parsed.paymentData);
    return;
  }

  if (!parsed.command) return;

  const cmd = registry.get(parsed.command);
  if (!cmd) return;

  // Contexto
  const ctx = new Context(sock, msg, parsed);

  // Checks de permissão
  if (cmd.ownerOnly && !ctx.isOwner()) {
    return ctx.reply('❌ Apenas o dono.');
  }
  if (cmd.botAdminOnly && !ctx.isBotAdmin()) {
    return ctx.reply('❌ Apenas administradores do bot.');
  }
  if (cmd.groupOnly && !ctx.isGroup) {
    return ctx.reply('❌ Apenas em grupos.');
  }
  if (cmd.privateOnly && ctx.isGroup) {
    return ctx.reply('❌ Apenas no privado.');
  }
  if (cmd.adminOnly && ctx.isGroup) {
    const isAdm = await ctx.isGroupAdmin() || ctx.isOwner() || ctx.isBotAdmin();
    if (!isAdm) return ctx.reply('❌ Apenas administradores do grupo.');
  }

  // Comandos bloqueados no grupo
  if (ctx.isGroup) {
    try {
      const g = ctx.group;
      let blocked = [];
      try { blocked = JSON.parse(g.blocked_cmds || '[]'); } catch {}
      if (blocked.includes(cmd.name)) {
        return ctx.reply('🚫 Este comando está bloqueado neste grupo.');
      }
      // Mute
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      if (mutados.includes(sender)) return;
    } catch {}
  }

  // Anti-spam simples
  // (pode expandir)

  // XP comando
  try {
    const u = ctx.user;
    updateUser(sender, {
      commands_used: (u.commands_used || 0) + 1,
      xp: (u.xp || 0) + config.xpPerCommand
    });
  } catch {}

  // Reação automática em qualquer comando
  try {
    const AUTO_REACT_EMOJIS = ['❤️','🌸','🌼','🌹','🤍','💜','💙','🫦','👄','🧃','🧋','🍩','🍥','🍓','📜','💛','🈶','🈚','🈵','🈹','🈲','✅','🎯','🗽','🍞','🍇','🍌'];
    const emoji = AUTO_REACT_EMOJIS[Math.floor(Math.random() * AUTO_REACT_EMOJIS.length)];
    ctx.react(emoji).catch(function () {});
  } catch (_) {}

  // Executa
  try {
    let mediaWrap = null;
  try { mediaWrap = commandMedia.wrapContext(ctx, cmd.name, (parsed && parsed.args) || [], [cmd.name].concat(cmd.aliases || []).concat([(parsed && parsed.command) || ''])); } catch (_) {}
  await cmd.handler(ctx);
    try {
      if (mediaWrap && mediaWrap.info && !mediaWrap.used) {
        await commandMedia.sendOnly(ctx, mediaWrap.info);
      }
    } catch (e2) { console.error('[commandMedia]', e2.message); }
  } catch (e) {
    console.error(`[CMD ERROR] ${cmd.name}:`, e);
    log('cmd_error', `${cmd.name}: ${e.message}`, sender);
    await ctx.reply('❌ Ocorreu um erro ao executar o comando.').catch(() => {});
  }
}

// Start
startBot().catch(e => {
  console.error('Falha ao iniciar:', e);
  process.exit(1);
});
