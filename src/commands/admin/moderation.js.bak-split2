const KICK_SUCCESS_MSGS = ["👢 @usuario levou o chute mais motivado do mês. Fora 😂", "🚪 Empurramos @usuario com carinho... e com o pé.", "📦 @usuario foi no lixo seco. Até a próxima, problema.", "💨 @usuario voou mais rápido que a dignidade dele.", "🏃 @usuario nem correu: a vergonha já tinha saído na frente. KICK!", "👋 Foi bom? Não. Mas @usuario já era. Tchau.", "🎫 Passe de @usuario: invalidado por excesso de vergonha alheia.", "🚨 Remoção: @usuario. Motivo extra: ninguém sentiu falta.", "😂 Fiscalização riu na cara de @usuario e deu KICK.", "🚪 Porta abriu, @usuario caiu, porta fechou. Clássico.", "🛵 Delivery de vexame: @usuario entregue fora, quentinho.", "🧹 Varrido. @usuario era só poeira com opinião.", "⏱️ Tempo de @usuario esgotou. E a paciência do grupo também.", "🎒 Mochila, vergonha e KICK. @usuario no combo completo.", "🪧 Não mora mais aqui: @usuario foi despejado do convívio.", "🚶 Caminhada da vergonha até a saída. Tchau, @usuario.", "🎛️ EJECT em @usuario. Até o bot sentiu alívio.", "🫧 Bolha de ridículo: @usuario estourou pra fora do grupo.", "📎 Desanexado. @usuario era o anexo inútil da conversa.", "🛎️ Checkout: @usuario. Avaliação: 0 estrelas. Não volte.", "🌪️ Furacão da moderação. @usuario foi o primeiro detrito.", "🧴 Limpeza profunda: tiramos @usuario e o clima melhorou.", "🎁 Presente pro grupo: KICK em @usuario. Todo mundo agradece.", "🪙 Cara = fica. Coroa = @usuario fora. Deu coroa 😂", "📍 Localização de @usuario: irrelevante. Já era.", "🧃 Suco de humilhação gelado. @usuario bebeu até a última gota.", "🪄 Pó de sumiço. @usuario? Que @usuario?", "🪙 Fichas zeradas. @usuario quebre a banca noutro lugar.", "📣 Atenção: @usuario foi expulso e o grupo agradeceu em silêncio.", "🧩 Peça errada do quebra-cabeça. @usuario removido. Encaixou melhor."];
function pickMsg(arr){return arr[Math.floor(Math.random()*arr.length)];}
function banKickReason(ctx){try{return (ctx.args||[]).filter(function(a){return String(a).indexOf('@')===-1;}).join(' ').trim();}catch(_){return '';}}
function formatBanKickMsg(ctx,target,kind){const pool=kind==='kick'?KICK_SUCCESS_MSGS:BAN_SUCCESS_MSGS;let msg=pickMsg(pool).split('@usuario').join(tag(target));const reason=banKickReason(ctx);if(reason)msg+='\n📝 Motivo: *'+reason+'*';return msg;}

