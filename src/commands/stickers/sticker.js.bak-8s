/**
 * Stickers - imagem e video animado (max 15s)
 */
let downloadMediaMessage = null;
let downloadContentFromMessage = null;
try {
  const baileys = require('@whiskeysockets/baileys');
  downloadMediaMessage = baileys.downloadMediaMessage;
  downloadContentFromMessage = baileys.downloadContentFromMessage;
} catch (e) {
  console.warn('[LOADER]', 'baileys media:', e.message);
}
const media = require('../../utils/media');

function resolveTargetMedia(ctx) {
  const msg = ctx.msg;
  const m = msg.message || {};
  const ci =
    (m.extendedTextMessage && m.extendedTextMessage.contextInfo) ||
    (m.imageMessage && m.imageMessage.contextInfo) ||
    (m.videoMessage && m.videoMessage.contextInfo) ||
    (m.stickerMessage && m.stickerMessage.contextInfo) ||
    null;
  const quoted = ci && ci.quotedMessage ? ci.quotedMessage : null;
  let targetMsg = msg;
  let mediaNode = null;
  let mediaType = null;

  if (quoted) {
    if (quoted.videoMessage) {
      mediaNode = quoted.videoMessage; mediaType = 'video';
      targetMsg = { key: { remoteJid: ctx.jid, id: ci.stanzaId, participant: ci.participant }, message: quoted };
    } else if (quoted.imageMessage) {
      mediaNode = quoted.imageMessage; mediaType = 'image';
      targetMsg = { key: { remoteJid: ctx.jid, id: ci.stanzaId, participant: ci.participant }, message: quoted };
    } else if (quoted.stickerMessage) {
      mediaNode = quoted.stickerMessage; mediaType = 'sticker';
      targetMsg = { key: { remoteJid: ctx.jid, id: ci.stanzaId, participant: ci.participant }, message: quoted };
    }
  }
  if (!mediaNode) {
    if (m.videoMessage) { mediaNode = m.videoMessage; mediaType = 'video'; targetMsg = msg; }
    else if (m.imageMessage) { mediaNode = m.imageMessage; mediaType = 'image'; targetMsg = msg; }
    else if (m.stickerMessage) { mediaNode = m.stickerMessage; mediaType = 'sticker'; targetMsg = msg; }
  }
  const seconds = (mediaType === 'video' && mediaNode && mediaNode.seconds) ? mediaNode.seconds : 0;
  return { targetMsg, mediaNode, mediaType, isVideo: mediaType === 'video', isImage: mediaType === 'image', isSticker: mediaType === 'sticker', seconds };
}

async function streamToBuffer(stream) {
  const chunks = [];
  for await (const chunk of stream) chunks.push(chunk);
  return Buffer.concat(chunks);
}

async function getMediaBuffer(ctx) {
  const info = resolveTargetMedia(ctx);
  if (!info.mediaNode || !info.mediaType) return null;

  if (downloadContentFromMessage) {
    try {
      const stream = await downloadContentFromMessage(info.mediaNode, info.mediaType);
      const buf = await streamToBuffer(stream);
      if (buf && buf.length > 0) return buf;
    } catch (e) { console.error('downloadContentFromMessage:', e.message); }
  }
  if (downloadMediaMessage) {
    try {
      const buf = await downloadMediaMessage(info.targetMsg, 'buffer', {}, {
        logger: console,
        reuploadRequest: ctx.sock.updateMediaMessage
      });
      if (buf && buf.length > 0) return buf;
    } catch (e) { console.error('downloadMediaMessage:', e.message); }
  }
  return null;
}

function needMedia(ctx) {
  if (!media.available()) {
    ctx.reply('❌ Sem processador de imagem.\nnpm install jimp --legacy-peer-deps');
    return false;
  }
  return true;
}





module.exports = [
  {
    name: 'sticker',
    aliases: ['s', 'figu', 'f', 'stiker'],
    category: 'stickers',
    description: 'Cria figurinha (imagem ou video ate 15s)',
    handler: async (ctx) => {
      const info = resolveTargetMedia(ctx);
      if (!info.isImage && !info.isVideo && !info.isSticker) {
        return ctx.reply('❌ Envie ou *responda* imagem/vídeo (máx 15s) com *s*');
      }
      if (info.isVideo) {
        if (info.seconds && info.seconds > 12) {
          return ctx.reply('❌ Vídeo *' + info.seconds + 's*. Máximo: *12s*.');
        }
        try { await ctx.reply('⏳ A criar figurinha animada...'); } catch (_) {}
        const buffer = await getMediaBuffer(ctx);
        if (!buffer) return ctx.reply('❌ Não baixou o vídeo.\nTente enviar o vídeo *com legenda* s');
        try {
          const out = await media.videoToAnimatedWebp(buffer, 12);
          if (!out) return ctx.reply('❌ Nao consegui criar figurinha *animada*.\nVerifica: pkg install ffmpeg libwebp\nE usa video ate *15s*.');
          console.log('[sticker] anim size', out.length);
          await ctx.sock.sendMessage(ctx.jid, {
            sticker: out
          }, { quoted: ctx.msg });
          console.log('[sticker] anim enviado', out.length);
        } catch (e) {
          console.error('anim sticker', e.message || e);
          await ctx.reply('❌ Erro: ' + (e.message || '') + '\npkg install ffmpeg');
        }
        return;
      }
      if (!needMedia(ctx)) return;
      const buffer = await getMediaBuffer(ctx);
      if (!buffer) return ctx.reply('❌ Envie/responda uma imagem com *s*');
      try {
        const out = await media.toStickerWebp(buffer);
          await ctx.sock.sendMessage(ctx.jid, {
            sticker: out,
            isAnimated: true
          }, { quoted: ctx.msg });
      } catch (e) {
        if (e && e.png) {
          await ctx.sock.sendMessage(ctx.jid, { image: e.png, caption: '🖼️ Sem cwebp' }, { quoted: ctx.msg });
          return;
        }
        await ctx.reply('❌ Falha figurinha.\npkg install libwebp ffmpeg');
      }
    }
  },
  {
    name: 'toimg',
    aliases: ['toimage', 'paraimagem'],
    category: 'stickers',
    description: 'Figurinha → imagem',
    handler: async (ctx) => {
      const buffer = await getMediaBuffer(ctx);
      if (!buffer) return ctx.reply('❌ Responda a uma figurinha com *toimg*');
      try {
        const png = await media.toPng(buffer);
        await ctx.sock.sendMessage(ctx.jid, { image: png, caption: '🖼️ Convertido' }, { quoted: ctx.msg });
      } catch (e) {
        await ctx.reply('❌ Não converteu.\npkg install libwebp ffmpeg');
      }
    }
  },
  {
    name: 'qc',
    aliases: ['quote', 'fakequote'],
    category: 'stickers',
    description: 'Sticker de texto',
    handler: async (ctx) => {
      if (!needMedia(ctx)) return;
      const text = ctx.text || 'BEATRIZ BOT';
      try {
        const Jimp = require('jimp');
        const img = new Jimp(512, 512, 0x1a1a2eff);
        const font = await Jimp.loadFont(Jimp.FONT_SANS_16_WHITE);
        img.print(font, 20, 200, { text: text.slice(0, 100), alignmentX: Jimp.HORIZONTAL_ALIGN_CENTER }, 472);
        const out = await img.getBufferAsync(Jimp.MIME_PNG);
          await ctx.sock.sendMessage(ctx.jid, {
            sticker: out,
            isAnimated: true
          }, { quoted: ctx.msg });
      } catch (e) {
        await ctx.reply('❌ Erro qc: ' + (e.message || ''));
      }
    }
  },
  {
    name: 'stickermenu',
    aliases: ['menusticker', 'menustickers'],
    category: 'stickers',
    description: 'Menu stickers',
    handler: async (ctx) => {
      await ctx.reply('🎴 *MENU STICKERS*\n\n• s — imagem/vídeo (máx 15s)\n• toimg — figurinha → imagem\n• qc texto — figurinha de texto');
    }
  }
];
