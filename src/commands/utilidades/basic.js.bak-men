const config = require('../../config');
const os = require('os');
const crypto = require('crypto');
function uuidv4() {
  return crypto.randomUUID ? crypto.randomUUID() : ([1e7]+-1e3+-4e3+-8e3+-1e11).replace(/[018]/g, c =>
    (c ^ crypto.randomBytes(1)[0] & 15 >> c / 4).toString(16)
  );
}

module.exports = [
  {
    name: 'ping',
    aliases: ['latency', 'latencia'],
    category: 'utilidades',
    description: 'Verifica a latência do bot',
    handler: async (ctx) => {
      const start = Date.now();
      const msg = await ctx.reply('🏓 Pong...');
      const latency = Date.now() - start;
      await ctx.sock.sendMessage(ctx.jid, {
        text: `🏓 *Pong!*\n⚡ Latência: ${latency}ms\n🤖 ${config.botName}`,
        edit: msg.key
      }).catch(() => ctx.reply(`🏓 *Pong!*\n⚡ Latência: ${latency}ms`));
    }
  },
  {
    name: 'menu',
    aliases: ['help', 'ajuda', 'comandos'],
    category: 'utilidades',
    description: 'Menu principal do bot',
    handler: async (ctx) => {
      const { generateMainMenu, generateCategoryMenu, CATEGORY_META } = require('../../utils/menu');
      const arg = (ctx.args[0] || '').toLowerCase().normalize('NFD').replace(/\u0300-\u036f/g, '');
      const map = {
        adm: 'admin', admin: 'admin', administrador: 'admin',
        dono: 'dono', owner: 'dono',
        grupo: 'grupo', group: 'grupo',
        internet: 'internet', net: 'internet',
        bn: 'bn', brincadeira: 'bn', brincadeiras: 'bn',
        diversao: 'diversao', diversão: 'diversao',
        sticker: 'stickers', stickers: 'stickers', fig: 'stickers', figurinha: 'stickers',
        imagem: 'imagem', img: 'imagem', image: 'imagem',
        seguranca: 'seguranca', segurança: 'seguranca', anti: 'seguranca',
        utilidades: 'utilidades', util: 'utilidades', tools: 'utilidades',
        rpg: 'rpg', familia: 'rpg', família: 'rpg',
        xp: 'xp', rank: 'xp', ranking: 'xp',
        economia: 'economia', econ: 'economia', money: 'economia',
        aluguel: 'aluguel', assinatura: 'aluguel', rent: 'aluguel',
        jogos: 'diversao', game: 'diversao', games: 'diversao',
        download: 'download', dl: 'download', down: 'download', baixar: 'download'
      };
      if (arg === 'download' || arg === 'dl' || arg === 'down' || arg === 'baixar') {
        const reg = require('../registry');
        const c = reg.get('menudownload');
        if (c && c.handler) return c.handler(ctx);
        return ctx.reply('Use: *menudownload*');
      }
      /* MENU_SPECIAL_BRANCH */
      if (arg === 'download' || arg === 'dl' || arg === 'down' || arg === 'baixar') {
        try {
          const reg = require('../registry');
          const c = reg.get('menudownload');
          if (c && c.handler) return c.handler(ctx);
        } catch (e) {}
        return ctx.reply('Use: *menudownload*');
      }
      if (arg === 'modos' || arg === 'modo' || arg === 'sistemas') {
        try {
          const reg = require('../registry');
          const c = reg.get('menumodos');
          if (c && c.handler) return c.handler(ctx);
        } catch (e) {}
        return ctx.reply('Use: *menumodos*');
      }
      if (arg && map[arg]) {
        return ctx.reply(generateCategoryMenu(map[arg], ctx));
      }
      if (arg && CATEGORY_META[arg]) {
        return ctx.reply(generateCategoryMenu(arg, ctx));
      }
      if (arg === 'webgames' || arg === 'webgame' || arg === 'jogos' || arg === 'jogo' || arg === 'game' || arg === 'games' || arg === 'jogosweb') {
        try {
          const mod = require('../diversao/jogosWeb');
          const list = Array.isArray(mod) ? mod : [];
          const j = list.find(c => c && c.name === 'jogos');
          if (j && j.handler) return j.handler(ctx);
        } catch (e) {}
      }
      // WEB_GAMES_INJECT
      try {
        const __arg = (typeof arg !== 'undefined' ? arg : (ctx.args[0] || '')).toLowerCase();
        if (['webgames','webgame','jogos','jogo','games','game','jogosweb'].includes(__arg)) {
          const mod = require('../diversao/jogosWeb');
          const list = Array.isArray(mod) ? mod : [];
          const j = list.find(c => c && c.name === 'jogos');
          if (j && j.handler) return await j.handler(ctx);
        }
      } catch (e) {}
      await ctx.reply(generateMainMenu(ctx));
    }
  },
  {
    name: 'meuid',
    aliases: ['myid', 'meu_id', 'jid'],
    category: 'utilidades',
    description: 'Mostra seu ID/número visto pelo bot',
