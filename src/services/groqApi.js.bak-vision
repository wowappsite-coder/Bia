const https = require('https');
const http = require('http');
const keys = require('./groqKeys');

const SYSTEM_PROMPT =
  'Tu es a Beatriz, a IA do Beatriz Bot no WhatsApp. ' +
  'Fala em portugues de forma natural, clara, amigavel e levemente divertida. ' +
  'Nao digas que es a Groq. Nao te apresentes em todas as mensagens; so quando fizer sentido. ' +
  'Se te perguntarem quem es: "Eu sou a Beatriz, a IA do Beatriz Bot." ' +
  'Quando receberes resultados de pesquisa, usa-os com honestidade: cita nome, breve descricao e link. ' +
  'Nunca inventes links ou factos. Se nao houver resultados uteis, diz isso. ' +
  'Respostas curtas a medias (no maximo \~1500 caracteres), adequadas ao WhatsApp.';

function httpGetJson(urlStr, headers) {
  return new Promise(function (resolve, reject) {
    let u;
    try { u = new URL(urlStr); } catch (e) { return reject(e); }
    const lib = u.protocol === 'http:' ? http : https;
    const req = lib.get({
      hostname: u.hostname,
      path: u.pathname + u.search,
      protocol: u.protocol,
      headers: Object.assign({ 'User-Agent': 'BeatrizBot/1.0', Accept: 'application/json' }, headers || {}),
      timeout: 20000
    }, function (res) {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        res.resume();
        return httpGetJson(res.headers.location, headers).then(resolve, reject);
      }
      const chunks = [];
      res.on('data', function (c) { chunks.push(c); });
      res.on('end', function () {
        const raw = Buffer.concat(chunks).toString('utf8');
        if (res.statusCode < 200 || res.statusCode >= 300) {
          return reject(new Error('HTTP ' + res.statusCode));
        }
        try { resolve(JSON.parse(raw)); }
        catch (e) { reject(new Error('JSON invalido')); }
      });
    });
    req.on('error', reject);
    req.on('timeout', function () { req.destroy(); reject(new Error('Timeout')); });
  });
}

function httpsPostJson(hostname, pathName, apiKey, bodyObj) {
  return new Promise(function (resolve, reject) {
    const body = JSON.stringify(bodyObj);
    const req = https.request({
      hostname: hostname,
      path: pathName,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: 'Bearer ' + apiKey,
        'Content-Length': Buffer.byteLength(body)
      },
      timeout: 60000
    }, function (res) {
      const chunks = [];
      res.on('data', function (c) { chunks.push(c); });
      res.on('end', function () {
        resolve({ status: res.statusCode, body: Buffer.concat(chunks).toString('utf8') });
      });
    });
    req.on('error', reject);
    req.on('timeout', function () { req.destroy(); reject(new Error('Timeout Groq')); });
    req.write(body);
    req.end();
  });
}

function needsSearch(q) {
  const s = String(q || '').toLowerCase();
  const words = [
    'pesquisa', 'pesquisar', 'procura', 'procurar', 'encontra', 'encontrar',
    'link', 'links', 'site', 'sites', 'onde', 'google', 'internet',
    'video', 'videos', 'vídeo', 'vídeos', 'musica', 'música', 'filme',
    'trailer', 'noticia', 'notícia', 'noticias', 'quem e', 'quem é',
    'o que e', 'o que é', 'informacoes', 'informações', 'sobre'
  ];
  for (let i = 0; i < words.length; i++) {
    if (s.indexOf(words[i]) >= 0) return true;
  }
  return false;
}

async function searchDuckDuckGo(query) {
  const url =
    'https://api.duckduckgo.com/?q=' + encodeURIComponent(query) +
    '&format=json&no_html=1&skip_disambig=1';
  const data = await httpGetJson(url);
  const out = [];
  if (data.AbstractText) {
    out.push({
      title: data.Heading || 'Resultado',
      snippet: data.AbstractText,
      link: data.AbstractURL || data.AbstractSource || ''
    });
  }
  const rel = data.RelatedTopics || [];
  for (let i = 0; i < rel.length && out.length < 5; i++) {
    const t = rel[i];
    if (t.Topics) {
      for (let j = 0; j < t.Topics.length && out.length < 5; j++) {
        const x = t.Topics[j];
        if (x.Text) {
          out.push({
            title: (x.Text || '').split(' - ')[0].slice(0, 80),
            snippet: x.Text || '',
            link: x.FirstURL || ''
          });
        }
      }
    } else if (t.Text) {
      out.push({
        title: (t.Text || '').split(' - ')[0].slice(0, 80),
        snippet: t.Text || '',
        link: t.FirstURL || ''
      });
    }
  }
  return out;
}

async function searchWikipedia(query) {
  const url =
    'https://pt.wikipedia.org/w/api.php?action=opensearch&limit=3&namespace=0&format=json&search=' +
    encodeURIComponent(query);
  const data = await httpGetJson(url);
  // [query, titles[], descs[], links[]]
  const titles = data[1] || [];
  const descs = data[2] || [];
  const links = data[3] || [];
  const out = [];
  for (let i = 0; i < titles.length; i++) {
    out.push({
      title: titles[i],
      snippet: descs[i] || '',
      link: links[i] || ''
    });
  }
  return out;
}

async function searchYoutube(query) {
  const key = (process.env.YOUTUBE_API_KEY || '').trim();
  if (!key) return [];
  const path =
    '/youtube/v3/search?part=snippet&type=video&maxResults=3&order=relevance&q=' +
    encodeURIComponent(query) + '&key=' + encodeURIComponent(key);
  const data = await httpGetJson('https://www.googleapis.com' + path);
  const items = data.items || [];
  return items.map(function (it) {
    const id = it.id && it.id.videoId;
    const sn = it.snippet || {};
    return {
      title: sn.title || 'Video',
      snippet: (sn.channelTitle || '') + (sn.description ? ' — ' + String(sn.description).slice(0, 100) : ''),
      link: id ? ('https://www.youtube.com/watch?v=' + id) : ''
    };
  });
}

async function gatherSearch(query) {
  const results = [];
  const q = String(query).slice(0, 200);
  const lower = q.toLowerCase();

  // videos → YouTube se houver key
  if (lower.indexOf('video') >= 0 || lower.indexOf('vídeo') >= 0 || lower.indexOf('trailer') >= 0 || lower.indexOf('youtube') >= 0) {
    try {
      const yt = await searchYoutube(q);
      for (let i = 0; i < yt.length; i++) results.push(yt[i]);
    } catch (e) {
      console.error('[bia-search] yt', e.message);
    }
  }

  try {
    const ddg = await searchDuckDuckGo(q);
    for (let i = 0; i < ddg.length; i++) results.push(ddg[i]);
  } catch (e) {
    console.error('[bia-search] ddg', e.message);
  }

  if (results.length < 2) {
    try {
      const wiki = await searchWikipedia(q);
      for (let i = 0; i < wiki.length; i++) results.push(wiki[i]);
    } catch (e) {
      console.error('[bia-search] wiki', e.message);
    }
  }

  // dedupe por link
  const seen = {};
  const uniq = [];
  for (let i = 0; i < results.length; i++) {
    const r = results[i];
    const k = r.link || r.title;
    if (!k || seen[k]) continue;
    seen[k] = true;
    uniq.push(r);
  }
  return uniq.slice(0, 5);
}

function formatSearchBlock(results) {
  if (!results || !results.length) {
    return 'Nenhum resultado de pesquisa confiavel encontrado.';
  }
  let t = 'Resultados de pesquisa (usa estes dados; nao inventes links):\n';
  for (let i = 0; i < results.length; i++) {
    const r = results[i];
    t += (i + 1) + '. ' + (r.title || 'Item') + '\n';
    if (r.snippet) t += '   ' + String(r.snippet).slice(0, 160) + '\n';
    if (r.link) t += '   Link: ' + r.link + '\n';
  }
  return t;
}

const MODEL_FALLBACKS = [
  'openai/gpt-oss-20b',
  'openai/gpt-oss-120b',
  'gemma2-9b-it',
  'llama3-8b-8192',
  'llama-3.1-8b-instant',
  'llama-3.3-70b-versatile'
];

async function chatOnce(apiKey, model, messages) {
  const r = await httpsPostJson('api.groq.com', '/openai/v1/chat/completions', apiKey, {
    model: model,
    messages: messages,
    temperature: 0.7,
    max_tokens: 900
  });
  return r;
}

async function askBeatriz(userQuestion) {
  const q = String(userQuestion || '').trim().slice(0, 4000);
  if (!q) throw new Error('empty');

  let searchBlock = '';
  if (needsSearch(q)) {
    try {
      const results = await gatherSearch(q);
      searchBlock = formatSearchBlock(results);
    } catch (e) {
      console.error('[bia-search]', e.message);
      searchBlock = 'Pesquisa externa falhou; responde so com conhecimento geral e admite incerteza.';
    }
  }

  const messages = [
    { role: 'system', content: SYSTEM_PROMPT },
    {
      role: 'user',
      content: searchBlock
        ? (searchBlock + '\n\nPergunta do utilizador: ' + q)
        : q
    }
  ];

  const available = keys.getAvailableKeys();
  if (!available.length) throw new Error('NO_KEYS');

  let lastErr = null;
  const modelsToTry = [keys.getModel()].concat(MODEL_FALLBACKS);

  for (let ki = 0; ki < available.length; ki++) {
    const entry = available[ki];
    for (let mi = 0; mi < modelsToTry.length; mi++) {
      const model = modelsToTry[mi];
      try {
        const r = await chatOnce(entry.key, model, messages);
        if (r.status === 401 || r.status === 403) {
          keys.markAuthFail(entry.name);
          lastErr = new Error('auth ' + r.status);
          break; // next key
        }
        if (r.status === 429) {
          keys.markTempFail(entry.name, 120000);
          lastErr = new Error('rate limit');
          break;
        }
        if (r.status === 404 || (r.body && r.body.indexOf('model_not_found') >= 0)) {
          lastErr = new Error('model ' + model);
          continue; // next model
        }
        if (r.status < 200 || r.status >= 300) {
          lastErr = new Error('HTTP ' + r.status + ' ' + r.body.slice(0, 100));
          keys.markTempFail(entry.name, 30000);
          break;
        }
        const data = JSON.parse(r.body);
        const text =
          data && data.choices && data.choices[0] &&
          data.choices[0].message && data.choices[0].message.content;
        if (!text || !String(text).trim()) {
          lastErr = new Error('empty response');
          continue;
        }
        return String(text).trim();
      } catch (e) {
        lastErr = e;
        console.error('[groq]', entry.name, keys.mask(entry.key), String(e.message).slice(0, 100));
      }
    }
  }
  throw lastErr || new Error('ALL_FAILED');
}

module.exports = { askBeatriz, needsSearch, gatherSearch };
