const { tag } = require('../../utils/mention');
function pick(a){return a[Math.floor(Math.random()*a.length)];}
function getTarget(ctx){let t=null;try{if(ctx.getMentionedOrQuoted)t=ctx.getMentionedOrQuoted();}catch(e){}if(!t&&ctx.mentioned&&ctx.mentioned[0])t=ctx.mentioned[0];if(t&&t===ctx.sender)t=null;return t||null;}
function fill(tpl,a,b){return tpl.split('{a}').join(tag(a)).split('{b}').join(b?tag(b):'alguem');}
async function act(ctx,w,al){const t=getTarget(ctx);const text=fill(pick(t?w:al),ctx.sender,t);await ctx.reply(text,{mentions:t?[ctx.sender,t]:[ctx.sender]});}
function cmd(n,al,w,a){return{name:n,aliases:al||[],category:"diversao",description:n,handler:async(ctx)=>act(ctx,w,a)};}
