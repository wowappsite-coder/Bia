  {
    name: 'add',
    aliases: ['adicionar'],
    category: 'admin',
    description: 'Adiciona número ao grupo',
    groupOnly: true,
    adminOnly: true,
    usage: '!add 2588xxxxxxx',
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      let num = (ctx.args[0] || '').replace(/\D/g, '');
      if (num.length < 9) return ctx.reply('❌ Número inválido.');
      if (!num.startsWith('258')) num = '258' + num;
      const jid = num + '@s.whatsapp.net';
      try {
        await ctx.sock.groupParticipantsUpdate(ctx.jid, [jid], 'add');
        await ctx.reply('✅ Convite enviado/adicionado.');
      } catch {
        await ctx.reply('❌ Não foi possível adicionar.');
      }
    }
  },
  {
    name: 'remover',
    aliases: ['remove'],
    category: 'admin',
    description: 'Remove usuário do grupo',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      try {
        await ctx.sock.groupParticipantsUpdate(ctx.jid, [target], 'remove');
        await ctx.reply('✅ Usuário removido.', { mentions: [target] });
      } catch (e) {
        await ctx.reply('❌ Não foi possível remover. Verifique se o bot é admin.');
      }
    }
  },
  {
    name: 'mute',
    aliases: ['mutar', 'silenciar'],
    category: 'admin',
    description: 'Muta usuário no bot (não recebe respostas)',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      const g = ctx.group;
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      if (!mutados.includes(target)) mutados.push(target);
      db.updateGroup(ctx.jid, { mutados: JSON.stringify(mutados) });
      await ctx.reply('🔇 Usuário mutado no bot.', { mentions: [target] });
    }
  },
  {
    name: 'desmute',
    aliases: ['desmutar', 'unmute'],
    category: 'admin',
    description: 'Desmuta usuário',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      const g = ctx.group;
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      mutados = mutados.filter(j => j !== target);
      db.updateGroup(ctx.jid, { mutados: JSON.stringify(mutados) });
      await ctx.reply('🔊 Usuário desmutado.', { mentions: [target] });
    }
  },
  {
    name: 'mutelist',
    aliases: ['listamute', 'mutados'],
    category: 'admin',
    description: 'Lista mutados',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      const g = ctx.group;
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      if (!mutados.length) return ctx.reply('📋 Nenhum usuário mutado.');
      let text = '🔇 *Mutados*\n\n';
      mutados.forEach((j, i) => { text += `${i + 1}. ${j.replace('@s.whatsapp.net', '')}\n`; });
      await ctx.reply(text);
    }
  },
