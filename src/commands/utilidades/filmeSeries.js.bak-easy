/**
 * Categoria Filme / Serie — fonte: https://filmeseriesonline.net/
 * Comandos: filme, serie, fs
 * Escolha: N1..N8 | Qualidade: F1..F4 | Download: dwfilme
 */
const fs = require('fs');
const path = require('path');
const https = require('https');
const http = require('http');
const { execFile } = require('child_process');
const dq = require('../../services/downloadQueue');

const BASE = 'https://filmeseriesonline.net';
const SESS_DIR = path.join(__dirname, '../../../data/filme-sessions');
const TMP_DIR = path.join(__dirname, '../../../data/filme-tmp');
try { fs.mkdirSync(SESS_DIR, { recursive: true }); } catch (_) {}
try { fs.mkdirSync(TMP_DIR, { recursive: true }); } catch (_) {}

function box(lines) {
  let t = '╭━━━〔 🎬 FILME / SÉRIE 〕━━━╮\n';
  for (let i = 0; i < lines.length; i++) {
    const L = lines[i];
    if (L === '' || L == null) t += '┃\n';
    else t += '┃ ' + L + '\n';
  }
  t += '╰━━━━━━━━━━━━━━━━━━━━━━╯';
  return t;
}

function sessionKey(ctx) {
  return String(ctx.jid || '') + '|' + String(ctx.sender || '');
}
function sessPath(ctx) {
  return path.join(SESS_DIR, Buffer.from(sessionKey(ctx)).toString('hex').slice(0, 48) + '.json');
}
function loadSession(ctx) {
  try {
    const p = sessPath(ctx);
    if (fs.existsSync(p)) return JSON.parse(fs.readFileSync(p, 'utf8'));
  } catch (_) {}
  return null;
}
function saveSession(ctx, data) {
  try { fs.writeFileSync(sessPath(ctx), JSON.stringify(data)); } catch (_) {}
}

function stripTags(html) {
  return String(html || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();
}

function httpGet(url, timeoutMs) {
  return new Promise(function (resolve, reject) {
    const lib = url.startsWith('https') ? https : http;
    const req = lib.get(
      url,
      {
        headers: {
          'User-Agent':
            'Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 Chrome/120.0 Mobile Safari/537.36',
          Accept: 'text/html,application/xhtml+xml',
          'Accept-Language': 'pt-BR,pt;q=0.9,en;q=0.8'
        },
        timeout: timeoutMs || 15000
      },
      function (res) {
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          return httpGet(res.headers.location, timeoutMs).then(resolve, reject);
        }
        let body = '';
        res.on('data', function (c) {
          body += c;
          if (body.length > 2.5e6) req.destroy();
        });
        res.on('end', function () {
          resolve({ status: res.statusCode || 0, body: body });
        });
      }
    );
    req.on('error', reject);
    req.on('timeout', function () {
      req.destroy();
      reject(new Error('timeout'));
    });
  });
}

function absUrl(href) {
  if (!href) return '';
  if (/^https?:\/\//i.test(href)) return href;
  if (href.startsWith('//')) return 'https:' + href;
  if (href.startsWith('/')) return BASE + href;
  return BASE + '/' + href;
}

/** Parse resultados ?s= */
function parseSearch(html) {
  const out = [];
  const seen = {};
  const re = /<a[^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
  let m;
  while ((m = re.exec(html)) && out.length < 20) {
    const href = m[1];
    if (!href || href.startsWith('#') || /javascript:/i.test(href)) continue;
    if (!/\/(filme|serie|series)\//i.test(href)) continue;
    if (/\/genero\/|\/pais\/|\/tag\//i.test(href)) continue;
    const link = absUrl(href);
    if (seen[link]) continue;
    let title = stripTags(m[2]).replace(/\s*HD\s*$/i, '').trim();
    if (!title || title.length < 2) continue;
    // limpa "HD" colado no fim
    title = title.replace(/HD$/i, '').trim();
    if (title.length < 2) continue;
    seen[link] = true;
    const isSerie = /\/serie/i.test(link);
    out.push({
      title: title.slice(0, 100),
      link: link,
      type: isSerie ? 'serie' : 'filme',
      source: 'Pobreflix'
    });
  }
  return out.slice(0, 12);
}

async function searchSite(query) {
  const url = BASE + '/?s=' + encodeURIComponent(query);
  try {
    const res = await httpGet(url, 15000);
    if (!res || !res.body) return [];
    return parseSearch(res.body);
  } catch (e) {
    console.error('[filme]', e.message);
    return [];
  }
}

function ytdlpBin() {
  const cands = [
    path.join(process.env.HOME || '', '.local/bin/yt-dlp'),
    '/data/data/com.termux/files/usr/bin/yt-dlp',
    'yt-dlp'
  ];
  for (const c of cands) {
    try {
      if (c === 'yt-dlp' || fs.existsSync(c)) return c;
    } catch (_) {}
  }
  return 'yt-dlp';
}

function runYtdlp(args, timeoutMs) {
  return new Promise(function (resolve, reject) {
    execFile(
      ytdlpBin(),
      args,
      { timeout: timeoutMs || 300000, maxBuffer: 20 * 1024 * 1024 },
      function (err, stdout, stderr) {
        if (err) {
          err.stderr = stderr;
          return reject(err);
        }
        resolve(String(stdout || ''));
      }
    );
  });
}

const QUALITIES = [
  { id: 'F1', label: 'F1 — 360p', format: 'best[height<=360]/best' },
  { id: 'F2', label: 'F2 — 480p', format: 'best[height<=480]/best' },
  { id: 'F3', label: 'F3 — 720p', format: 'best[height<=720]/best' },
  { id: 'F4', label: 'F4 — HD/melhor', format: 'best' }
];

async function cmdSearch(ctx, query, preferType) {
  await ctx.reply(box(['🔎 A pesquisar...', '*' + query + '*']));
  let results = await searchSite(query);
  if (preferType === 'filme') {
    results = results.filter(function (r) { return r.type === 'filme'; }).concat(
      results.filter(function (r) { return r.type !== 'filme'; })
    );
  } else if (preferType === 'serie') {
    results = results.filter(function (r) { return r.type === 'serie'; }).concat(
      results.filter(function (r) { return r.type !== 'serie'; })
    );
  }
  results = results.slice(0, 8);

  if (!results.length) {
    return ctx.reply(
      box(['❌ Nenhum resultado para:', '*' + query + '*', '', 'Tenta outro nome.'])
    );
  }

  saveSession(ctx, {
    step: 'choose_result',
    query: query,
    results: results
  });

  const lines = [
    '✅ *Resultados* (' + results.length + ')',
    '🔎 ' + query,
    '',
    '_Escolhe com *N1* … *N' + results.length + '*:_'
  ];
  for (let i = 0; i < results.length; i++) {
    const r = results[i];
    const tag = r.type === 'serie' ? '📺' : '🎥';
    lines.push('*' + ('N' + (i + 1)) + '* ' + tag + ' ' + r.title);
  }
  lines.push('');
  lines.push('Ex: *N1*');
  return ctx.reply(box(lines));
}

async function cmdPickResult(ctx, n) {
  const s = loadSession(ctx);
  if (!s || s.step !== 'choose_result' || !s.results) {
    return ctx.reply(box(['Nada pendente.', 'Usa: *filme <nome>* ou *serie <nome>*']));
  }
  const idx = parseInt(n, 10) - 1;
  if (isNaN(idx) || idx < 0 || idx >= s.results.length) {
    return ctx.reply(box(['Opção inválida.', 'Usa *N1* até *N' + s.results.length + '*']));
  }
  const item = s.results[idx];
  s.step = 'choose_quality';
  s.selected = item;
  saveSession(ctx, s);

  const lines = [
    '✅ *Selecionado*',
    (item.type === 'serie' ? '📺' : '🎥') + ' *' + item.title + '*',
    '🌐 ' + item.source,
    '🔗 ' + item.link,
    '',
    '*Qualidade (digita F1–F4):*'
  ];
  for (let i = 0; i < QUALITIES.length; i++) lines.push(QUALITIES[i].label);
  lines.push('');
  lines.push('Ex: *F3*');
  lines.push('Ou: *dwfilme* + link');
  return ctx.reply(box(lines));
}

async function cmdQuality(ctx, code) {
  const s = loadSession(ctx);
  if (!s || s.step !== 'choose_quality' || !s.selected) {
    return false;
  }
  const raw = String(code || '').trim().toUpperCase();
  let quality = null;
  for (let i = 0; i < QUALITIES.length; i++) {
    if (QUALITIES[i].id === raw) {
      quality = QUALITIES[i];
      break;
    }
  }
  if (!quality && /^F?[1-4]$/.test(raw)) {
    const n = parseInt(raw.replace('F', ''), 10) - 1;
    if (n >= 0 && n < QUALITIES.length) quality = QUALITIES[n];
  }
  if (!quality) {
    await ctx.reply(box(['Opção inválida.', 'Usa *F1*, *F2*, *F3* ou *F4*.']));
    return true;
  }

  const item = s.selected;
  const acq = dq.tryAcquire ? dq.tryAcquire(ctx, 'filme') : { ok: true };
  if (acq && acq.ok === false) {
    await ctx.reply(acq.reason || 'Download bloqueado/ocupado.');
    return true;
  }

  await ctx.reply(
    box([
      '⏳ A baixar ficheiro...',
      '🎞️ ' + quality.label,
      '🎬 ' + item.title,
      'Cancelar: *cancelardwd*'
    ])
  );

  let filePath = null;
  try {
    if (dq.isCancelled && dq.isCancelled()) throw new Error('CANCELLED');
    const destPattern = path.join(TMP_DIR, 'filme_' + Date.now() + '.%(ext)s');
    await runYtdlp(
      [
        '--no-warnings',
        '-f',
        quality.format,
        '-o',
        destPattern,
        '--merge-output-format',
        'mp4',
        '--no-playlist',
        item.link
      ],
      300000
    );
    const files = fs.readdirSync(TMP_DIR).filter(function (f) {
      return f.indexOf('filme_') === 0;
    });
    let best = null;
    let bestT = 0;
    for (const f of files) {
      const full = path.join(TMP_DIR, f);
      try {
        const st = fs.statSync(full);
        if (st.size > 1000 && st.mtimeMs > bestT) {
          bestT = st.mtimeMs;
          best = full;
        }
      } catch (_) {}
    }
    if (!best) throw new Error('Sem ficheiro (yt-dlp)');

    filePath = best;
    const buf = fs.readFileSync(best);
    const ext = path.extname(best) || '.mp4';
    const name =
      String(item.title)
        .replace(/[^\w\s\-à-úÀ-Ú]/gi, '')
        .slice(0, 50)
        .trim()
        .replace(/\s+/g, '_') + ext;

    await ctx.sock.sendMessage(
      ctx.jid,
      {
        document: buf,
        fileName: name,
        mimetype: ext === '.mp4' ? 'video/mp4' : 'application/octet-stream',
        caption: box([
          '✅ Download pronto',
          '🎬 *' + item.title + '*',
          '🎞️ ' + quality.label,
          '📁 ' + name
        ])
      },
      { quoted: ctx.msg }
    );
  } catch (e) {
    if (String(e.message) === 'CANCELLED') {
      await ctx.reply(box(['🛑 Download cancelado.']));
    } else {
      console.error('[filme dl]', e.message);
      await ctx.reply(
        box([
          '❌ Não foi possível baixar o ficheiro.',
          String(e.message || e).slice(0, 100),
          '',
          'O site pode bloquear o yt-dlp.',
          'Link: ' + item.link
        ])
      );
    }
  } finally {
    if (dq.release) dq.release();
    if (filePath) {
      try {
        fs.unlinkSync(filePath);
      } catch (_) {}
    }
    s.step = 'choose_result';
    s.selected = null;
    saveSession(ctx, s);
  }
  return true;
}

async function cmdDwLink(ctx, arg) {
  const link = String(arg || '').trim().split(/\s+/)[0];
  if (!/^https?:\/\//i.test(link)) {
    return ctx.reply(box(['Uso: *dwfilme* <link>', 'Ex: *dwfilme https://filmeseriesonline.net/filme/...*']));
  }
  saveSession(ctx, {
    step: 'choose_quality',
    selected: { title: 'Download', link: link, type: 'filme', source: 'link' },
    results: []
  });
  const lines = ['⬇️ *Link recebido*', '🔗 ' + link.slice(0, 60), '', '*Qualidade:*'];
  for (let i = 0; i < QUALITIES.length; i++) lines.push(QUALITIES[i].label);
  lines.push('', 'Ex: *F3*');
  return ctx.reply(box(lines));
}

module.exports = [
  {
    name: 'filme',
    aliases: ['filmes', 'movie', 'movies'],
    category: 'utilidades',
    description: 'Pesquisar filme (Pobreflix)',
    handler: async function (ctx) {
      const q = (ctx.args && ctx.args.join(' ')) || '';
      if (!q.trim()) return ctx.reply(box(['Uso: *filme <nome>*', 'Ex: *filme Vingadores Ultimato*']));
      return cmdSearch(ctx, q.trim(), 'filme');
    }
  },
  {
    name: 'serie',
    aliases: ['series', 'série', 'tvshow'],
    category: 'utilidades',
    description: 'Pesquisar série (Pobreflix)',
    handler: async function (ctx) {
      const q = (ctx.args && ctx.args.join(' ')) || '';
      if (!q.trim()) return ctx.reply(box(['Uso: *serie <nome>*', 'Ex: *serie Stranger Things*']));
      return cmdSearch(ctx, q.trim(), 'serie');
    }
  },
  {
    name: 'fs',
    aliases: ['filmeserie', 'buscarfilme'],
    category: 'utilidades',
    description: 'Pesquisar filme ou série',
    handler: async function (ctx) {
      const q = (ctx.args && ctx.args.join(' ')) || '';
      if (!q.trim()) return ctx.reply(box(['Uso: *fs <nome>*', 'Ex: *fs Breaking Bad*']));
      return cmdSearch(ctx, q.trim(), null);
    }
  },
  {
    name: 'dwfilme',
    aliases: ['dlfilme', 'baixarfilme'],
    category: 'utilidades',
    description: 'Download filme/série por link',
    handler: async function (ctx) {
      const q = (ctx.args && ctx.args.join(' ')) || '';
      return cmdDwLink(ctx, q);
    }
  },
  {
    name: 'n1',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N1',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 1);
    }
  },
  {
    name: 'n2',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N2',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 2);
    }
  },
  {
    name: 'n3',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N3',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 3);
    }
  },
  {
    name: 'n4',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N4',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 4);
    }
  },
  {
    name: 'n5',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N5',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 5);
    }
  },
  {
    name: 'n6',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N6',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 6);
    }
  },
  {
    name: 'n7',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N7',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 7);
    }
  },
  {
    name: 'n8',
    aliases: [],
    category: 'utilidades',
    description: 'Escolher resultado N8',
    handler: async function (ctx) {
      return cmdPickResult(ctx, 8);
    }
  },
  {
    name: 'f1',
    aliases: [],
    category: 'utilidades',
    description: 'Qualidade filme F1',
    handler: async function (ctx) {
      const s = loadSession(ctx);
      if (s && s.step === 'choose_quality') return cmdQuality(ctx, 'F1');
      return ctx.reply(box(['Nenhuma qualidade pendente.', 'Escolhe um título com *N1* primeiro.']));
    }
  },
  {
    name: 'f2',
