        || '';
      t = String(t || '').trim();
      if (t && /\s/.test(t)) {
        const n = normalizeCommandText(t);
        if (n && n !== t) {
          if (m.conversation != null) m.conversation = n;
          if (m.extendedTextMessage && m.extendedTextMessage.text != null) {
