/**
 * Comandos de administração de grupo
 */

const db = require('../../database');

async function requireGroupAdmin(ctx) {
  if (!ctx.isGroup) {
    await ctx.reply('❌ Apenas em grupos.');
    return false;
  }
  const isAdmin = await ctx.isGroupAdmin() || ctx.isOwner() || ctx.isBotAdmin();
  if (!isAdmin) {
    await ctx.reply('❌ Apenas administradores.');
    return false;
  }
  return true;
}

async function getTargetUser(ctx) {
  const target = ctx.getMentionedOrQuoted();
  if (!target) {
    await ctx.reply('❌ Marque ou responda a mensagem do usuário.');
    return null;
  }
  return target;
}

module.exports = [
  {
    name: 'ban',
    aliases: ['kick', 'expulsar'],
    category: 'admin',
    description: 'Remove usuário do grupo',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      try {
        await ctx.sock.groupParticipantsUpdate(ctx.jid, [target], 'remove');
        await ctx.reply('✅ Usuário removido.', { mentions: [target] });
      } catch (e) {
        await ctx.reply('❌ Não foi possível remover. Verifique se o bot é admin.');
      }
    }
  },
  {
    name: 'promover',
    aliases: ['promote', 'promove'],
