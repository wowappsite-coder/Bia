const isekaiDb = require('../../isekai/db');
const combat = require('../../isekai/combat');
const { MONSTERS, BOSSES } = require('../../isekai/monsters');
let deathMod=null; try{ deathMod=require('../../isekai/death'); }catch(_){}
let progQ=null; try{ progQ=require('../../isekai/progress'); }catch(_){}
const ecoLoot = require('../../isekai/economy');

function needChar(ctx) {
  const g = isekaiDb.scopeGroup(ctx);
  const d = isekaiDb.getPlayerData(ctx.sender, g);
  if (!d || !d.race) return { ok: false, msg: 'Cria personagem: iskiniciar Nome' };
  return { ok: true, data: d, group: g };
}
function findSkill(data, text) {
  const q = String(text || '').toLowerCase().trim();
  if (!q) return null;
  const list = data.skills || [];
  return list.find(function (s) {
    return String(s.name).toLowerCase().indexOf(q) >= 0 || String(s.id).toLowerCase() === q;
  }) || null;
}

module.exports = [
  { name: 'iskmonstros', category: 'isekai', handler: async (ctx) => {
    let t = 'MONSTROS\n\n';
    MONSTERS.forEach(function (m) { t += (m.emoji||'') + ' ' + m.name + ' Nv' + m.level + '\n'; });
    t += '\nBOSSES\n';
    BOSSES.forEach(function (b) { t += (b.emoji||'') + ' ' + b.name + ' Nv' + b.level + '\n'; });
    await ctx.reply(t);
  }},
  { name: 'isklutar', aliases: ['iskencontrar', 'iskbatalha'], category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    if (combat.getBattle(ctx.sender, n.group)) return ctx.reply('Ja em combate. iskatacar / iskusar / iskfugir');
    const b = combat.startPve(n.data, {});
    combat.setBattle(ctx.sender, n.group, b);
    await ctx.reply('COMBATE!\n' + (b.enemy.emoji||'') + ' ' + b.enemy.name + ' Nv' + b.enemy.level + '\nHP ' + b.enemy.hp + '/' + b.enemy.hpMax + '\nTeu HP ' + b.playerHp + ' Mana ' + b.playerMana + '\n\niskatacar | iskusar <hab> | iskdefender | iskfugir');
  }},
  { name: 'iskboss', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    if (combat.getBattle(ctx.sender, n.group)) return ctx.reply('Ja em combate.');
    const b = combat.startPve(n.data, { boss: true });
    combat.setBattle(ctx.sender, n.group, b);
    await ctx.reply('BOSS!\n' + (b.enemy.emoji||'') + ' ' + b.enemy.name + '\nHP ' + b.enemy.hp + '/' + b.enemy.hpMax + '\niskatacar | iskusar | iskfugir');
  }},
  { name: 'iskdungeon', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    if (combat.getBattle(ctx.sender, n.group)) return ctx.reply('Ja em combate.');
    const d = combat.startDungeon(n.data);
    combat.setBattle(ctx.sender, n.group, d.battle);
    await ctx.reply('DUNGEON Sala 1/' + d.maxRooms + '\n' + (d.battle.enemy.emoji||'') + ' ' + d.battle.enemy.name + '\nHP ' + d.battle.enemy.hp + '/' + d.battle.enemy.hpMax);
  }},
  { name: 'iskexplorar', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    if (combat.getBattle(ctx.sender, n.group)) return ctx.reply('Em combate.');
    const roll = Math.random();
    if (roll < 0.55) {
      const b = combat.startPve(n.data, {});
      combat.setBattle(ctx.sender, n.group, b);
      return ctx.reply('Exploraste e apareceu:\n' + (b.enemy.emoji||'') + ' ' + b.enemy.name + '\niskatacar | iskusar | iskfugir');
    }
    if (roll < 0.75) {
      const gain = 3 + Math.floor(Math.random() * 8);
      n.data.iene = (n.data.iene || 0) + gain;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      return ctx.reply('Achaste ' + gain + ' ienes!');
    }
    if (roll < 0.9) {
      const heal = 10 + Math.floor(Math.random() * 15);
      n.data.hp = Math.min(n.data.hpMax, n.data.hp + heal);
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      return ctx.reply('Fonte de cura +' + heal + ' HP (' + n.data.hp + '/' + n.data.hpMax + ')');
    }
    await ctx.reply('Nada de especial...');
  }},
  { name: 'iskatacar', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    const b = combat.getBattle(ctx.sender, n.group);
    if (!b) return ctx.reply('Sem combate. isklutar');
    if (b.type === 'pvp') {
      const r = combat.duelAction(b, ctx.sender, 'attack');
      if (!r.ok) return ctx.reply(r.msg);
      let msg = r.lines.join('\n');
      if (r.over) {
        combat.clearBattle(b.a.jid, b.group);
        combat.clearBattle(b.b.jid, b.group);
        msg += '\n\n' + r.winner.name + ' venceu o duelo! (PvP nao mata)';
      } else msg += '\n\n' + combat.formatDuel(b);
      return ctx.reply(msg);
    }
    const r = combat.applyPlayerAttack(b, n.data, null);
    if (!r.ok) return ctx.reply(r.msg);
    let msg = r.lines.join('\n');
    if (r.victory) {
      const rew = combat.reward(n.data, b.enemy);
        try { if(progQ){ n.data.stats=n.data.stats||{}; n.data.stats.kills=(n.data.stats.kills||0)+1; if(b.type==='boss')n.data.stats.bosses=(n.data.stats.bosses||0)+1; progQ.bumpQuest(n.data, b.type==='boss'?'boss':'kill', b.enemy&&b.enemy.id); progQ.gainXp(n.data, Math.floor((b.enemy.xp||10)/2)); progQ.unlockAch(n.data,'first_monster'); } } catch(_){}
        let lootLines = [];
        try { lootLines = ecoLoot.applyLoot(n.data, b.enemy.id); } catch (_) {}

      n.data.hp = Math.min(n.data.hpMax, b.playerHp + 5);
      n.data.mana = b.playerMana;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      msg += '\n\nVitoria! +' + rew.xp + ' XP +' + rew.iene + ' ienes';
        if (lootLines && lootLines.length) msg += '\nLoot: ' + lootLines.join(', ');
      if (rew.leveled) msg += '\nNivel ' + rew.level + '!';
    } else if (r.defeat) {
      n.data.hp = 0;
        try { if(deathMod){ deathMod.kill(n.data, (b.enemy&&b.enemy.name)||'combate'); } else { n.data.hp=1; } } catch(_){ n.data.hp=1; }
      n.data.mana = b.playerMana;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      msg += '\n\nDerrota... (HP=1)';
    }
    await ctx.reply(msg);
  }},
  { name: 'iskusar', category: 'isekai', usage: 'iskusar bola', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    const q = (ctx.text || '').trim() || ((ctx.args && ctx.args.join(' ')) || '');
    if (!q) return ctx.reply('iskusar nome_da_habilidade');
    const b = combat.getBattle(ctx.sender, n.group);
    if (!b) return ctx.reply('Sem combate.');
    if (b.type === 'pvp') {
      const r = combat.duelAction(b, ctx.sender, 'skill', q);
      if (!r.ok) return ctx.reply(r.msg);
      let msg = r.lines.join('\n');
      if (r.over) {
        combat.clearBattle(b.a.jid, b.group);
        combat.clearBattle(b.b.jid, b.group);
        msg += '\n\n' + r.winner.name + ' venceu!';
      } else msg += '\n\n' + combat.formatDuel(b);
      return ctx.reply(msg);
    }
    const sk = findSkill(n.data, q);
    if (!sk) return ctx.reply('Nao tens essa habilidade. iskhabilidades');
    const r = combat.applyPlayerAttack(b, n.data, sk);
    if (!r.ok) return ctx.reply(r.msg);
    let msg = r.lines.join('\n');
    if (r.victory) {
      const rew = combat.reward(n.data, b.enemy);
        try { if(progQ){ n.data.stats=n.data.stats||{}; n.data.stats.kills=(n.data.stats.kills||0)+1; if(b.type==='boss')n.data.stats.bosses=(n.data.stats.bosses||0)+1; progQ.bumpQuest(n.data, b.type==='boss'?'boss':'kill', b.enemy&&b.enemy.id); progQ.gainXp(n.data, Math.floor((b.enemy.xp||10)/2)); progQ.unlockAch(n.data,'first_monster'); } } catch(_){}
        let lootLines = [];
        try { lootLines = ecoLoot.applyLoot(n.data, b.enemy.id); } catch (_) {}

      n.data.hp = Math.min(n.data.hpMax, b.playerHp + 5);
      n.data.mana = b.playerMana;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      msg += '\n\nVitoria! +' + rew.xp + ' XP +' + rew.iene + ' ienes';
        if (lootLines && lootLines.length) msg += '\nLoot: ' + lootLines.join(', ');
      if (rew.leveled) msg += '\nNivel ' + rew.level;
    } else if (r.defeat) {
      n.data.hp = 0;
        try { if(deathMod){ deathMod.kill(n.data, (b.enemy&&b.enemy.name)||'combate'); } else { n.data.hp=1; } } catch(_){ n.data.hp=1; }
      n.data.mana = b.playerMana;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      msg += '\n\nDerrota...';
    }
    await ctx.reply(msg);
  }},
  { name: 'iskdefender', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    const b = combat.getBattle(ctx.sender, n.group);
    if (!b) return ctx.reply('Sem combate.');
    if (b.type === 'pvp') {
      const r = combat.duelAction(b, ctx.sender, 'defend');
      if (!r.ok) return ctx.reply(r.msg);
      return ctx.reply(r.lines.join('\n') + '\n\n' + combat.formatDuel(b));
    }
    b.defending = true;
    let edmg = Math.max(1, (b.enemy.atk || 10) - Math.floor((n.data.attrs.defesa || 10) * 0.3));
    edmg = Math.max(1, Math.floor(edmg * 0.5));
    b.playerHp = Math.max(0, b.playerHp - edmg);
    b.defending = false;
    let msg = 'Defendes!\n' + b.enemy.name + ' bateu ' + edmg + ' (reduzido)\nHP ' + b.playerHp;
    if (b.playerHp <= 0) {
      n.data.hp = 1;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      msg += '\nDerrota...';
    }
    await ctx.reply(msg);
  }},
  { name: 'iskfugir', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    const b = combat.getBattle(ctx.sender, n.group);
    if (!b) return ctx.reply('Sem combate.');
    if (b.type === 'pvp') return ctx.reply('Nao podes fugir de duelo.');
    const f = combat.tryFlee(b, n.data);
    if (f.ok) {
      n.data.hp = b.playerHp;
      n.data.mana = b.playerMana;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      return ctx.reply('Fugiste! (chance ' + f.chance + '%)');
    }
    const edmg = Math.max(1, (b.enemy.atk || 8) - Math.floor((n.data.attrs.defesa || 8) * 0.2));
    b.playerHp = Math.max(0, b.playerHp - edmg);
    let msg = 'Falhou a fuga (' + f.chance + '%)!\n' + b.enemy.name + ' bateu ' + edmg + '\nHP ' + b.playerHp;
    if (b.playerHp <= 0) {
      n.data.hp = 1;
      isekaiDb.savePlayerData(ctx.sender, n.group, n.data);
      combat.clearBattle(ctx.sender, n.group);
      msg += '\nDerrota...';
    }
    await ctx.reply(msg);
  }},
  { name: 'iskduelo', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    if (combat.getBattle(ctx.sender, n.group)) return ctx.reply('Ja em combate.');
    let target = null;
    try {
      if (ctx.mentioned && ctx.mentioned[0]) target = ctx.mentioned[0];
      else if (ctx.msg && ctx.msg.message && ctx.msg.message.extendedTextMessage) {
        const ci = ctx.msg.message.extendedTextMessage.contextInfo;
        if (ci && ci.mentionedJid && ci.mentionedJid[0]) target = ci.mentionedJid[0];
      }
    } catch (_) {}
    if (!target) return ctx.reply('Marca alguem: iskduelo @user');
    if (target === ctx.sender) return ctx.reply('Nao podes duelar contigo.');
    const other = isekaiDb.getPlayerData(target, n.group);
    if (!other || !other.race) return ctx.reply('O alvo nao tem personagem Isekai.');
    combat.challengeDuel(ctx.sender, n.data.name, target, n.group);
    await ctx.reply('DESAFIO DE DUELO\n' + n.data.name + ' desafiou!\nAlvo: iskaceitar ou iskrecusar\n(PvP 10 HP, sem morte permanente)');
  }},
  { name: 'iskaceitar', category: 'isekai', handler: async (ctx) => {
    const n = needChar(ctx); if (!n.ok) return ctx.reply(n.msg);
    const p = combat.getPending(ctx.sender, n.group);
    if (!p) return ctx.reply('Nenhum desafio pendente.');
    const aData = isekaiDb.getPlayerData(p.from, n.group);
    if (!aData) return ctx.reply('Desafiante sem personagem.');
    combat.clearPending(ctx.sender, n.group);
    const st = combat.startDuel(aData, n.data, p.from, ctx.sender, n.group);
    await ctx.reply(combat.formatDuel(st));
  }},
  { name: 'iskrecusar', category: 'isekai', handler: async (ctx) => {
    const g = isekaiDb.scopeGroup(ctx);
    const p = combat.getPending(ctx.sender, g);
    if (!p) return ctx.reply('Nenhum desafio.');
    combat.clearPending(ctx.sender, g);
    await ctx.reply('Duelo recusado.');
  }}
];
