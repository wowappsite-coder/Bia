/**
 * Delay variavel + fila por chat (anti-spam)
 * Nao altera comandos — so controla ritmo de envio
 */
const queues = new Map(); // jid -> Promise chain
const lastSent = new Map(); // jid -> timestamp

function rand(minMs, maxMs) {
  return minMs + Math.floor(Math.random() * (maxMs - minMs + 1));
}

function sleep(ms) {
  return new Promise(function (r) { setTimeout(r, ms); });
}

/**
 * Tipo de resposta:
 *  - menu
 *  - media (image/video)
 *  - audio (audio/sticker/ptt)
 *  - mentions (varias mencoes)
 *  - simple
 */
function detectType(content, options) {
  const opts = options || {};
  const mentions = (opts.mentions || (content && content.mentions) || []).length;
  if (mentions >= 3) return 'mentions';

  if (content && typeof content === 'object') {
    if (content.image || content.video || content.document) return 'media';
    if (content.audio || content.sticker || content.ptt) return 'audio';
    if (content.text) {
      const t = String(content.text).toLowerCase();
      if (t.indexOf('menu') !== -1 || t.indexOf('comandos') !== -1 || t.indexOf('╭──') !== -1 || t.indexOf('┏━━') !== -1) {
        return 'menu';
      }
    }
  }
  if (typeof content === 'string') {
    const t = content.toLowerCase();
    if (t.indexOf('menu') !== -1 || t.indexOf('╭──') !== -1 || t.indexOf('┏━━') !== -1) return 'menu';
  }
  if (mentions >= 1 && mentions < 3) return 'simple';
  return 'simple';
}

function delayRange(type) {
  switch (type) {
    case 'media': return [2000, 3000];
    case 'audio': return [1500, 3000];
    case 'menu': return [1500, 2500];
    case 'mentions': return [3000, 5000];
    default: return [1500, 2500]; // simple
  }
}

async function showTyping(sock, jid, ms) {
  try {
    await sock.sendPresenceUpdate('composing', jid);
  } catch (_) {}
  await sleep(ms);
  try {
    await sock.sendPresenceUpdate('paused', jid);
  } catch (_) {}
}

/**
 * Enfileira envio por jid: um de cada vez, com delay variavel
 */
function enqueue(jid, task) {
  const prev = queues.get(jid) || Promise.resolve();
  const next = prev
    .then(task)
    .catch(function (e) {
      console.error('[sendDelay]', e && e.message ? e.message : e);
    });
  // evita acumular rejeicoes
  queues.set(jid, next.then(function () {}, function () {}));
  return next;
}

/**
 * Aplica delay + typing + fila antes de enviar
 * sendFn: async () => resultado do sendMessage
 */
async function withDelay(sock, jid, content, options, sendFn) {
  const type = detectType(content, options);
  const range = delayRange(type);
  const ms = rand(range[0], range[1]);

  return enqueue(jid, async function () {
    // pequeno espaco minimo entre envios do mesmo chat (anti rajada)
    const last = lastSent.get(jid) || 0;
    const gap = Date.now() - last;
    if (gap < 400) await sleep(400 - gap);

    await showTyping(sock, jid, ms);
    const result = await sendFn();
    lastSent.set(jid, Date.now());
    return result;
  });
}

module.exports = {
  withDelay,
  detectType,
  delayRange,
  rand,
  sleep
};
