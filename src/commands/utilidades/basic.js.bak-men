┃ 👑 Dono: ${config.ownerNumber}
┃ 📱 Bot: ${config.botNumber}
┃ ⏱ Uptime: ${h}h ${m}m ${s}s
┃ 💾 RAM: ${mem} MB
┃ 📦 Comandos: ${stats.totalMain}
┃ 🔗 Prefixos: ${config.prefixes.join(' ')}
┃ 📅 ${new Date().toLocaleString('pt-MZ')}
┗━━━━━━━━━━━━━━━━━━┛`;
