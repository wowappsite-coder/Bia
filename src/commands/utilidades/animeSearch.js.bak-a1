/**
 * Categoria Anime — pesquisa, Dub/Leg, lista EP, download com qualidade
 * Fontes modulares em SOURCES (facil acrescentar).
 */
const fs = require('fs');
const dq = require('../../services/downloadQueue');
const path = require('path');
const https = require('https');
const http = require('http');
const { execFile } = require('child_process');

const UA =
  'Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36';

const SESSION_DIR = path.join(__dirname, '../../../data/anime-sessions');
const TMP_DIR = path.join(__dirname, '../../../data/anime-tmp');
try { fs.mkdirSync(SESSION_DIR, { recursive: true }); } catch (_) {}
try { fs.mkdirSync(TMP_DIR, { recursive: true }); } catch (_) {}

const SOURCES = [
  {
    name: 'MeusAnimes',
    base: 'https://meusanimes.blog',
    searchUrl: (q) => 'https://meusanimes.blog/?s=' + encodeURIComponent(q)
  },
  {
    name: 'Goyabu',
    base: 'https://goyabu.io',
    searchUrl: (q) => 'https://goyabu.io/?s=' + encodeURIComponent(q)
  },
  {
    name: 'AnimesDigital',
    base: 'https://animesdigital.org',
    searchUrl: (q) => 'https://animesdigital.org/?s=' + encodeURIComponent(q)
  },
  {
    name: 'AniTube',
    base: 'https://www.anitube.zip',
    searchUrl: (q) => 'https://www.anitube.zip/?s=' + encodeURIComponent(q)
  }
];

function sessionKey(ctx) {
  const u = String(ctx.sender || '').split('@')[0];
  const g = ctx.isGroup ? String(ctx.jid) : 'pv';
  return g + '__' + u;
}
function loadSession(ctx) {
  const f = path.join(SESSION_DIR, sessionKey(ctx).replace(/[^\w.@-]/g, '_') + '.json');
  try {
    if (fs.existsSync(f)) return JSON.parse(fs.readFileSync(f, 'utf8'));
  } catch (_) {}
  return null;
}
function saveSession(ctx, data) {
  const f = path.join(SESSION_DIR, sessionKey(ctx).replace(/[^\w.@-]/g, '_') + '.json');
  data.updatedAt = Date.now();
  fs.writeFileSync(f, JSON.stringify(data, null, 0));
}
function clearSession(ctx) {
  const f = path.join(SESSION_DIR, sessionKey(ctx).replace(/[^\w.@-]/g, '_') + '.json');
  try { fs.unlinkSync(f); } catch (_) {}
}

function httpGet(url, timeoutMs) {
  return new Promise(function (resolve, reject) {
    let u;
    try { u = new URL(url); } catch (e) { return reject(e); }
    const lib = u.protocol === 'http:' ? http : https;
    const req = lib.get(
      {
        hostname: u.hostname,
        path: u.pathname + u.search,
        protocol: u.protocol,
        headers: {
          'User-Agent': UA,
          Accept: 'text/html,application/xhtml+xml',
          'Accept-Language': 'pt-BR,pt;q=0.9'
        },
        timeout: timeoutMs || 15000
      },
      function (res) {
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          const next = res.headers.location.startsWith('http')
            ? res.headers.location
            : u.protocol + '//' + u.hostname + res.headers.location;
          res.resume();
          return httpGet(next, timeoutMs).then(resolve, reject);
        }
        const chunks = [];
        res.on('data', function (c) {
          chunks.push(c);
          if (Buffer.concat(chunks).length > 1200000) req.destroy();
        });
        res.on('end', function () {
          resolve({ status: res.statusCode || 0, body: Buffer.concat(chunks).toString('utf8') });
        });
      }
    );
    req.on('error', reject);
    req.on('timeout', function () { req.destroy(); reject(new Error('timeout')); });
  });
}

function httpDownload(url, dest, timeoutMs) {
  return new Promise(function (resolve, reject) {
    let u;
    try { u = new URL(url); } catch (e) { return reject(e); }
    const lib = u.protocol === 'http:' ? http : https;
    const file = fs.createWriteStream(dest);
    const req = lib.get(
      {
        hostname: u.hostname,
        path: u.pathname + u.search,
        protocol: u.protocol,
        headers: { 'User-Agent': UA, Referer: u.origin + '/' },
        timeout: timeoutMs || 120000
      },
      function (res) {
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          file.close();
          try { fs.unlinkSync(dest); } catch (_) {}
          const next = res.headers.location.startsWith('http')
            ? res.headers.location
            : u.protocol + '//' + u.hostname + res.headers.location;
          res.resume();
          return httpDownload(next, dest, timeoutMs).then(resolve, reject);
        }
        if (res.statusCode < 200 || res.statusCode >= 300) {
          file.close();
          try { fs.unlinkSync(dest); } catch (_) {}
          return reject(new Error('HTTP ' + res.statusCode));
        }
        res.pipe(file);
        file.on('finish', function () {
          file.close(function () { resolve(dest); });
        });
      }
    );
    req.on('error', function (e) {
      try { file.close(); fs.unlinkSync(dest); } catch (_) {}
      reject(e);
    });
    req.on('timeout', function () {
      req.destroy();
      try { file.close(); fs.unlinkSync(dest); } catch (_) {}
      reject(new Error('timeout download'));
    });
  });
}

function stripTags(html) {
  return String(html || '')
    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function absUrl(base, href) {
  if (!href) return '';
  if (/^https?:\/\//i.test(href)) return href.split('#')[0];
  if (href.startsWith('//')) return 'https:' + href.split('#')[0];
  try { return new URL(href, base).href.split('#')[0]; } catch (_) { return ''; }
}

function detectDub(text) {
  const t = String(text || '').toLowerCase();
  if (/dublad|dub\b|pt-br/.test(t)) return 'dub';
  if (/legendad|\bleg\b|subtit/.test(t)) return 'leg';
  return '';
}

function parseSearch(html, source, query) {
  const out = [];
  const seen = {};
  const qWords = String(query).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').split(/\s+/).filter((w) => w.length > 2);
  const re = /<a[^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
  let m;
  while ((m = re.exec(html)) && out.length < 10) {
    const href = m[1];
    if (!href || href.startsWith('#') || /javascript:/i.test(href)) continue;
    if (/\/(tag|categoria|category|author|wp-|page|login|contato)\//i.test(href)) continue;
    const link = absUrl(source.base, href);
    if (!link || seen[link]) continue;
    try {
      const host = new URL(source.base).hostname.replace(/^www\./, '');
      if (new URL(link).hostname.replace(/^www\./, '').indexOf(host.split('.').slice(-2).join('.')) < 0) continue;
      if (new URL(link).pathname === '/') continue;
    } catch (_) { continue; }
    const title = stripTags(m[2]).slice(0, 100);
    if (!title || title.length < 3) continue;
    const tNorm = title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    let hit = 0;
    for (let i = 0; i < qWords.length; i++) if (tNorm.indexOf(qWords[i]) >= 0) hit++;
    if (qWords.length && hit === 0) continue;
    seen[link] = true;
    const kind = detectDub(title);
    out.push({ title, link, source: source.name, kind });
  }
  return out.slice(0, 5);
}

async function searchAll(query) {
  const bags = await Promise.all(
    SOURCES.map(async (src) => {
      try {
        const res = await httpGet(src.searchUrl(query), 12000);
        if (!res || res.status >= 400 || !res.body) return [];
        return parseSearch(res.body, src, query);
      } catch (e) {
        console.error('[anime]', src.name, e.message);
        return [];
      }
    })
  );
  const seen = {};
  const all = [];
  for (const list of bags) {
    for (const r of list) {
      const k = (r.link || r.title).toLowerCase();
      if (seen[k]) continue;
      seen[k] = true;
      all.push(r);
    }
  }
  return all;
}

/** Extrai lista de episodios da pagina do anime */
function parseEpisodes(html, base) {
  const eps = [];
  const seen = {};
  const re = /<a[^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
  let m;
  while ((m = re.exec(html)) && eps.length < 500) {
    const title = stripTags(m[2]);
    const link = absUrl(base, m[1]);
    if (!link || seen[link]) continue;
    const epMatch =
      title.match(/(?:epis[oó]dio|ep\.?)\s*(\d{1,4})/i) ||
      link.match(/(?:episodio|episode|ep)[_-]?(\d{1,4})/i);
    if (!epMatch) continue;
    const num = parseInt(epMatch[1], 10);
    if (!num || num > 5000) continue;
    seen[link] = true;
    eps.push({
      num,
      title: title.slice(0, 80) || ('Episodio ' + num),
      link,
      kind: detectDub(title + ' ' + link)
    });
  }
  eps.sort((a, b) => a.num - b.num);
  // unique by num (first wins)
  const byNum = {};
  const uniq = [];
  for (const e of eps) {
    if (byNum[e.num]) continue;
    byNum[e.num] = true;
    uniq.push(e);
  }
  return uniq;
}

async function loadEpisodes(animeUrl, sourceName) {
  const src = SOURCES.find((s) => s.name === sourceName) || { base: animeUrl };
  const res = await httpGet(animeUrl, 15000);
  if (!res || !res.body) return [];
  return parseEpisodes(res.body, src.base || animeUrl);
}

/** Qualidades a partir de pagina do EP / players comuns */
function parseQualities(html) {
  const found = [];
  const body = String(html || '');
  const pairs = [
    { id: '360p', re: /\b360p\b/i },
    { id: '480p', re: /\b480p\b|\b460p\b/i },
    { id: '720p', re: /\b720p\b/i },
    { id: '1080p', re: /\b1080p\b|\bHD\b/i }
  ];
  // links de video diretos
  const videoRe = /https?:\/\/[^\s"'<>]+?\.(?:mp4|m3u8)(?:\?[^\s"'<>]*)?/gi;
  const videos = body.match(videoRe) || [];
  const labelRe = /(?:label|quality|res|tamanho)["'\s:=]+([0-9]{3,4}p|HD)/gi;
  let lm;
  const labels = [];
  while ((lm = labelRe.exec(body))) labels.push(lm[1]);

  for (const p of pairs) {
    const hasLabel = p.re.test(body) || labels.some((x) => p.re.test(x));
    let url = '';
    for (const v of videos) {
      if (p.re.test(v)) {
        url = v;
        break;
      }
    }
    if (!url && hasLabel && videos.length) {
      // associa por ordem aproximada
      url = '';
    }
    if (hasLabel || url) {
      found.push({ id: p.id, label: p.id === '1080p' ? 'HD / 1080p' : p.id, url: url || '' });
    }
  }
  // se so ha links sem label, oferece generico
  if (!found.length && videos.length) {
    found.push({ id: 'default', label: 'Disponivel', url: videos[0] });
  }
  // dedupe
  const seen = {};
  return found.filter((q) => {
    if (seen[q.id]) return false;
    seen[q.id] = true;
    return true;
  });
}

function zipFiles(files, zipPath) {
  return new Promise(function (resolve, reject) {
    // usa zip do sistema se existir
    const args = ['-j', '-q', zipPath].concat(files);
    execFile('zip', args, { timeout: 180000 }, function (err) {
      if (err) return reject(err);
      resolve(zipPath);
    });
  });
}

function boxAnime(lines) {
  let t = '╭━━━〔 🎌 ANIME 〕━━━╮\n';
  for (let i = 0; i < lines.length; i++) t += '┃ ' + lines[i] + '\n';
  t += '╰━━━━━━━━━━━━━━━━━━╯';
  return t;
}

async function cmdSearch(ctx, query) {
  const results = await searchAll(query);
  if (!results.length) {
    return ctx.reply(
      boxAnime(['❌ Nenhum resultado para:', '*' + query + '*', '', 'Tenta outro nome.'])
    );
  }
  // escolhe o primeiro e analisa dub/leg disponiveis no conjunto
  const primary = results[0];
  let hasDub = results.some((r) => r.kind === 'dub');
  let hasLeg = results.some((r) => r.kind === 'leg');
  // se nao detectou, assume ambos possiveis ate carregar eps
  if (!hasDub && !hasLeg) {
    hasDub = true;
    hasLeg = true;
  }

  saveSession(ctx, {
    step: 'choose_lang',
    query,
    anime: primary,
    all: results.slice(0, 5),
    hasDub,
    hasLeg,
    episodes: [],
    mode: null
  });

  const lines = [
    '✅ *Anime encontrado*',
    '🎬 *' + primary.title + '*',
    '🌐 Fonte: ' + primary.source,
    '',
    hasDub ? '1️⃣ Dublado ✅' : '1️⃣ Dublado ❌',
    hasLeg ? '2️⃣ Legendado ✅' : '2️⃣ Legendado ❌',
    '',
    'Digite: *dub* ou *leg*',
    '(ou *1* / *2*)'
  ];
  return ctx.reply(boxAnime(lines));
}

async function cmdLang(ctx, mode) {
  const s = loadSession(ctx);
  if (!s || s.step !== 'choose_lang') {
    return ctx.reply(
      boxAnime(['Usa primeiro:', '*j <nome do anime>*', 'Ex: *j Solo Leveling*'])
    );
  }
  if (mode === 'dub' && s.hasDub === false) {
    return ctx.reply(boxAnime(['❌ Dublado indisponivel.', 'Tenta *leg*.']));
  }
  if (mode === 'leg' && s.hasLeg === false) {
    return ctx.reply(boxAnime(['❌ Legendado indisponivel.', 'Tenta *dub*.']));
  }

  await ctx.reply(boxAnime(['⏳ A carregar episodios...', '🎬 ' + s.anime.title]));

  let eps = [];
  try {
    eps = await loadEpisodes(s.anime.link, s.anime.source);
  } catch (e) {
    console.error('[anime eps]', e.message);
  }
  // filtra por modo se houver marca
  if (mode === 'dub') {
    const f = eps.filter((e) => e.kind === 'dub' || !e.kind);
    if (f.length) eps = f;
  } else if (mode === 'leg') {
    const f = eps.filter((e) => e.kind === 'leg' || !e.kind);
    if (f.length) eps = f;
  }

  if (!eps.length) {
    // fallback: so o link da pagina
    eps = [{ num: 1, title: s.anime.title, link: s.anime.link, kind: mode }];
  }

  s.step = 'episodes';
  s.mode = mode;
  s.episodes = eps;
  saveSession(ctx, s);

  const maxShow = Math.min(eps.length, 30);
  let list = '';
  for (let i = 0; i < maxShow; i++) {
    list += '┃ EP ' + eps[i].num + ' — ' + eps[i].link + '\n';
  }
  if (eps.length > maxShow) {
    list += '┃ ... +' + (eps.length - maxShow) + ' episodios\n';
  }

  let t =
    '╭━━━〔 🎌 ANIME 〕━━━╮\n' +
    '┃ 🎬 *' + s.anime.title + '*\n' +
    '┃ 🎙️ ' + (mode === 'dub' ? 'Dublado' : 'Legendado') + '\n' +
    '┃ 📺 EPs: *' + eps.length + '*\n' +
    '┃\n' +
    list +
    '┃\n' +
    '┃ 💡 *Download:*\n' +
    '┃ *dwdanimeep 1*\n' +
    '┃ *dwdanimeep 1-5*\n' +
    '┃ ou *dwdanimeep* + link\n' +
    '╰━━━━━━━━━━━━━━━━━━╯';
  return ctx.reply(t);
}

function parseEpRange(arg) {
  const a = String(arg || '').trim();
  if (/^\d+$/.test(a)) return [parseInt(a, 10)];
  const m = a.match(/^(\d+)\s*[-/]\s*(\d+)$/);
  if (m) {
    let a1 = parseInt(m[1], 10);
    let a2 = parseInt(m[2], 10);
    if (a1 > a2) { const t = a1; a1 = a2; a2 = t; }
    const out = [];
    for (let i = a1; i <= a2 && out.length < 20; i++) out.push(i);
    return out;
  }
  return [];
}

async function cmdDownloadStart(ctx, arg) {
  const s = loadSession(ctx);
  let epNums = parseEpRange(arg);
  let targets = [];

  // link direto?
  if (/https?:\/\//i.test(arg)) {
    targets = [{ num: 0, title: 'Link', link: arg.trim() }];
  } else if (s && s.episodes && s.episodes.length && epNums.length) {
    targets = s.episodes.filter((e) => epNums.indexOf(e.num) >= 0);
  } else if (s && s.episodes && epNums.length === 0 && /^\d/.test(arg)) {
    return ctx.reply(boxAnime(['Uso: *dwdanimeep 1*', 'ou *dwdanimeep 1-3*', 'ou *dwdanimeep* + link']));
  }

  if (!targets.length) {
    return ctx.reply(
      boxAnime([
        '❌ Episodio nao encontrado na sessao.',
        '1) *j <anime>*',
        '2) *dub* ou *leg*',
        '3) *dwdanimeep 1*'
      ])
    );
  }

  // carrega qualidades do primeiro EP
  let qualities = [];
  try {
    const page = await httpGet(targets[0].link, 15000);
    qualities = parseQualities(page.body || '');
  } catch (e) {
    console.error('[anime q]', e.message);
  }
  if (!qualities.length) {
    qualities = [
      { id: '360p', label: '360p', url: '' },
      { id: '480p', label: '480p', url: '' },
      { id: '720p', label: '720p', url: '' },
      { id: '1080p', label: 'HD', url: '' }
    ];
  }

  const sess = s || { anime: { title: 'Anime' }, mode: '' };
  sess.step = 'choose_quality';
  sess.downloadTargets = targets;
  sess.qualities = qualities;
  saveSession(ctx, sess);

  const lines = [
    '⬇️ *Download*',
    '🎬 ' + (sess.anime && sess.anime.title ? sess.anime.title : 'Anime'),
    '📺 EP: ' + targets.map((t) => t.num || '?').join(', '),
    '',
    '*Qualidade disponivel:*'
  ];
  for (let i = 0; i < qualities.length; i++) {
    lines.push((i + 1) + '️⃣ ' + qualities[i].label);
  }
  lines.push('');
  lines.push('Digite o *numero* da opcao');
  lines.push('Ex: *1*');
  return ctx.reply(boxAnime(lines));
}

async function cmdQualityPick(ctx, n) {
  const s = loadSession(ctx);
  if (!s || s.step !== 'choose_quality' || !s.qualities || !s.downloadTargets) {
    return false; // nao era escolha de qualidade
  }
  const idx = parseInt(n, 10) - 1;
  if (idx < 0 || idx >= s.qualities.length) {
    await ctx.reply(boxAnime(['Opcao invalida.', 'Escolhe 1 a ' + s.qualities.length]));
    return true;
  }
  const quality = s.qualities[idx];
  const targets = s.downloadTargets.slice(0, 10);

  await ctx.reply(
    boxAnime([
      '⏳ A preparar download...',
      '🎞️ ' + quality.label,
      '📦 ' + targets.length + ' ficheiro(s)',
      'Pode demorar.'
    ])
  );

  const files = [];
  for (let i = 0; i < targets.length; i++) {
    const ep = targets[i];
    try {
      if (dq.isCancelled && dq.isCancelled()) {
        throw new Error('CANCELLED');
      }
      let videoUrl = quality.url;
      if (!videoUrl) {
        const page = await httpGet(ep.link, 15000);
        const qs = parseQualities(page.body || '');
        const match = qs.find((q) => q.id === quality.id && q.url) || qs.find((q) => q.url);
        videoUrl = match && match.url;
        // ultimo recurso: primeiro mp4/m3u8 na pagina
        if (!videoUrl && page.body) {
          const m = page.body.match(/https?:\/\/[^\s"'<>]+?\.(?:mp4)(?:\?[^\s"'<>]*)?/i);
          if (m) videoUrl = m[0];
        }
      }
      if (!videoUrl) {
        console.error('[anime] sem url ep', ep.num);
        continue;
      }
      if (/\.m3u8(\?|$)/i.test(videoUrl)) {
        // m3u8 nao zipamos direto — avisa
        continue;
      }
      const dest = path.join(
        TMP_DIR,
        'ep' + (ep.num || i + 1) + '_' + Date.now() + '.mp4'
      );
      await httpDownload(videoUrl, dest, 180000);
      const st = fs.statSync(dest);
      if (st.size > 80 * 1024 * 1024) {
        // grande demais para WA — envia so e apaga depois
      }
      if (st.size > 100) files.push(dest);
    } catch (e) {
      console.error('[anime dl ep]', ep.num, e.message);
    }
  }

  if (!files.length) {
    s.step = 'episodes';
    saveSession(ctx, s);
    await ctx.reply(
      boxAnime([
        '❌ Nao consegui baixar o video.',
        'O site pode bloquear ou so ter stream.',
        'Abre o link do EP no navegador.'
      ])
    );
    return true;
  }

  try {
    if (files.length === 1) {
      const buf = fs.readFileSync(files[0]);
      const name =
        (s.anime && s.anime.title ? s.anime.title : 'anime')
          .replace(/[^\w\s-]/g, '')
          .slice(0, 40) +
        '_EP' +
        (targets[0].num || '') +
        '.mp4';
      await ctx.sock.sendMessage(
        ctx.jid,
        {
          document: buf,
          fileName: name,
          mimetype: 'video/mp4',
          caption:
            '╭━━━〔 🎌 ANIME 〕━━━╮\n' +
            '┃ ✅ Download pronto\n' +
            '┃ 🎞️ ' +
            quality.label +
            '\n' +
            '╰━━━━━━━━━━━━━━━━━━╯'
        },
        { quoted: ctx.msg }
      );
    } else {
      const zipPath = path.join(TMP_DIR, 'anime_' + Date.now() + '.zip');
      try {
        await zipFiles(files, zipPath);
        const buf = fs.readFileSync(zipPath);
        await ctx.sock.sendMessage(
          ctx.jid,
          {
            document: buf,
            fileName: 'anime_eps.zip',
            mimetype: 'application/zip',
            caption:
              '╭━━━〔 🎌 ANIME 〕━━━╮\n' +
              '┃ ✅ *' +
              files.length +
              '* EPs em ZIP\n' +
              '┃ 🎞️ ' +
              quality.label +
              '\n' +
              '╰━━━━━━━━━━━━━━━━━━╯'
          },
          { quoted: ctx.msg }
        );
        try { fs.unlinkSync(zipPath); } catch (_) {}
      } catch (e) {
        // zip falhou — envia 1 a 1
        for (const f of files.slice(0, 3)) {
          const buf = fs.readFileSync(f);
          await ctx.sock.sendMessage(
            ctx.jid,
            { document: buf, fileName: path.basename(f), mimetype: 'video/mp4' },
            { quoted: ctx.msg }
          );
        }
      }
    }
  } finally {
    for (const f of files) {
      try { fs.unlinkSync(f); } catch (_) {}
    }
  }

  s.step = 'episodes';
  s.downloadTargets = null;
  s.qualities = null;
  saveSession(ctx, s);
  return true;
}

module.exports = [
  {
    name: 'j',
    aliases: ['anime', 'buscaranime', 'panime'],
    category: 'utilidades',
    description: 'Pesquisa anime (categoria download)',
    handler: async (ctx) => {
      const query = (ctx.args || []).join(' ').trim();
      if (!query) {
        return ctx.reply(
          boxAnime([
            'Uso: *j <nome>*',
            'Ex: *j Solo Leveling*',
            '',
            'Depois: *dub* / *leg*',
            'Download: *dwdanimeep 1*'
          ])
        );
      }
      try {
        await ctx.reply(boxAnime(['🔎 A pesquisar...', '*' + query + '*']));
      } catch (_) {}
      return cmdSearch(ctx, query);
    }
  },
  {
    name: 'dub',
    aliases: ['dublado'],
    category: 'utilidades',
    description: 'Anime dublado (sessao)',
    handler: async (ctx) => cmdLang(ctx, 'dub')
  },
  {
    name: 'leg',
    aliases: ['legendado', 'legenda'],
    category: 'utilidades',
    description: 'Anime legendado (sessao)',
    handler: async (ctx) => cmdLang(ctx, 'leg')
  },
  {
    name: 'dwdanimeep',
    aliases: ['downloadanime', 'baixaranime', 'dwanime', 'dwdanime'],
    category: 'utilidades',
    description: 'Download episodio anime',
    handler: async (ctx) => {
      const arg = (ctx.args || []).join(' ').trim();
      if (!arg) {
        return ctx.reply(
          boxAnime([
            'Uso:',
            '*dwdanimeep 1*',
            '*dwdanimeep 1-3*',
            '*dwdanimeep* + link',
            '',
            'Antes: *j anime* → *dub*/*leg*'
          ])
        );
      }
      return cmdDownloadStart(ctx, arg);
    }
  },
  {
    // escolha de qualidade 1-4 quando sessao ativa
    name: 'animeq',
    aliases: [],
    category: 'utilidades',
    description: 'interno qualidade anime',
    handler: async (ctx) => {
      return ctx.reply(boxAnime(['Usa o numero 1-4 apos dwdanimeep.']));
    }
  }
];

// Interceptar respostas numericas 1/2 na sessao via comandos curtos
module.exports.push(
  {
    name: '1',
    aliases: [],
    category: 'utilidades',
    description: 'Opcao 1 anime',
    handler: async (ctx) => {
      const s = loadSession(ctx);
      if (s && s.step === 'choose_lang') return cmdLang(ctx, 'dub');
      if (s && s.step === 'choose_quality') return cmdQualityPick(ctx, '1');
      return ctx.reply(boxAnime(['Nenhuma escolha anime pendente.', 'Usa *j <nome>*']));
    }
  },
  {
    name: '2',
    aliases: [],
    category: 'utilidades',
    description: 'Opcao 2 anime',
    handler: async (ctx) => {
      const s = loadSession(ctx);
      if (s && s.step === 'choose_lang') return cmdLang(ctx, 'leg');
      if (s && s.step === 'choose_quality') return cmdQualityPick(ctx, '2');
      return ctx.reply(boxAnime(['Nenhuma escolha anime pendente.']));
    }
  },
  {
    name: '3',
    aliases: [],
    category: 'utilidades',
    description: 'Opcao 3 qualidade',
    handler: async (ctx) => {
      const s = loadSession(ctx);
      if (s && s.step === 'choose_quality') return cmdQualityPick(ctx, '3');
      return ctx.reply(boxAnime(['Nenhuma escolha de qualidade.']));
    }
  },
  {
    name: '4',
    aliases: [],
    category: 'utilidades',
    description: 'Opcao 4 qualidade',
    handler: async (ctx) => {
      const s = loadSession(ctx);
      if (s && s.step === 'choose_quality') return cmdQualityPick(ctx, '4');
      return ctx.reply(boxAnime(['Nenhuma escolha de qualidade.']));
