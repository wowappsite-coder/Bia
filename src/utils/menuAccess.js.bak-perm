function pick(arr) {
  return arr[Math.floor(Math.random() * arr.length)];
}

async function isOwner(ctx) {
  try {
    if (typeof ctx.isOwner === 'function' && ctx.isOwner()) return true;
  } catch (e) {}
  try {
    if (ctx.senderIsOwner === true) return true;
  } catch (e) {}
  return false;
}

async function isAdmin(ctx) {
  try {
    if (typeof ctx.isGroupAdmin === 'function' && await ctx.isGroupAdmin()) return true;
  } catch (e) {}
  try {
    if (typeof ctx.isAdmin === 'function' && await ctx.isAdmin()) return true;
  } catch (e) {}
  try {
    if (ctx.senderIsAdmin === true) return true;
  } catch (e) {}
  return false;
}

function mentionUser(ctx) {
  try {
    const jid = ctx.sender || ctx.participant || ctx.from || '';
    if (jid) return { text: '@' + String(jid).split('@')[0], jid: String(jid) };
  } catch (e) {}
  return { text: '@usuario', jid: null };
}

function formatBox(msg, userText, nivel) {
  return (
    '╭━━━〔 🚫 ACESSO NEGADO 〕━━━╮\n' +
    '┃\n' +
    '┃ 👤 Usuário: ' + userText + '\n' +
    '┃ 🔒 Nível: ' + nivel + '\n' +
    '┃\n' +
    '┃ ' + String(msg).replace(/\n/g, '\n┃ ') + '\n' +
    '┃\n' +
    '┃ ❌ Você não possui permissão\n' +
    '┃ para usar este comando.\n' +
    '┃\n' +
    '╰━━━━━━━━━━━━━━━━━━━━╯\n' +
    '🤖 BEATRIZ • Sistema de Segurança'
  );
}

async function sendDenied(ctx, text) {
  const m = mentionUser(ctx);
  const finalText = text;
  try {
    if (m.jid && ctx.sock && ctx.jid) {
      await ctx.sock.sendMessage(ctx.jid, { text: finalText, mentions: [m.jid] });
      return;
    }
  } catch (e) {}
  try { await ctx.reply(finalText); } catch (e2) {}
}

/**
 * tipo: 'adm' | 'dono' | 'modos'
 */
async function guardMenu(ctx, tipo) {
  const owner = await isOwner(ctx);
  const admin = await isAdmin(ctx);
  const m = mentionUser(ctx);

  if (tipo === 'dono') {
    if (owner) return true;
    const nivel = admin ? 'Administrador' : 'Membro Normal';
    const msg = pick(MSGS_DONO);
    await sendDenied(ctx, formatBox(msg, m.text, nivel));
    return false;
  }

  // adm + modos: dono OU admin
  if (tipo === 'adm' || tipo === 'modos') {
    if (owner || admin) return true;
    const msg = pick(MSGS_ADM);
    await sendDenied(ctx, formatBox(msg, m.text, 'Membro Normal'));
    return false;
  }

  return true;
}

module.exports = { isOwner, isAdmin, guardMenu, MSGS_ADM, MSGS_DONO };
