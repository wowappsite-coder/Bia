/**
 * Deteccao e validacao de pagamentos + pedido do numero para megas
 */
const { getDb } = require('../database');
const fs = require('fs');
const path = require('path');

const PENDING_FILE = path.join(__dirname, '../../data/pending_megas.json');

function loadPending() {
  try {
    if (!fs.existsSync(PENDING_FILE)) return {};
    return JSON.parse(fs.readFileSync(PENDING_FILE, 'utf8') || '{}');
  } catch (_) {
    return {};
  }
}

function savePending(data) {
  try {
    fs.mkdirSync(path.dirname(PENDING_FILE), { recursive: true });
    fs.writeFileSync(PENDING_FILE, JSON.stringify(data, null, 2));
  } catch (e) {
    console.error('[pending_megas]', e.message);
  }
}

/** chave por grupo+utilizador */
function pendKey(groupJid, senderJid) {
  return String(groupJid || '') + '|' + String(senderJid || '');
}

function setPendingMegas(groupJid, senderJid, info) {
  const all = loadPending();
  all[pendKey(groupJid, senderJid)] = {
    ...info,
    senderJid,
    groupJid,
    createdAt: Date.now()
  };
  savePending(all);
}

function getPendingMegas(groupJid, senderJid) {
  const all = loadPending();
  const row = all[pendKey(groupJid, senderJid)];
  if (!row) return null;
  // expira em 2h
  if (Date.now() - (row.createdAt || 0) > 2 * 60 * 60 * 1000) {
    delete all[pendKey(groupJid, senderJid)];
    savePending(all);
    return null;
  }
  return row;
}

function clearPendingMegas(groupJid, senderJid) {
  const all = loadPending();
  delete all[pendKey(groupJid, senderJid)];
  savePending(all);
}

function analyzePayment(paymentData, senderJid) {
  const database = getDb();
  const { transactionId, value, fee, destinationNumber, destinationName, provider, date, time, raw } = paymentData;

  if (transactionId) {
    const existing = database.prepare('SELECT * FROM payments WHERE transaction_id = ?').get(transactionId);
    if (existing) {
      return {
        status: 'PAGAMENTO_JA_UTILIZADO',
        message: '⚠️ Esta transação já foi utilizada anteriormente.',
        payment: existing
      };
    }
  }

  let order = null;
  try {
    const pendingOrders = database.prepare(`
      SELECT * FROM orders WHERE status = 'pending' ORDER BY created_at DESC
    `).all();
    for (const o of pendingOrders) {
      let score = 0;
      if (value && Math.abs(o.value_expected - value) < 0.01) score += 3;
      if (destinationNumber && o.number_expected && destinationNumber.includes(String(o.number_expected).slice(-9))) score += 2;
      if (score >= 3) { order = o; break; }
    }
  } catch (_) {}

  let status = 'PAGAMENTO_NAO_ENCONTRADO';
  let message = '';

  if (!transactionId && !value) {
    status = 'PAGAMENTO_INVALIDO';
    message = '❌ Pagamento não confirmado. Dados insuficientes.';
  } else if (value && transactionId) {
    // Com TXID + valor → aprovado (fluxo internet / megas)
    status = 'PAGAMENTO_VALIDO';
    message = '✅ Pagamento confirmado com sucesso!';
  } else if (value) {
    status = 'PAGAMENTO_SUSPEITO';
    message = '⚠️ Pagamento em análise.';
  } else {
    status = 'PAGAMENTO_INVALIDO';
    message = '❌ Pagamento não confirmado.';
  }

  try {
    const insert = database.prepare(`
      INSERT INTO payments (
        order_id, transaction_id, provider, value_received, fee,
        destination_number, destination_name, date, time, raw_message, status
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `);
    const info = insert.run(
      order ? order.id : null,
      transactionId || null,
      provider,
      value || null,
      fee || null,
      destinationNumber || null,
      destinationName || null,
      date || null,
      time || null,
      raw,
      status
    );
    if (status === 'PAGAMENTO_VALIDO' && order) {
      try { database.prepare(`UPDATE orders SET status = 'paid' WHERE id = ?`).run(order.id); } catch (_) {}
    }
    const paymentRecord = database.prepare('SELECT * FROM payments WHERE id = ?').get(info.lastInsertRowid);
    return { status, message, payment: paymentRecord, order };
  } catch (e) {
    console.error('[analyzePayment]', e.message);
    return { status, message, payment: null, order };
  }
}

function formatDetectionReply(paymentData, analysis) {
  const { provider, transactionId, value, destinationNumber, date, time } = paymentData;
  const provName = { mpesa: 'M-Pesa', emola: 'E-Mola', mkash: 'M-Kash' }[provider] || (provider || 'Mobile Money');

  if (analysis.status === 'PAGAMENTO_JA_UTILIZADO') {
    return '⚠️ *TRANSACAO JA UTILIZADA*\n\nEste comprovativo ja foi registado antes.';
  }

  if (analysis.status === 'PAGAMENTO_VALIDO') {
    let text = '💳 *PAGAMENTO APROVADO!* ✅\n\n';
    if (value != null) text += '💰 Valor: *' + Number(value).toFixed(2) + ' MT*\n';
    text += '🏦 Operadora: *' + provName + '*\n';
    if (destinationNumber) text += '📱 Número destino: *' + destinationNumber + '*\n';
    if (date || time) text += '🕐 Data/Hora: ' + (date || '') + (time ? ' às ' + time : '') + '\n';
    if (transactionId) text += '🆔 Transação: *' + transactionId + '*\n';
    text += '\n✅ Pagamento confirmado com sucesso!\n\n';
    text += '📱 Agora envie o *número* que vai receber os megas.\n';
    text += '⚠️ O número deve começar com *84* ou *85*.';
    return text;
  }

  let text = '🧾 *Comprovativo detectado (' + provName + ')*\n\n';
  if (transactionId) text += '🔑 Chave: `' + transactionId + '`\n';
  if (value != null) text += '💵 Valor: ' + Number(value).toFixed(2) + ' MT\n';
  text += '\n' + (analysis.message || '');
  return text;
}

/** Extrai numero MZ 84/85 de uma mensagem simples */
function extractMegasNumber(text) {
  if (!text) return null;
  const t = String(text).replace(/[\s\-]/g, '');
  // so numero, ou com 258
  let m = t.match(/^(?:\+?258)?(8[45]\d{7})$/);
  if (m) return m[1];
  // se a mensagem for so digitos com lixo minimo
  m = String(text).trim().match(/^(?:\+?258[\s\-]*)?(8[45][\s\-]*\d{2}[\s\-]*\d{3}[\s\-]*\d{3})$/);
  if (m) return m[1].replace(/\D/g, '').slice(-9);
  return null;
}

/**
 * Depois do pagamento: utilizador manda o numero.
 * Marca ADMs + mensagem de compra confirmada.
 */
async function handlePendingNumber(sock, msg, sender, jid, text) {
  const pending = getPendingMegas(jid, sender);
  if (!pending) return false;

  const num = extractMegasNumber(text);
  if (!num) {
    // so responde se a mensagem parecer tentativa de numero
    if (/^\s*\+?\d[\d\s\-]{7,}\s*$/.test(text || '')) {
      await sock.sendMessage(jid, {
        text: '⚠️ Número inválido.\nEnvia um número que comece com *84* ou *85* (9 dígitos).'
      }, { quoted: msg }).catch(() => {});
      return true;
    }
    return false;
  }

  clearPendingMegas(jid, sender);

  // buscar admins do grupo
  let adminMentions = [];
  try {
    const meta = await sock.groupMetadata(jid);
    const admins = (meta.participants || []).filter(p => p.admin === 'admin' || p.admin === 'superadmin');
    adminMentions = admins.map(a => a.id).filter(Boolean);
  } catch (_) {}

  const buyerTag = '@' + String(sender).split('@')[0];
  let admTags = '';
  if (adminMentions.length) {
    admTags = adminMentions.map(a => '@' + String(a).split('@')[0]).join(' ');
  }

  const valor = pending.value != null ? Number(pending.value).toFixed(2) + ' MT' : '—';
  const tx = pending.transactionId || '—';
  const prov = pending.providerName || pending.provider || 'Mobile Money';

  let body =
    '✅ *COMPRA CONFIRMADA*\n\n' +
    '👤 Comprador: ' + buyerTag + '\n' +
    '📱 Número para megas: *' + num + '*\n' +
    '💰 Valor pago: *' + valor + '*\n' +
    '🏦 Operadora: *' + prov + '*\n' +
    '🆔 TX: *' + tx + '*\n\n';

  if (admTags) {
    body += '🛡️ ADMs: ' + admTags + '\n\n';
  }

  body += '⏳ *Aguarde o ADM para receber os megas.*';

  const mentions = [sender].concat(adminMentions);

  await sock.sendMessage(jid, {
    text: body,
    mentions: mentions
  }, { quoted: msg }).catch(() => {});

  return true;
}

module.exports = {
  analyzePayment,
  formatDetectionReply,
  setPendingMegas,
  getPendingMegas,
  clearPendingMegas,
  handlePendingNumber,
  extractMegasNumber
};
