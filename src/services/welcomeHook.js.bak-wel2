const welcomeBanner = require('./welcomeBanner');

async function handleAdd(sock, update, g) {
  if (!update || update.action !== 'add') return;
  if (!g || !g.welcome) return;

  for (const p of (update.participants || [])) {
    const tag = '@' + String(p).split('@')[0].split(':')[0];
    const caption = '👋 Seja bem-vindo(a) ' + tag + ' ao grupo! 💚';
    let sent = false;
    try {
      const media = await welcomeBanner.buildWelcomeMedia(sock, update.id, p);
      if (media && media.buffer) {
        await sock.sendMessage(update.id, {
          image: media.buffer,
          caption,
          mentions: [p]
        });
        sent = true;
        console.log('[welcome] imagem enviada');
      }
    } catch (e) {
      console.error('[welcome]', e && e.message ? e.message : e);
    }
    if (!sent) {
      await sock.sendMessage(update.id, { text: caption, mentions: [p] });
    }
  }
}

module.exports = { handleAdd };
