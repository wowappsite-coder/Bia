module.exports = module.exports.concat([
  {
    name: 'maiseps',
    aliases: ['moreeps', 'proxeps', 'episodiosmais', '+eps'],
    category: 'utilidades',
    description: 'Proxima pagina de episodios anime',
    handler: async function (ctx) {
      const s = loadSession(ctx);
      if (!s || !s.episodes || !s.episodes.length) {
        return ctx.reply(boxAnime(['Sem lista de episodios.', 'Faz: *anime <nome>* → *dub*/*leg*']));
      }
      const pageSize = 30;
      const page = (s.epPage || 0) + 1;
      const start = page * pageSize;
      if (start >= s.episodes.length) {
        return ctx.reply(boxAnime(['✅ Ja mostraste todos os *' + s.episodes.length + '* episodios.']));
      }
      s.epPage = page;
      saveSession(ctx, s);
      return ctx.reply(formatEpPage(s, page));
    }
  }
]);

