const { isOwnerJid } = require('../../utils/ownerCheck');
/**
 * Personalizar precos de aluguel pelo WhatsApp (so Owner)
 */
const config = require('../../config');

function defaultPlans() {
  return (config.rentalPlans || [
    { days: 1, emoji: '⚪', price: '12 MT' },
    { days: 3, emoji: '🟡', price: '24 MT' },
    { days: 7, emoji: '🟢', price: '36 MT' },
    { days: 15, emoji: '🔵', price: '84 MT' },
    { days: 30, emoji: '🟣', price: '120 MT' },
    { days: 60, emoji: '🟠', price: '216 MT' },
    { days: 90, emoji: '🔴', price: '336 MT' },
    { days: 365, emoji: '⭐', price: '600 MT' }
  ]).map(function (p) {
    return { days: p.days, emoji: p.emoji || '•', price: p.price };
  });
}

function loadPlans() {
  try {
    const { getDb } = require('../../database');
    const db = getDb();
    db.exec('CREATE TABLE IF NOT EXISTS bot_settings (key TEXT PRIMARY KEY, value TEXT)');
    const row = db.prepare("SELECT value FROM bot_settings WHERE key = 'rental_plans'").get();
    if (row && row.value) {
      const p = JSON.parse(row.value);
      if (Array.isArray(p) && p.length) return p;
    }
  } catch (_) {}
  return defaultPlans();
}

function savePlans(plans) {
  const { getDb } = require('../../database');
  const db = getDb();
  db.exec('CREATE TABLE IF NOT EXISTS bot_settings (key TEXT PRIMARY KEY, value TEXT)');
  db.prepare(
    "INSERT OR REPLACE INTO bot_settings (key, value) VALUES ('rental_plans', ?)"
  ).run(JSON.stringify(plans));
}

function requireOwner(ctx) {
  try {
    if (typeof ctx.isOwner = (== 'function') return ctx.isOwner()) || (typeof isOwnerJid==='function' && isOwnerJid(ctx.sender||ctx.senderJid||ctx.participant||'')); /* BTZ_OWNER_ASSIGN */
  } catch (_) {}
  return false;
}

// Exporta load para o comando aluguel poder usar se patchado
module.exports.loadRentPlans = loadPlans;

module.exports = [
  {
    name: 'setpreco',
    aliases: ['setprecoaluguel', 'editpreco', 'precoaluguel'],
    category: 'dono',
    description: 'Alterar preco de plano de aluguel',
    ownerOnly: true,
    handler: async (ctx) => {
      if (!requireOwner(ctx)) return ctx.reply('Apenas o dono.');
      const days = parseInt(ctx.args[0], 10);
      const price = (ctx.args || []).slice(1).join(' ').trim();
      if (!days || !price) {
        return ctx.reply(
          '╭──〔 PRECO ALUGUEL 〕──╮\n' +
            '> *setpreco <dias> <preco>*\n' +
            '> Ex: *setpreco 7 40 MT*\n' +
            '> Ex: *setpreco 30 150MT*\n' +
            '❀────────────────❀\n' +
            '> *verprecos* — ver lista\n' +
            '> *resetprecos* — padrao'
        );
      }
      const plans = loadPlans();
      let found = false;
      for (let i = 0; i < plans.length; i++) {
        if (Number(plans[i].days) === days) {
          plans[i].price = price;
          found = true;
          break;
        }
      }
      if (!found) {
        const emojis = { 1: '⚪', 3: '🟡', 7: '🟢', 15: '🔵', 30: '🟣', 60: '🟠', 90: '🔴', 365: '⭐' };
        plans.push({ days: days, emoji: emojis[days] || '•', price: price });
        plans.sort(function (a, b) { return a.days - b.days; });
      }
      savePlans(plans);
      let t = '✅ Preco salvo!\n\n';
      plans.forEach(function (p) {
        t += (p.emoji || '•') + ' *' + p.days + ' dias* — ' + p.price + '\n';
      });
      await ctx.reply(t.trim());
    }
  },
  {
    name: 'verprecos',
    aliases: ['listaprecos'],
    category: 'dono',
    description: 'Listar precos de aluguel',
    ownerOnly: true,
    handler: async (ctx) => {
      if (!requireOwner(ctx)) return ctx.reply('Apenas o dono.');
      const plans = loadPlans();
      let t = '╭──〔 PRECOS ALUGUEL 〕──╮\n';
      plans.forEach(function (p) {
        t += '◈┃ ' + (p.emoji || '•') + ' ' + p.days + 'd — *' + p.price + '*\n';
      });
      t += '╰──────────────────╯';
      await ctx.reply(t);
    }
  },
  {
    name: 'resetprecos',
    aliases: ['resetaluguel'],
    category: 'dono',
    description: 'Restaurar precos padrao',
    ownerOnly: true,
    handler: async (ctx) => {
      if (!requireOwner(ctx)) return ctx.reply('Apenas o dono.');
      savePlans(defaultPlans());
      await ctx.reply('✅ Precos restaurados ao padrao.');
    }
  }
];
