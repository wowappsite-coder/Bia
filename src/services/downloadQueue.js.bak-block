/**
 * Fila global: so 1 download de cada vez (ytd, yta, tk, ig, play, etc.)
 */
const queue = [];
let busy = false;
let current = null;

function isBusy() {
  return busy;
}

function statusText() {
  if (!busy) return null;
  const who = current && current.sender ? current.sender : '?';
  const n = queue.length;
  return { who: who, waiting: n };
}

/**
 * Tenta entrar na fila.
 * @returns {{ ok: true } | { ok: false, reason: string }}
 */
function tryAcquire(ctx, label) {
  const job = {
    sender: ctx.sender,
    jid: ctx.jid,
    label: label || 'download',
    at: Date.now()
  };
  if (!busy) {
    busy = true;
    current = job;
    return { ok: true, queued: false };
  }
  // ja ocupado — nao enfileira automatico (evita fila enorme); rejeita
  return {
    ok: false,
    queued: false,
    reason:
      '❌ *Download em andamento*\n\n' +
      'Outro pedido esta a ser processado.\n' +
      'Espera terminar e tenta de novo.\n' +
      (queue.length ? 'Na espera: ' + queue.length : '')
  };
}

function release() {
  busy = false;
  current = null;
  // se no futuro quiseres processar fila, aqui
}

/** Wrapper: corre handler so se livre; senao responde X */
function withDownloadLock(label, handler) {
  return async function (ctx) {
    const acq = tryAcquire(ctx, label);
    if (!acq.ok) {
      try {
        await ctx.reply(acq.reason);
      } catch (_) {}
      return;
    }
    try {
      return await handler(ctx);
    } finally {
      release();
    }
  };
}

module.exports = {
  tryAcquire,
  release,
  isBusy,
  statusText,
  withDownloadLock
};
