  {
    name: 'regras',
    aliases: ['rules'],
    category: 'grupo',
    description: 'Mostra regras do grupo',
    groupOnly: true,
    handler: async (ctx) => {
      const g = ctx.group;
      let t = (g && g.regras) ? String(g.regras) : '';
      if (!t.trim()) {
        return ctx.reply('Nenhuma regra definida.\nResponda uma mensagem com *setregras*');
      }
      t = t.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      t = t.replace(/^\s*setregras\s*/i, '');
      t = t.replace(/^\s*!?\s*descgp\s*/i, '');
      // Corta ANTES de cada 1• 2• 3• ou 1. 2. 3.
      var chunks = t.split(/(?=\d{1,2}\s*[•·.)\-])/);
      if (chunks.length < 2) {
        // fallback: corta antes de " 2" " 3" etc apos ponto
        chunks = t.split(/(?<=\.)\s*(?=\d{1,2}\s*[•·.)])/);
      }
      t = chunks.map(function (c) { return c.trim(); }).filter(Boolean).join('\n\n');
      // se ainda for 1 bloco, tenta por emoji
      if (t.indexOf('\n\n') < 0) {
        t = t.replace(/\s*(✅|❌|🚫|⛔|📌|💡)/g, '\n\n$1').trim();
      }
      await ctx.reply('╭──〔 📋 REGRAS 〕──╮\n\n' + t + '\n\n╰──────────────────╯');
    }
  },
  {
    name: 'setregras',
    aliases: ['defineregras'],
    category: 'admin',
    description: 'Define regras do grupo',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      let text = (ctx.text && String(ctx.text).trim()) ? String(ctx.text) : '';
      if (!text && ctx.msg && ctx.msg.message) {
        try {
          const m = ctx.msg.message;
          const ci = (m.extendedTextMessage && m.extendedTextMessage.contextInfo) || null;
          const q = ci && ci.quotedMessage;
          if (q) {
            text = q.conversation || (q.extendedTextMessage && q.extendedTextMessage.text) || (q.imageMessage && q.imageMessage.caption) || '';
          }
        } catch (_) {}
      }
      if (!text || !String(text).trim()) {
        return ctx.reply('Envie o texto formatado e *responda* com *setregras*\nOu: *setregras* regra1\\nregra2');
      }
      text = String(text).replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      text = text.replace(/^\s*I?descgp\s*/i, '');
      // forcar quebra antes de 1. 2. 3. se vier numa linha
      if ((text.match(/\n/g) || []).length < 3) {
        text = text.replace(/\s*([1-9]\d*)\s*[.)•:\-]\s+/g, '\n$1. ');
      }
      text = text.split('\n').map(function (l) { return l.trim(); }).filter(Boolean).join('\n');
      db.updateGroup(ctx.jid, { regras: formatRegrasText(text ) });
      await ctx.reply('Regras atualizadas!\n\n╭──〔 📋 𝐑𝐄𝐆𝐑𝐀𝐒 〕──╮\n\n' + text.split('\n').join('\n\n') + '\n\n╰──────────────────╯');
    }
  },
  {
    name: 'bemvindo',
    aliases: ['welcome', 'boasvindas'],
    category: 'admin',
    description: 'Ativa/desativa boas-vindas',
    groupOnly: true,
    adminOnly: true,
    usage: '!bemvindo on/off',
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const arg = (ctx.args[0] || '').toLowerCase();
      if (arg === 'on' || arg === 'ativar') {
        db.updateGroup(ctx.jid, { welcome: 1 });
        await ctx.reply('✅ Boas-vindas ativadas.');
      } else if (arg === 'off' || arg === 'desativar') {
        db.updateGroup(ctx.jid, { welcome: 0 });
        await ctx.reply('✅ Boas-vindas desativadas.');
      } else {
        const g = ctx.group;
        await ctx.reply(`📬 Boas-vindas: ${g.welcome ? 'ATIVADO' : 'DESATIVADO'}\nUse !bemvindo on/off`);
      }
    }
  },
  {
    name: 'saida',
    aliases: ['goodbye', 'adeus'],
    category: 'admin',
    description: 'Ativa/desativa mensagem de saída',
    groupOnly: true,
    adminOnly: true,
    usage: '!saida on/off',
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const arg = (ctx.args[0] || '').toLowerCase();
      if (arg === 'on') {
        db.updateGroup(ctx.jid, { goodbye: 1 });
        await ctx.reply('✅ Mensagem de saída ativada.');
      } else if (arg === 'off') {
        db.updateGroup(ctx.jid, { goodbye: 0 });
        await ctx.reply('✅ Mensagem de saída desativada.');
      } else {
        const g = ctx.group;
        await ctx.reply(`👋 Saída: ${g.goodbye ? 'ATIVADO' : 'DESATIVADO'}`);
      }
    }
  },
  {
    name: 'abrirgrupo',
    aliases: ['open', 'opengp', 'grupoabrir', 'abrir'],
    category: 'admin',
    description: 'Abre o grupo (todos podem enviar mensagens)',
    groupOnly: true,
    adminOnly: true,
    botAdminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      try {
        await ctx.sock.groupSettingUpdate(ctx.jid, 'not_announcement');
        await ctx.reply('🔓 *Grupo aberto!*\nTodos os membros podem enviar mensagens.');
      } catch (e) {
        console.error('abrirgrupo', e.message);
        await ctx.reply('❌ Não consegui abrir o grupo.\nO bot precisa ser *admin* do grupo.');
      }
    }
  },
  {
    name: 'fechargrupo',
    aliases: ['close', 'closegp', 'grupofechar', 'fechar'],
    category: 'admin',
    description: 'Fecha o grupo (só admins enviam mensagens)',
    groupOnly: true,
    adminOnly: true,
    botAdminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      try {
        await ctx.sock.groupSettingUpdate(ctx.jid, 'announcement');
        await ctx.reply('🔒 *Grupo fechado!*\nApenas administradores podem enviar mensagens.');
      } catch (e) {
        console.error('fechargrupo', e.message);
        await ctx.reply('❌ Não consegui fechar o grupo.\nO bot precisa ser *admin* do grupo.');
      }
    }
  }
];
