/**
 * Temas visuais por prefixo
 * !  → tema "luxo" (novo)
 * resto / sem prefixo → visual original
 */

function useNewTheme(ctx) {
  try {
    return String(ctx && ctx.prefix || '') === '!';
  } catch (_) {
    return false;
  }
}

function line(ch, n) {
  return String(ch).repeat(n);
}

/** Menu principal — tema ! */
function mainMenuTheme(stats, botName, prefix) {
  const p = prefix || '!';
  return (
`╔══━─❦ ✧ ❖ ✧ ─━━╗
║  ╭━━✯ ❖ 𝐈𝐍𝐅𝐎𝐒 ❖ ✯━━╮
║  │
║  │  ✦ 𝗕𝗢𝗧: *${botName}*
║  │  ✦ 𝗣𝗥𝗘𝗙𝗜𝗫𝗢: [ ${p} ]
║  │  ✦ 𝗖𝗢𝗠𝗔𝗡𝗗𝗢𝗦: ${stats.totalMain || '?'}
║  │
║  ╰━━━✦ ❖ ✦━━━╯
║
║  ╭━━✯ ❖ 𝐏𝐑𝐈𝐍𝐂𝐈𝐏𝐀𝐈𝐒 ❖ ✯━━╮
║  │
║  │  💠 ${p}menudono
║  │  💠 ${p}menuadm
║  │  💠 ${p}menugrupo
║  │  💠 ${p}menuinternet
║  │  💠 ${p}menubn
║  │  💠 ${p}menudiversao
║  │  💠 ${p}menufig
║  │  💠 ${p}menuimg
║  │  💠 ${p}menuseguranca
