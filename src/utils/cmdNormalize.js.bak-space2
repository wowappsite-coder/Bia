/**
 * Normaliza comandos com espaco: "menu download" -> "menudownload"
 */
const SPACE_COMMANDS = {
  'menu download': 'menudownload',
  'menu dl': 'menudownload',
  'menu baixar': 'menudownload',
  'menu downloads': 'menudownload',
  'menu dono': 'menudono',
  'menu adm': 'menuadm',
  'menu admin': 'menuadm',
  'menu grupo': 'menugrupo',
  'menu internet': 'menuinternet',
  'menu bn': 'menubn',
  'menu diversao': 'menudiversao',
  'menu diversão': 'menudiversao',
  'menu stickers': 'menustickers',
  'menu sticker': 'menustickers',
  'menu imagem': 'menuimagem',
  'menu rpg': 'menurpg',
  'menu economia': 'menueconomia',
  'menu aluguel': 'menualuguel',
  'menu jogos': 'menuwebgames',
  'menu webgames': 'menuwebgames',
  'menu modos': 'menumodos',
  'menu isekai': 'menuisekai'
};

const SLASH_MENU_MAP = true;
function normalizeCommandText(text) {
  // /menu -> smenu (terceiro menu interativo)
  try {
    const raw = String(text || '').trim();
    if (/^\/menu(\s|$)/i.test(raw)) {
      return raw.replace(/^\/menu/i, '/smenu');
    }
  } catch (_) {}

  let t = String(text || '').trim();
  if (!t) return t;
  // remove prefixos comuns no inicio
  const pref = t.match(/^([.#!\/]+)(\s*)/);
  let prefix = '';
  if (pref) {
    prefix = pref[1];
    t = t.slice(pref[0].length).trim();
  }
  const lower = t.toLowerCase();
  // tenta 2 e 3 palavras
  const parts = lower.split(/\s+/);
  for (let n = Math.min(3, parts.length); n >= 2; n--) {
    const key = parts.slice(0, n).join(' ');
    if (SPACE_COMMANDS[key]) {
      const rest = parts.slice(n).join(' ');
      const out = (prefix ? prefix : '') + SPACE_COMMANDS[key] + (rest ? ' ' + rest : '');
      return out;
    }
  }
  return (prefix ? prefix : '') + t;
}

module.exports = { normalizeCommandText, SPACE_COMMANDS };
