  'BEATRIZ_SEARCH_RULE: Se a mensagem do user trouxer "Resultados de pesquisa", usa ESSA info e inclui links reais. Se disser que nao ha resultados, admite e sugere yt/play/spotify. Nunca inventes URLs.\n' +
  'Tu es a Bia, IA do Beatriz Bot no WhatsApp.\n\nPersonalidade (estilo Grok +18):\n- Sarcastica, provocadora e com humor acido, sem ser gratuita.\n- Fala natural, direta e ousada — como uma pessoa, nao como assistente corporativo.\n- Pode ser sensual e flertar quando o contexto for +18, sem forcar em tudo.\n- Respostas curtas ou medias; so alonga se a pergunta pedir.\n- Portugues informal (Mocambique/Brasil), sem formalidade excessiva.\n- NUNCA inventes factos, links, precos, noticias ou dados. Se nao souberes, diz que nao sabes.\n- NUNCA mostres raciocinio interno, thinking, listas tecnicas nem ingles de sistema.\n- Se a pergunta for sobre o bot/comandos, responde util e clara.\n- Se for conversa normal ou provocacao, responde no tom ousado e engraçado.\n- Conteudo sexual explicito so se o utilizador pedir ou o contexto for claramente +18.\n- Nao des conselhos ilegais nem instrucoes perigosas.\n\nResponde sempre em portugues, so com a resposta final para o utilizador.' +
  'REGRA ABSOLUTA: a tua mensagem deve conter APENAS a resposta final ao utilizador.\n' +
  'PROIBIDO escrever em ingles. PROIBIDO thinking, analyze, visual clues, the user wants,\n' +
  'Main Subject, Background, step-by-step, listas tecnicas ou rascunhos.\n' +
  'Se for personagem de anime: diga o nome e o anime de forma curta e natural.\n' +
  'Exemplo: "Sim! E a Mikasa, do anime Attack on Titan. 😊"\n' +
  'Se nao tiveres certeza: "Acho que e a X, do anime Y, mas nao tenho 100% de certeza."\n' +
  'Uma a quatro frases. Sem titulos. Sem markdown de relatorio.';

function cleanAnswer(text) {
  let t = String(text || '');

  // remove tags
  t = t.split('<think>').join('').split('</think>').join('');
  t = t.split('<thinking>').join('').split('</thinking>').join('');
  t = t.split('<response>').join('').split('</response>').join('');

  // se houver bloco ingles de raciocinio, fica com o que vem DEPOIS do ultimo marcador
  const cutMarks = [
    "Here's a thinking process:",
    'Here is a thinking process:',
    'Thinking process:',
    'Analyze the request',
    'Analyze the Request',
    'Visual clues',
    'The user wants',
    'Step-by-step',
    'Final answer:',
    'Final Answer:',
    'Resposta final:',
    'Resposta:'
  ];
  for (let i = 0; i < cutMarks.length; i++) {
    const idx = t.lastIndexOf(cutMarks[i]);
    if (idx >= 0) {
      t = t.slice(idx + cutMarks[i].length);
    }
  }

  // remove linhas tipicamente de meta-analise
  t = t.split('\n').filter(function (line) {
    const l = line.trim();
    if (!l) return false;
    if (/^(Main Subject|Background|Composition|Foreground|Lighting|Style|Visual clues)\b/i.test(l)) return false;
    if (/^The user wants/i.test(l)) return false;
    if (/^Analyze\b/i.test(l)) return false;
    if (/^\d+\.\s*\*/.test(l)) return false;
    if (/^\*\*(Main|Background|User|Image|Request)/i.test(l)) return false;
    if (/^Here('s| is) a thinking/i.test(l)) return false;
    // descarta linhas quase so em ingles (sem acentos/pt comuns) e longas de analise
    if (/\b(the|and|with|from|this|that|image|character|appears|seems)\b/i.test(l)
        && !/[áàâãéêíóôõúçÁÉÍÓÚãõ]/i.test(l)
        && l.length > 40) {
      return false;
    }
    return true;
  }).join('\n');

  t = t.replace(/\n{3,}/g, '\n\n').trim();

  // se ainda comecar em ingles, tenta achar primeira frase em PT
  if (/^(The |Here |Analyze |Main |Based on )/i.test(t)) {
    const m = t.match(/[A-ZÁÉÍÓÚÃÕ][^.!?\n]*[áàâãéêíóôõúç][^.!?\n]*[.!?]?/);
    if (m) t = m[0];
  }

  if (t.length > 900) t = t.slice(0, 880).trim() + '...';
  if (!t) t = 'Nao consegui ler bem a imagem. Podes enviar outra ou dizer o que queres que eu procure nela?';
  return t;
}

const VISION_MODELS = [
  'qwen/qwen3.6-27b',
  'meta-llama/llama-4-scout-17b-16e-instruct',
  'meta-llama/llama-4-maverick-17b-128e-instruct'
];

const TEXT_FALLBACKS = [
  'openai/gpt-oss-20b',
  'openai/gpt-oss-120b',
  'gemma2-9b-it',
  'llama3-8b-8192',
  'llama-3.1-8b-instant',
  'llama-3.3-70b-versatile'
];

const WHISPER_MODELS = ['whisper-large-v3-turbo', 'whisper-large-v3'];

function httpGetJson(urlStr, headers) {
  return new Promise(function (resolve, reject) {
    let u;
    try { u = new URL(urlStr); } catch (e) { return reject(e); }
    const lib = u.protocol === 'http:' ? http : https;
    const req = lib.get({
      hostname: u.hostname,
      path: u.pathname + u.search,
      protocol: u.protocol,
      headers: Object.assign({ 'User-Agent': 'BeatrizBot/1.0', Accept: 'application/json' }, headers || {}),
      timeout: 20000
    }, function (res) {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        res.resume();
        return httpGetJson(res.headers.location, headers).then(resolve, reject);
      }
      const chunks = [];
      res.on('data', function (c) { chunks.push(c); });
      res.on('end', function () {
        const raw = Buffer.concat(chunks).toString('utf8');
        if (res.statusCode < 200 || res.statusCode >= 300) {
          return reject(new Error('HTTP ' + res.statusCode));
        }
        try { resolve(JSON.parse(raw)); }
        catch (e) { reject(new Error('JSON invalido')); }
      });
    });
    req.on('error', reject);
    req.on('timeout', function () { req.destroy(); reject(new Error('Timeout')); });
  });
}

function httpsPostJson(hostname, pathName, apiKey, bodyObj) {
  return new Promise(function (resolve, reject) {
    const body = JSON.stringify(bodyObj);
    const req = https.request({
      hostname: hostname,
      path: pathName,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: 'Bearer ' + apiKey,
        'Content-Length': Buffer.byteLength(body)
      },
      timeout: 90000
    }, function (res) {
      const chunks = [];
      res.on('data', function (c) { chunks.push(c); });
      res.on('end', function () {
        resolve({ status: res.statusCode, body: Buffer.concat(chunks).toString('utf8') });
      });
    });
    req.on('error', reject);
    req.on('timeout', function () { req.destroy(); reject(new Error('Timeout Groq')); });
    req.write(body);
    req.end();
  });
}

function httpsPostMultipart(hostname, pathName, apiKey, formFields, fileField) {
  return new Promise(function (resolve, reject) {
    const boundary = '----Beatriz' + Date.now();
    const parts = [];
    const fields = formFields || {};
    Object.keys(fields).forEach(function (k) {
      parts.push(Buffer.from(
        '--' + boundary + '\r\n' +
        'Content-Disposition: form-data; name="' + k + '"\r\n\r\n' +
        fields[k] + '\r\n'
      ));
    });
    if (fileField) {
      parts.push(Buffer.from(
        '--' + boundary + '\r\n' +
        'Content-Disposition: form-data; name="' + fileField.name + '"; filename="' + fileField.filename + '"\r\n' +
        'Content-Type: ' + (fileField.mime || 'application/octet-stream') + '\r\n\r\n'
      ));
      parts.push(fileField.buffer);
      parts.push(Buffer.from('\r\n'));
    }
    parts.push(Buffer.from('--' + boundary + '--\r\n'));
    const body = Buffer.concat(parts);
    const req = https.request({
      hostname: hostname,
      path: pathName,
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + apiKey,
        'Content-Type': 'multipart/form-data; boundary=' + boundary,
        'Content-Length': body.length
      },
      timeout: 120000
    }, function (res) {
      const chunks = [];
      res.on('data', function (c) { chunks.push(c); });
      res.on('end', function () {
        resolve({ status: res.statusCode, body: Buffer.concat(chunks).toString('utf8') });
      });
    });
    req.on('error', reject);
    req.on('timeout', function () { req.destroy(); reject(new Error('Timeout whisper')); });
    req.write(body);
    req.end();
  });
}

function needsSearch(q) {
  const s = String(q || '').toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const words = [
    'pesquisa', 'pesquisar', 'procura', 'procurar', 'encontra', 'encontrar',
    'link', 'links', 'site', 'sites', 'onde', 'google', 'internet',
    'video', 'videos', 'filme', 'trailer', 'noticia', 'noticias',
    'quem e', 'quem é', 'o que e', 'o que é', 'informacoes', 'informações', 'sobre',
    'top', 'ranking', 'mais tocada', 'mais tocadas', 'mais ouvida', 'mais ouvidas',
    'spotify', 'youtube', 'musica', 'musicas', 'música', 'músicas',
    'atual', 'hoje', 'agora', '2024', '2025', '2026',
    'preco', 'preço', 'cotacao', 'cotação', 'quando', 'quantos', 'quantas',
    'lista', 'melhores', 'pior', 'campeao', 'campeão', 'chart', 'trending',
    'como fazer', 'como se', 'tutorial', 'download', 'baixar'
  ];
  for (let i = 0; i < words.length; i++) {
    const w = words[i].normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    if (s.indexOf(w) >= 0) return true;
  }
  // perguntas curtas com ? tambem pesquisam
  if (s.indexOf('?') >= 0 && s.length > 12) return true;
  return false;
}

async function searchDuckDuckGo(query) {
  const url =
    'https://api.duckduckgo.com/?q=' + encodeURIComponent(query) +
    '&format=json&no_html=1&skip_disambig=1';
  const data = await httpGetJson(url);
  const out = [];
  if (data.AbstractText) {
    out.push({
      title: data.Heading || 'Resultado',
      snippet: data.AbstractText,
      link: data.AbstractURL || data.AbstractSource || ''
    });
  }
  const rel = data.RelatedTopics || [];
  for (let i = 0; i < rel.length && out.length < 5; i++) {
    const t = rel[i];
    if (t.Topics) {
      for (let j = 0; j < t.Topics.length && out.length < 5; j++) {
        const x = t.Topics[j];
        if (x.Text) {
          out.push({
            title: String(x.Text).split(' - ')[0].slice(0, 80),
            snippet: x.Text || '',
            link: x.FirstURL || ''
          });
        }
      }
    } else if (t.Text) {
      out.push({
        title: String(t.Text).split(' - ')[0].slice(0, 80),
        snippet: t.Text || '',
        link: t.FirstURL || ''
      });
    }
  }
  return out;
}

async function searchWikipedia(query) {
  const url =
    'https://pt.wikipedia.org/w/api.php?action=opensearch&limit=3&namespace=0&format=json&search=' +
    encodeURIComponent(query);
  const data = await httpGetJson(url);
  const titles = data[1] || [];
  const descs = data[2] || [];
  const links = data[3] || [];
  const out = [];
  for (let i = 0; i < titles.length; i++) {
    out.push({ title: titles[i], snippet: descs[i] || '', link: links[i] || '' });
  }
  return out;
}

async function searchYoutube(query) {
  const keys = [];
  const multi = (process.env.YOUTUBE_API_KEYS || '').trim();
  if (multi) multi.split(/[,;\s]+/).forEach(function (k) {
    k = String(k || '').trim();
    if (k && keys.indexOf(k) < 0) keys.push(k);
  });
  [process.env.YOUTUBE_API_KEY, process.env.YOUTUBE_API_KEY_2, process.env.YOUTUBE_API_KEY_3, process.env.YT_API_KEY]
    .forEach(function (k) {
      k = String(k || '').trim();
      if (k && keys.indexOf(k) < 0) keys.push(k);
    });
  if (!keys.length) return [];
  for (let ki = 0; ki < keys.length; ki++) {
    try {
      const pathY =
        '/youtube/v3/search?part=snippet&type=video&maxResults=3&order=relevance&q=' +
        encodeURIComponent(query) +
        '&key=' + encodeURIComponent(keys[ki]);
      const data = await httpGetJson('https://www.googleapis.com' + pathY);
      if (data && data.error) continue;
      const items = data.items || [];
      return items.map(function (it) {
        const id = it.id && it.id.videoId;
        const sn = it.snippet || {};
        return {
          title: sn.title || 'Video',
          snippet: (sn.channelTitle || '') + (sn.description ? ' — ' + String(sn.description).slice(0, 80) : ''),
          link: id ? ('https://www.youtube.com/watch?v=' + id) : ''
        };
      }).filter(function (r) { return r.link; });
    } catch (e) {
      console.error('[bia-search] yt key', ki + 1, e.message);
    }
  }
  return [];
}

async function gatherSearch(query) {
  const results = [];
  const q = String(query).slice(0, 200);
  const lower = q.toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const wantYt =
    lower.indexOf('video') >= 0 ||
    lower.indexOf('filme') >= 0 ||
    lower.indexOf('youtube') >= 0 ||
    lower.indexOf('musica') >= 0 ||
    lower.indexOf('spotify') >= 0 ||
    lower.indexOf('tocada') >= 0 ||
    lower.indexOf('ouvida') >= 0 ||
    lower.indexOf('song') >= 0 ||
    lower.indexOf('clip') >= 0 ||
    lower.indexOf('top') >= 0;

  if (wantYt) {
    try {
      const yt = await searchYoutube(q);
      for (let i = 0; i < yt.length; i++) results.push(yt[i]);
    } catch (e) { console.error('[bia-search] yt', e.message); }
  }
  try {
    const ddg = await searchDuckDuckGo(q);
    for (let i = 0; i < ddg.length; i++) results.push(ddg[i]);
  } catch (e) { console.error('[bia-search] ddg', e.message); }
  if (results.length < 2) {
    try {
      const wiki = await searchWikipedia(q);
      for (let i = 0; i < wiki.length; i++) results.push(wiki[i]);
    } catch (e) { console.error('[bia-search] wiki', e.message); }
  }
  // segunda tentativa YT generica se ainda vazio
  if (results.length < 1 && !wantYt) {
    try {
      const yt2 = await searchYoutube(q);
      for (let i = 0; i < yt2.length; i++) results.push(yt2[i]);
    } catch (e) {}
  }
  const seen = {};
  const uniq = [];
  for (let i = 0; i < results.length; i++) {
    const r = results[i];
    const k = r.link || r.title;
    if (!k || seen[k]) continue;
    seen[k] = true;
    uniq.push(r);
  }
  return uniq.slice(0, 5);
}

function formatSearchBlock(results) {
  if (!results || !results.length) {
    return 'Nenhum resultado de pesquisa confiavel encontrado. Diz isso com naturalidade e, se fizer sentido, sugere comandos do bot: *yt*, *play*, *spotify*, *ytplay*. Nao inventes links.';
  }
  let t = 'Resultados de pesquisa REAIS (usa estes dados; podes citar titulo e link; NAO inventes outros links):\n';
  for (let i = 0; i < results.length; i++) {
    const r = results[i];
    t += (i + 1) + '. ' + (r.title || 'Item') + '\n';
    if (r.snippet) t += '   ' + String(r.snippet).slice(0, 180) + '\n';
    if (r.link) t += '   Link: ' + r.link + '\n';
  }
  t += '\nResponde em portugues, util e direta. Se forem musicas, indica 1-2 links reais da lista.';
  return t;
}

async function withKeyRotation(run) {
  const available = keys.getAvailableKeys();
  if (!available.length) throw new Error('NO_KEYS');
  let lastErr = null;
  for (let i = 0; i < available.length; i++) {
    const entry = available[i];
    try {
      return await run(entry);
    } catch (e) {
      lastErr = e;
      const msg = String(e && e.message || e);
      console.error('[groq]', entry.name, keys.mask(entry.key), msg.slice(0, 120));
      if (msg.indexOf('401') >= 0 || msg.indexOf('403') >= 0 || msg.indexOf('auth') >= 0) {
        keys.markAuthFail(entry.name);
        continue;
      }
      if (msg.indexOf('429') >= 0 || msg.indexOf('rate') >= 0) {
        keys.markTempFail(entry.name, 120000);
        continue;
      }
      keys.markTempFail(entry.name, 30000);
    }
  }
  throw lastErr || new Error('ALL_FAILED');
}

async function transcribeAudio(buffer, mime) {
  const filename = (mime && mime.indexOf('mpeg') >= 0) ? 'audio.mp3' : 'audio.ogg';
  const mt = mime || 'audio/ogg';
  return withKeyRotation(async function (entry) {
    let last = null;
    for (let i = 0; i < WHISPER_MODELS.length; i++) {
      const model = WHISPER_MODELS[i];
      const r = await httpsPostMultipart(
        'api.groq.com',
        '/openai/v1/audio/transcriptions',
        entry.key,
        { model: model, language: 'pt', response_format: 'json' },
        { name: 'file', filename: filename, mime: mt, buffer: buffer }
      );
      if (r.status === 401 || r.status === 403) throw new Error('auth ' + r.status);
      if (r.status === 429) throw new Error('rate 429');
      if (r.status === 404 || (r.body && r.body.indexOf('model_not_found') >= 0)) {
        last = new Error('whisper model ' + model);
        continue;
      }
      if (r.status < 200 || r.status >= 300) {
        throw new Error('HTTP ' + r.status + ' ' + r.body.slice(0, 100));
      }
      const data = JSON.parse(r.body);
      const text = data.text || '';
      if (!text.trim()) throw new Error('transcricao vazia');
      return cleanAnswer(text);
    }
    throw last || new Error('whisper fail');
  });
}

async function chatVision(question, imageBase64, mime) {
  const dataUrl = 'data:' + (mime || 'image/jpeg') + ';base64,' + imageBase64;
  const content = [
    { type: 'text', text: question || 'Responde SO em portugues, uma frase natural: o que vês ou quem e a personagem? Sem thinking.' },
    { type: 'image_url', image_url: { url: dataUrl } }
  ];
  const messages = [
    { role: 'system', content: SYSTEM_PROMPT },
    { role: 'user', content: content }
  ];
  return withKeyRotation(async function (entry) {
    let last = null;
    for (let i = 0; i < VISION_MODELS.length; i++) {
      const model = VISION_MODELS[i];
      const r = await httpsPostJson('api.groq.com', '/openai/v1/chat/completions', entry.key, {
        model: model,
        messages: messages,
        temperature: 0.3,
        max_tokens: 220
      });
      if (r.status === 401 || r.status === 403) throw new Error('auth ' + r.status);
      if (r.status === 429) throw new Error('rate 429');
      if (r.status === 404 || (r.body && r.body.indexOf('model_not_found') >= 0)) {
        last = new Error('vision model ' + model);
        continue;
      }
      if (r.status < 200 || r.status >= 300) {
        throw new Error('HTTP ' + r.status + ' ' + r.body.slice(0, 120));
      }
      const data = JSON.parse(r.body);
      const text = data && data.choices && data.choices[0] &&
        data.choices[0].message && data.choices[0].message.content;
      if (!text) throw new Error('empty vision');
      return cleanAnswer(text);
    }
    throw last || new Error('vision fail');
  });
}

async function askBeatriz(userQuestion, opts) {
  opts = opts || {};
  const q = String(userQuestion || '').trim().slice(0, 4000);

  if (opts.imageBuffer && opts.imageBuffer.length > 100) {
    const b64 = opts.imageBuffer.toString('base64');
    if (b64.length > 5.5 * 1024 * 1024) throw new Error('imagem demasiado grande');
    return chatVision(q || 'Olha esta imagem e descreve o que vês de forma natural, em português.', b64, opts.imageMime || 'image/jpeg');
  }

  let extra = '';
  if (opts.audioBuffer && opts.audioBuffer.length > 50) {
    const transcript = await transcribeAudio(opts.audioBuffer, opts.audioMime);
    extra = 'Transcricao do audio do utilizador:\n"' + transcript + '"\n\n';
  }

  const question = extra + (q || (extra ? 'O que foi dito neste audio? Resume em portugues.' : ''));
  if (!question.trim()) throw new Error('empty');

  let searchBlock = '';
  if (needsSearch(q) && !opts.imageBuffer && !opts.audioBuffer) {
    try {
      searchBlock = formatSearchBlock(await gatherSearch(q));
    } catch (e) {
      console.error('[bia-search]', e.message);
    }
  }

  const messages = [
    { role: 'system', content: SYSTEM_PROMPT },
    {
      role: 'user',
      content: searchBlock ? (searchBlock + '\n\nPergunta: ' + question) : question
    }
  ];

  const modelsToTry = [keys.getModel()].concat(TEXT_FALLBACKS);

  return withKeyRotation(async function (entry) {
    let last = null;
    for (let mi = 0; mi < modelsToTry.length; mi++) {
      const model = modelsToTry[mi];
      const r = await httpsPostJson('api.groq.com', '/openai/v1/chat/completions', entry.key, {
        model: model,
        messages: messages,
        temperature: 0.6,
        max_tokens: 600
      });
      if (r.status === 401 || r.status === 403) throw new Error('auth ' + r.status);
      if (r.status === 429) throw new Error('rate 429');
      if (r.status === 404 || (r.body && r.body.indexOf('model_not_found') >= 0)) {
        last = new Error('model ' + model);
        continue;
      }
      if (r.status < 200 || r.status >= 300) {
        throw new Error('HTTP ' + r.status + ' ' + r.body.slice(0, 100));
      }
      const data = JSON.parse(r.body);
      const text = data && data.choices && data.choices[0] &&
        data.choices[0].message && data.choices[0].message.content;
      if (!text) {
        last = new Error('empty');
        continue;
      }
      return cleanAnswer(text);
    }
    throw last || new Error('text fail');
  });
}

module.exports = { askBeatriz, needsSearch, gatherSearch, transcribeAudio, cleanAnswer };
