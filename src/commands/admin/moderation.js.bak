  {
    name: 'grupoinfo',
    aliases: ['infogrupo', 'ginfo'],
    category: 'grupo',
    description: 'Informações do grupo',
    groupOnly: true,
    handler: async (ctx) => {
      try {
        const meta = await ctx.getGroupMetadata();
        if (!meta) return ctx.reply('❌ Não foi possível obter info.');
        const admins = meta.participants.filter(p => p.admin).length;
        await ctx.reply(`👥 *Info do Grupo*\n\n📛 Nome: ${meta.subject}\n👤 Participantes: ${meta.participants.length}\n🛡️ Admins: ${admins}\n📅 Criado: ${meta.creation ? new Date(meta.creation * 1000).toLocaleDateString() : '?'}\n📝 Desc: ${(meta.desc || 'Sem descrição').slice(0, 200)}`);
      } catch {
        await ctx.reply('❌ Erro ao obter informações.');
      }
    }
  },
  {
    name: 'admins',
    aliases: ['listadmins', 'adminlist'],
    category: 'grupo',
    description: 'Lista administradores do grupo',
    groupOnly: true,
    handler: async (ctx) => {
      try {
        const meta = await ctx.getGroupMetadata();
        const admins = meta.participants.filter(p => p.admin);
        let text = '🛡️ *Administradores*\n\n';
