function getPrefix(ctx) {
  return (ctx && ctx.prefix != null && String(ctx.prefix).length) ? String(ctx.prefix) : '!';
}

function buildClassic(p) {
  return (
    '╭──〔 📥 𝐌𝐄𝐍𝐔 𝐃𝐎𝐖𝐍𝐋𝐎𝐀𝐃 〕──╮\n' +
    '│\n' +
    '├─〔 🔍 𝐏𝐄𝐒𝐐𝐔𝐈𝐒𝐀 〕\n' +
    '│  ' + p + 'yt — pesquisar YouTube\n' +
    '│  ' + p + 'play — pesquisar/tocar\n' +
    '│  ' + p + 'spotify — Spotify\n' +
    '│  ' + p + 'ytplay — tocar YT (audio+capa)\n' +
    '│  ' + p + 'ytplay2 — YT em documento MP3\n' +
    '│\n' +
    '├─〔 ⬇️ 𝐘𝐎𝐔𝐓𝐔𝐁𝐄 〕\n' +
    '│  ' + p + 'ytd — baixar video\n' +
    '│  ' + p + 'yta — baixar audio\n' +
    '│  ' + p + 'vta — video → audio\n' +
    '│\n' +
    '├─〔 📱 𝐑𝐄𝐃𝐄𝐒 〕\n' +
    '│  ' + p + 'tk — TikTok\n' +
    '│  ' + p + 'ig — Instagram\n' +
    '│  ' + p + 'fb — Facebook\n' +
    '│  ' + p + 'kw — Kwai\n' +
    '│  ' + p + 'pin — Pinterest
│  !vk — VK / VK Clips
│  !twitch — Twitch
│  !rumble — Rumble
│  !vimeo — Vimeo
│  !dailymotion — Dailymotion
│  !twitter — X/Twitter
│  !likee — Likee
│  !snap — Snapchat Spotlight
│  !reddit — Reddit
│  !tumblr — Tumblr
│  !threads — Threads
│  !bilibili — Bilibili
│  !snack — SnackVideo
│  !clapper — Clapper
│  !triller — Triller
│  !lemon8 — Lemon8
│  !moj — Moj
│  !josh — Josh
│  !chingari — Chingari
│  !sharechat — ShareChat
│  !zili — Zili (link)\n' +
    '│  ' + p + 'pint — Pinterest (pesquisa)\n' +
    '│\n' +
    '├─〔 📦 𝐀𝐑𝐐𝐔𝐈𝐕𝐎𝐒 〕\n' +
    '│  ' + p + 'multidl — multi download\n' +
    '│  ' + p + 'mediafire — MediaFire\n' +
    '│  ' + p + 'gdrive — Google Drive\n' +
    '│  ' + p + 'capcut — CapCut\n' +
    '│  ' + p + 'fdroid — F-Droid\n' +
    '│  ' + p + 'gerarlink — link publico (Catbox)\n' +
    '│\n' +
    '├─〔 🎤 𝐀𝐔𝐃𝐈𝐎 / 𝐕𝐎𝐙 〕\n' +
    '│  ' + p + 'crad — criar audio (TTS)\n' +
    '│  ' + p + 'criaraudio — mesmo que crad\n' +
    '│\n' +
    '├─〔 💡 𝐄𝐗𝐄𝐌𝐏𝐋𝐎𝐒 〕\n' +
    '│  ' + p + 'ytplay montagem sem controle\n' +
    '│  ' + p + 'ytplay2 nome da musica\n' +
    '│  ' + p + 'ytd https://youtu.be/xxx\n' +
    '│  ' + p + 'tk https://tiktok.com/...\n' +
    '│\n' +
    '╰──〔 𝐁𝐄𝐀𝐓𝐑𝐈𝐙 𝐁𝐎𝐓 〕──╯'
  );
}

function buildFancy(p) {
  const orn = 'ঔৣֳ̤᷈͜͝͡';
  return (
    '*╔═══━─❦ۜ✯ۣۜৡ ✧ ❖ ✧ ৡۣۜ✯ۜ─━━═╗*\n' +
    '*║*  *╭━━✯ ❖ 𝐌𝐄𝐍𝐔 𝐃𝐎𝐖𝐍𝐋𝐎𝐀𝐃 ❖ ✯━━╮*\n' +
    '*║*  *│*\n' +
    '*║*  *│  ' + orn + '📥 𝐃𝐎𝐖𝐍𝐋𝐎𝐀𝐃*\n' +
    '*║*  *│*\n' +
    '*║*  *├─ 🔍 𝐏𝐄𝐒𝐐𝐔𝐈𝐒𝐀*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'yt*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'play*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'spotify*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'ytplay*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'ytplay2*\n' +
    '*║*  *│*\n' +
    '*║*  *├─ ▶️ 𝐘𝐎𝐔𝐓𝐔𝐁𝐄*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'ytd* (video)\n' +
    '*║*  *│  ' + orn + ' ' + p + 'yta* (audio)\n' +
    '*║*  *│  ' + orn + ' ' + p + 'vta* (video→audio)\n' +
    '*║*  *│*\n' +
    '*║*  *├─ 📱 𝐑𝐄𝐃𝐄𝐒*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'tk* | ' + p + 'ig*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'fb* | ' + p + 'kw*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'pin* | ' + p + 'pint*\n' +
    '*║*  *│*\n' +
    '*║*  *├─ 📦 𝐀𝐑𝐐𝐔𝐈𝐕𝐎𝐒*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'multidl*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'mediafire*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'gdrive*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'capcut*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'fdroid*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'gerarlink*\n' +
    '*║*  *│*\n' +
    '*║*  *├─ 🎤 𝐀𝐔𝐃𝐈𝐎*\n' +
    '*║*  *│  ' + orn + ' ' + p + 'crad* / ' + p + 'criaraudio*\n' +
    '*║*  *│*\n' +
    '*║*  *╰━━━ঔৣ͡➳ ✦ ❖ ✦ ➳ঔৣ͡━━━╯*\n' +
    '*╚══━━❦ۜ✯ۣۜৡ ✧ ❖ ✧ ৡۣۜ✯ۜ─━━══╝*\n' +
    '\n> 💡 Ex: *' + p + 'ytplay nome da musica*'
  );
}

module.exports = {
  name: 'menudownload',
  aliases: ['menudl', 'menubaixar', 'downloadmenu', 'menudown', 'menu-download', 'menu_download', 'downloads'],
  category: 'utilidades',
  description: 'Menu de downloads',
  async handler(ctx) {
    const p = getPrefix(ctx);
    const useFancy = ctx && (ctx.prefix === '!' || String(ctx.prefix || '') === '!');
    let text;
    try {
      // se existir theme e for !, usa visual fancy
      if (useFancy) {
        text = buildFancy(p);
      } else {
        text = buildClassic(p);
      }
    } catch (_) {
      text = buildClassic(p);
    }

    const opts = {};
    if (ctx.sender) opts.mentions = [ctx.sender];

    try {
      if (typeof ctx.reply === 'function') {
        return await ctx.reply(text, opts);
      }
      const jid = ctx.jid || ctx.chatId || (ctx.msg && ctx.msg.key && ctx.msg.key.remoteJid);
      if (ctx.sock && jid) {
        return await ctx.sock.sendMessage(jid, { text, ...opts });
      }
    } catch (e) {
      try { return await ctx.reply(text); } catch (_) {}
    }
  }
};
