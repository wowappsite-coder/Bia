/**
 * Pagamentos M-Pesa / E-Mola / M-Kash
 * - Sem config no grupo -> verificacao necessaria
 * - Destino != config -> nao aprovado (sem revelar numeros)
 * - TXID reutilizado -> nao aprovado
 * - Comprovativo com mais de 24h -> nao aprovado
 * - Destino confere e fresco -> aprovado
 */

const { getDb } = require('../database');

function digits9(s) {
  const d = String(s || '').replace(/\D/g, '');
  return d.length >= 9 ? d.slice(-9) : d;
}

function normTxid(s) {
  return String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
}

function getGroupPayNumber(groupJid) {
  if (!groupJid) return '';
  try {
    const db = getDb();
    for (const q of [
      "SELECT value FROM group_settings WHERE group_jid = ? AND key = 'payment_number' LIMIT 1",
      "SELECT value FROM group_settings WHERE group_id = ? AND key = 'payment_number' LIMIT 1"
    ]) {
      try {
        const row = db.prepare(q).get(groupJid);
        if (row && row.value) return String(row.value);
      } catch (_) {}
    }
    for (const q of [
      'SELECT payment_number FROM groups WHERE jid = ?',
      'SELECT payment_number FROM groups WHERE id = ?'
    ]) {
      try {
        const g = db.prepare(q).get(groupJid);
        if (g && g.payment_number) return String(g.payment_number);
      } catch (_) {}
    }
  } catch (e) {
    console.error('[pay] getGroupPayNumber', e.message);
  }
  return '';
}

function txidAlreadyUsed(txid) {
  const id = normTxid(txid);
  if (!id) return false;
  try {
    const db = getDb();
    const all = db
      .prepare('SELECT transaction_id FROM payments WHERE transaction_id IS NOT NULL')
      .all();
    for (const r of all) {
      const x = normTxid(r.transaction_id);
      if (!x) continue;
      if (x === id) return true;
      if (x.length === id.length && x.length >= 8) {
        let same = 0;
        for (let i = 0; i < x.length; i++) if (x[i] === id[i]) same++;
        if (same / x.length >= 0.9) return true;
      }
    }
  } catch (e) {
    console.error('[pay] txid', e.message);
  }
  return false;
}

/** Parse data/hora do comprovativo (MZ). Retorna Date ou null */
function parsePaymentWhen(dateStr, timeStr, raw) {
  const text = String(raw || '');
  let d = dateStr || null;
  let t = timeStr || null;

  // 16/09/2026 | 16/9/26 | 16-09-2026
  if (!d) {
    const m = text.match(/(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})/);
    if (m) d = m[1] + '/' + m[2] + '/' + m[3];
  }
  // 07:10:56 | 9:20 AM | 09:20
  if (!t) {
    const m = text.match(/(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?/i);
    if (m) {
      let hh = parseInt(m[1], 10);
      const mm = m[2];
      const ss = m[3] || '00';
      const ap = (m[4] || '').toUpperCase();
      if (ap === 'PM' && hh < 12) hh += 12;
      if (ap === 'AM' && hh === 12) hh = 0;
      t = String(hh).padStart(2, '0') + ':' + mm + ':' + ss;
    }
  }

  if (!d) return null;
  const parts = String(d).split(/[\/\-.]/);
  if (parts.length < 3) return null;
  let day = parseInt(parts[0], 10);
  let month = parseInt(parts[1], 10);
  let year = parseInt(parts[2], 10);
  if (year < 100) year += 2000;
  if (!day || !month || !year) return null;

  let hh = 12, mm = 0, ss = 0;
  if (t) {
    const tp = t.split(':');
    hh = parseInt(tp[0], 10) || 0;
    mm = parseInt(tp[1], 10) || 0;
    ss = parseInt(tp[2], 10) || 0;
  }

  const dt = new Date(year, month - 1, day, hh, mm, ss);
  if (isNaN(dt.getTime())) return null;
  return dt;
}

function isOlderThan24h(dateStr, timeStr, raw) {
  const dt = parsePaymentWhen(dateStr, timeStr, raw);
  if (!dt) return false; // sem data clara: nao bloqueia so por isso
  const age = Date.now() - dt.getTime();
  return age > 24 * 60 * 60 * 1000;
}

function savePayment(row) {
  try {
    const db = getDb();
    try {
      db.prepare(
        `INSERT INTO payments (
          order_id, transaction_id, provider, value_received, fee,
          destination_number, destination_name, date, time, raw_message, status, group_jid
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
      ).run(
        null,
        row.transactionId || null,
        row.provider || null,
        row.value != null ? row.value : null,
        row.fee != null ? row.fee : null,
        row.destinationNumber || null,
        row.destinationName || null,
        row.date || null,
        row.time || null,
        row.raw || null,
        row.status,
        row.groupJid || null
      );
    } catch (_) {
      db.prepare(
        `INSERT INTO payments (
          order_id, transaction_id, provider, value_received, fee,
          destination_number, destination_name, date, time, raw_message, status
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
      ).run(
        null,
        row.transactionId || null,
        row.provider || null,
        row.value != null ? row.value : null,
        row.fee != null ? row.fee : null,
        row.destinationNumber || null,
        row.destinationName || null,
        row.date || null,
        row.time || null,
        row.raw || null,
        row.status
      );
    }
  } catch (e) {
    console.error('[pay] save', e.message);
  }
}

function analyzePayment(paymentData, senderJid, groupJid) {
  const {
    transactionId,
    value,
    fee,
    destinationNumber,
    destinationName,
    provider,
    date,
    time,
    raw
  } = paymentData || {};

  const provName =
    { mpesa: 'M-Pesa', emola: 'E-Mola', mkash: 'M-Kash' }[provider] || provider || 'Desconhecida';

  const configured = getGroupPayNumber(groupJid);
  const dest = digits9(destinationNumber);
  const cfg = digits9(configured);

  const deny = (status, message) => {
    savePayment({
      transactionId,
      value,
      fee,
      destinationNumber,
      destinationName,
      provider,
      date,
      time,
      raw,
      status,
      groupJid
    });
    return { status, message };
  };

  // 1) TXID reutilizado
  if (transactionId && txidAlreadyUsed(transactionId)) {
    return deny(
      'PAGAMENTO_JA_UTILIZADO',
      '❌ *Pagamento nao aprovado*\n\nEste comprovativo ja foi utilizado.'
    );
  }

  // 2) Mais de 24h
  if (isOlderThan24h(date, time, raw)) {
    return deny(
      'PAGAMENTO_INVALIDO',
      '❌ *Pagamento nao aprovado*\n\nComprovativo expirado (mais de 24 horas).'
    );
  }

  // 3) Sem config no grupo
  if (!cfg) {
    return deny(
      'PAGAMENTO_SUSPEITO',
      '🟡 *VERIFICACAO NECESSARIA*\n\n' +
        'Este grupo nao tem numero de pagamento configurado.\n' +
        'O comprovativo foi registado, mas nao foi aprovado automaticamente.\n\n' +
        'ADM/Owner: *configpagamento mpesa 84XXXXXXX*'
    );
  }

  // 4) Destino nao confere — SEM mostrar numeros
  if (!dest || dest !== cfg) {
    return deny(
      'PAGAMENTO_INVALIDO',
      '❌ *Pagamento nao aprovado*\n\n' +
        'Este comprovativo nao corresponde ao pagamento deste grupo.'
    );
  }

  // 5) Valor invalido / zero
  if (value == null || isNaN(Number(value)) || Number(value) <= 0) {
    return deny(
      'PAGAMENTO_INVALIDO',
      '❌ *Pagamento nao aprovado*\n\nValor do comprovativo invalido.'
    );
  }

  // 6) OK
  const status = 'PAGAMENTO_VALIDO';
  savePayment({
    transactionId,
    value,
    fee,
    destinationNumber,
    destinationName,
    provider,
    date,
    time,
    raw,
    status,
    groupJid
  });

  return {
    status,
    message:
      '💳 *PAGAMENTO APROVADO!*\n\n' +
      '✅\n\n' +
      '💰 Valor: *' +
      Number(value).toFixed(2) +
      ' MT*\n' +
      '🏛️ Operadora: *' +
      provName +
      '*\n' +
      '📱 Numero destino: *' +
      (destinationNumber || configured) +
      '*\n' +
      (date || time
        ? '🕐 Data/Hora: *' + (date || '') + (time ? ' as ' + time : '') + '*\n'
        : '') +
      '🆔 Transacao: *' +
      (transactionId || '?') +
      '*\n\n' +
      '✅ Pagamento confirmado com sucesso!\n\n' +
      '📱 Agora envie o *numero* que vai receber os megas.\n' +
      '⚠️ O numero deve ter *9 digitos* e comecar com *84* ou *85*.\n' +
      'Ex: *852900000*'
  };
}

function formatDetectionReply(paymentData, analysis) {
  return (analysis && analysis.message) || '❌ Pagamento nao aprovado.';
}

module.exports = {
  analyzePayment,
  formatDetectionReply,
  getGroupPayNumber,
  digits9,
  normTxid,
  isOlderThan24h,
  parsePaymentWhen
};
