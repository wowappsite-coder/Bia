  {
    name: 'mute',
    aliases: ['mutar', 'silenciar'],
    category: 'admin',
    description: 'Muta usuario: o bot apaga as mensagens dele no grupo',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      const g = ctx.group;
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      function addMuteId(arr, id) {
        if (!id) return;
        if (!arr.includes(id)) arr.push(id);
      }
      addMuteId(mutados, target);
      // se a mensagem citada tiver participant alternativo
      try {
        const q = ctx.msg && ctx.msg.message && (
          (ctx.msg.message.extendedTextMessage && ctx.msg.message.extendedTextMessage.contextInfo) ||
          (ctx.msg.message.imageMessage && ctx.msg.message.imageMessage.contextInfo)
        );
        if (q && q.participant) addMuteId(mutados, q.participant);
        if (q && q.participantPn) addMuteId(mutados, q.participantPn);
      } catch (_) {}
      db.updateGroup(ctx.jid, { mutados: JSON.stringify(mutados) });
      await ctx.reply('🔇 Usuário mutado.\nO bot vai *apagar* as mensagens dele neste grupo.\n_(O bot precisa ser admin)_', { mentions: [target] });
    }
  },
  {
    name: 'desmute',
    aliases: ['desmutar', 'unmute'],
    category: 'admin',
    description: 'Desmuta usuário',
    groupOnly: true,
    adminOnly: true,
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const target = await getTargetUser(ctx);
      if (!target) return;
      const g = ctx.group;
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      const dig = String(target).split('@')[0].split(':')[0].replace(/\D/g, '');
      mutados = mutados.filter(function (j) {
        if (j === target) return false;
        const d = String(j).split('@')[0].split(':')[0].replace(/\D/g, '');
        if (dig && d && (d === dig || d.endsWith(dig) || dig.endsWith(d))) return false;
        return true;
      });
      db.updateGroup(ctx.jid, { mutados: JSON.stringify(mutados) });
      await ctx.reply('🔊 Usuário desmutado.', { mentions: [target] });
    }
  },
