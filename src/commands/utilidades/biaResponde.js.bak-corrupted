/**
 * biaresponde — responde a mensagem CITADA com a IA Beatriz
 * Isolado: nao altera o comando bia/ia existente.
 */

const path = require('path');

function getQuotedInfo(ctx) {
  try {
    const msg = ctx.msg || ctx.message || {};
    const m = msg.message || {};
    const ctxInfo =
      (m.extendedTextMessage && m.extendedTextMessage.contextInfo) ||
      (m.imageMessage && m.imageMessage.contextInfo) ||
      (m.videoMessage && m.videoMessage.contextInfo) ||
      (m.documentMessage && m.documentMessage.contextInfo) ||
      (m.buttonsResponseMessage && m.buttonsResponseMessage.contextInfo) ||
      null;

    if (!ctxInfo || !ctxInfo.quotedMessage) return null;

    const q = ctxInfo.quotedMessage;
    let text = '';
    if (q.conversation) text = q.conversation;
    else if (q.extendedTextMessage && q.extendedTextMessage.text) text = q.extendedTextMessage.text;
    else if (q.imageMessage && q.imageMessage.caption) text = q.imageMessage.caption;
    else if (q.videoMessage && q.videoMessage.caption) text = q.videoMessage.caption;
    else if (q.documentMessage && q.documentMessage.caption) text = q.documentMessage.caption;
    else if (q.buttonsMessage && q.buttonsMessage.contentText) text = q.buttonsMessage.contentText;
    else text = '[mensagem sem texto legivel]';

    const participant = ctxInfo.participant || ctxInfo.remoteJid || '';
    let name = '';
    try {
      if (ctxInfo.participant && ctx.sock) {
        // pushName nem sempre existe no quote
      }
    } catch (_) {}
    // tenta nome do notify / pushName do contexto
    name = (ctxInfo.notify || ctxInfo.pushName || participant.split('@')[0] || 'alguem').toString();

    return { text: String(text || '').trim(), participant, name };
  } catch (e) {
    return null;
  }
}

async function callExistingBia(ctx, prompt) {
  // Tenta reutilizar handler do bia se existir no registry
  try {
    const registry = require('../registry');
    const get = registry.get || registry.getCommand;
    let cmd = null;
    if (typeof get === 'function') cmd = get('bia') || get('ia');
    if (!cmd && registry.commands) {
      cmd = registry.commands.get && (registry.commands.get('bia') || registry.commands.get('ia'));
    }
    if (cmd && typeof cmd.handler === 'function') {
      // simula args com o prompt
      const oldArgs = ctx.args;
      const oldText = ctx.text;
      ctx.args = prompt.split(/\s+/);
      ctx.text = prompt;
      ctx.body = prompt;
      try {
        await cmd.handler(ctx);
        return true;
      } finally {
        ctx.args = oldArgs;
        ctx.text = oldText;
      }
    }
  } catch (e) {
    console.error('[biaresponde] reuse bia failed', e.message);
  }
  return false;
}

async function callGroqDirect(prompt) {
  const keys = [];
  if (process.env.GROQ_API_KEY) keys.push(process.env.GROQ_API_KEY);
  for (let i = 1; i <= 12; i++) {
    const k = process.env['GROQ_API_KEY_' + i] || process.env['GROQ_KEY_' + i];
    if (k) keys.push(k);
  }
  // multi key string
  if (process.env.GROQ_KEYS) {
    String(process.env.GROQ_KEYS).split(/[,;\s]+/).forEach(function (k) {
      if (k && k.length > 10) keys.push(k.trim());
    });
  }
  if (!keys.length) throw new Error('Sem GROQ_API_KEY no .env');

  const model = process.env.GROQ_MODEL || 'llama-3.3-70b-versatile';
  let lastErr = null;
  for (let i = 0; i < keys.length; i++) {
    try {
      const res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
        method: 'POST',
        headers: {
          Authorization: 'Bearer ' + keys[i],
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          model: model,
          temperature: 0.8,
          max_tokens: 600,
          messages: [
            {
              role: 'system',
              content:
                'Tu es a Beatriz (Bia), assistente do WhatsApp. Responde em portugues de Mocambique/Brasil, natural, clara e util. Nao mostres raciocinio interno. Responde em nome da Bia, como se falasses diretamente com a pessoa ou sobre a mensagem dela, conforme o pedido do utilizador.'
            },
            { role: 'user', content: prompt }
          ]
        })
      });
      if (!res.ok) {
        lastErr = new Error('Groq HTTP ' + res.status);
        continue;
      }
      const data = await res.json();
      const out = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
      if (out) return String(out).trim();
    } catch (e) {
      lastErr = e;
    }
  }
  throw lastErr || new Error('Groq falhou');
}

module.exports = [
  {
    name: 'biaresponde',
    aliases: ['bia responde', 'respondebia', 'biareply', 'explain', 'explicapra'],
    category: 'utilidades',
    description: 'Bia responde a mensagem citada',
    handler: async function (ctx) {
      const quoted = getQuotedInfo(ctx);
      if (!quoted || !quoted.text) {
        return ctx.reply(
          '💜 *Bia*\n\nResponde a uma mensagem e usa:\n*biaresponde*\nou\n*bia responde*\n\nAssim eu leio o que a pessoa escreveu e respondo no contexto.'
        );
      }

      const extra = (ctx.args && ctx.args.length) ? ctx.args.join(' ') : '';
      const who = quoted.name || 'a pessoa';
      const prompt =
        'O utilizador pediu que eu responda com base nesta mensagem citada do WhatsApp.\n' +
        'Autor da mensagem citada: ' + who + '\n' +
        'Mensagem citada:\n"""' + quoted.text + '"""\n' +
        (extra
          ? 'Pedido extra do utilizador: ' + extra + '\n'
          : 'Pedido: gera uma resposta adequada, util e natural para essa pessoa / sobre essa mensagem.\n') +
        'Responde so o texto final, em portugues, como a Bia.';

      try {
.catch(function () {});
      } catch (_) {}

      try {
        // 1) tenta IA direta Groq (nao depende do handler bia)
        const answer = await callGroqDirect(prompt);
        await ctx.reply('💜 *Beatriz*\n\n' + answer);
      } catch (e1) {
        // 2) fallback: reutiliza comando bia se existir
        const ok = await callExistingBia(ctx, prompt);
        if (!ok) {
          await ctx.reply(
            '❌ Nao consegui gerar resposta.\n' +
              (e1 && e1.message ? e1.message : '') +
              '\nVerifica GROQ_API_KEY no .env'
          );
        }
      }
    }
  }
];
