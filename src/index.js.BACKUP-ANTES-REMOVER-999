    const candidates = [
      senderJid,
      msgKey && msgKey.participant,
      msgKey && msgKey.participantPn,
      msgKey && msgKey.remoteJidAlt
    ].filter(Boolean);
    const keys = candidates.map(muteIdKey).filter(Boolean);
    for (let i = 0; i < list.length; i++) {
      const mk = muteIdKey(list[i]);
      if (!mk) continue;
      if (list[i] === senderJid) return true;
      for (let k = 0; k < keys.length; k++) {
        if (keys[k] && (keys[k] === mk || keys[k].endsWith(mk) || mk.endsWith(keys[k]))) return true;
      }
    }
    return false;
  }


