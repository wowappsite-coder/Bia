'use strict';
/**
 * PARTE 2/4 — Docs, programacao, ciencia extra
 */
function safeProviders() {
  try { return require('../../services/search/providers'); } catch (e) { return null; }
}
function safeEngine() {
  try { return require('../../services/search/engine'); } catch (e) { return null; }
}

async function unavailable(ctx, name) {
  return ctx.reply(
    '⚠️ *' + name + '* nao disponivel automaticamente.\n' +
    'Usa *pesquisa <texto>* ou *menupesquisa*.'
  );
}

async function doActive(ctx, preferred) {
  const q = (ctx.args || []).join(' ').trim();
  if (!q) return ctx.reply('Ex: *' + preferred + ' async await*');
  const prov = safeProviders();
  const engine = safeEngine();
  try {
    if (preferred === 'mdn' && prov && prov.mdn) {
      const r = await prov.mdn(q);
      return ctx.reply('💻 *MDN*\n' + String(r.summary || '').slice(0, 900));
    }
    if (preferred === 'npm' && prov && prov.npmSearch) {
      const r = await prov.npmSearch(q);
      return ctx.reply('📦 *npm*\n' + String(r.summary || '').slice(0, 900));
    }
    if (preferred === 'arxiv' && prov && prov.arxiv) {
      const r = await prov.arxiv(q);
      return ctx.reply('🔬 *arXiv*\n' + String(r.summary || '').slice(0, 900));
    }
    if (preferred === 'wikipedia' && prov && prov.wikipedia) {
      const r = await prov.wikipedia(q);
      return ctx.reply('📖 *Wikipedia*\n' + String(r.summary || '').slice(0, 900) + (r.url ? '\n🔗 ' + r.url : ''));
    }
    if (engine && engine.searchWeb) {
      const r = await engine.searchWeb(q);
      if (r) {
        return ctx.reply('🔎 *' + (r.source || 'Pesquisa') + '*\n' + String(r.summary || '').slice(0, 900) + (r.url ? '\n🔗 ' + r.url : ''));
      }
    }
  } catch (e) {
    return ctx.reply('❌ Falha em *' + preferred + '*. Tenta *pesquisa ' + q + '*.');
  }
  return unavailable(ctx, preferred);
}

const LIST = [
  // Docs / programacao
  ['w3schools', 'W3Schools'],
  ['stackoverflow', 'Stack Overflow'],
  ['stack', 'Stack Overflow'],
  ['github', 'GitHub'],
  ['gitlab', 'GitLab'],
  ['npm', 'npm'],
  ['pypi', 'PyPI'],
  ['huggingface', 'Hugging Face'],
  ['hf', 'Hugging Face'],
  ['kaggle', 'Kaggle'],
  ['wolfram', 'WolframAlpha'],
  ['wolframalpha', 'WolframAlpha'],
  // Ciencia / academic
  ['consensus', 'Consensus'],
  ['elicit', 'Elicit'],
  ['researchrabbit', 'ResearchRabbit'],
  ['scite', 'Scite'],
  ['perplexityacademic', 'Perplexity Academic'],
  ['semantic', 'Semantic Scholar'],
  ['core', 'CORE'],
  ['openalex2', 'OpenAlex'],
  // Enciclopedias / bibliotecas
  ['britannica', 'Britannica'],
  ['wiktionary', 'Wiktionary'],
  ['commons', 'Wikimedia Commons'],
  ['archiveorg', 'Internet Archive'],
  ['dpla', 'Digital Public Library of America'],
  ['europeana2', 'Europeana'],
  ['smithsonian', 'Smithsonian'],
  ['metmuseum', 'Met Museum'],
  ['rijks', 'Rijksmuseum'],
  ['wellcome', 'Wellcome Collection'],
  // Dev extras
  ['caniuse', 'Can I Use'],
  ['devdocs', 'DevDocs'],
  ['readthedocs', 'Read the Docs'],
  ['crates', 'crates.io'],
  ['packagist', 'Packagist']
];

const ACTIVE = new Set(['npm', 'mdn', 'arxiv', 'wikipedia', 'commons']);

const cmds = LIST.map(function (pair) {
  const name = pair[0];
  const label = pair[1];
  return {
    name: name,
    aliases: [],
    category: 'utilidades',
    description: 'Pesquisa ' + label,
    async handler(ctx) {
      if (name === 'npm') return doActive(ctx, 'npm');
      if (name === 'commons') return doActive(ctx, 'wikipedia');
      if (ACTIVE.has(name)) return doActive(ctx, name);
      return unavailable(ctx, label);
    }
  };
});

module.exports = cmds;
