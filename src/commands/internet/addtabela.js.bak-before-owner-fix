const { isOwnerJid } = require('../../utils/ownerCheck');
/**
 * addtabela — tabela livre por grupo (preserva linhas)
 */
const { getGroupSetting, setGroupSetting, scopeGroup } = require('../../database');

async function canManage(ctx) {
  try {
    if (typeof ctx.isOwner = (== 'function' && ctx.isOwner()) return true) || (typeof isOwnerJid==='function' && isOwnerJid(ctx.sender||ctx.senderJid||ctx.participant||'')); /* BTZ_OWNER_ASSIGN */
    if (typeof ctx.isBotAdmin === 'function' && ctx.isBotAdmin()) return true;
    if (typeof ctx.isGroupAdmin === 'function' && (await ctx.isGroupAdmin())) return true;
  } catch (_) {}
  return false;
}

function getRawBody(msg) {
  if (!msg || !msg.message) return '';
  const m = msg.message;
  return (
    m.conversation ||
    (m.extendedTextMessage && m.extendedTextMessage.text) ||
    (m.imageMessage && m.imageMessage.caption) ||
    (m.videoMessage && m.videoMessage.caption) ||
    ''
  );
}

function stripCommand(raw) {
  let t = String(raw || '');
  // remove so a primeira palavra (comando), mantem o resto COM quebras de linha
  t = t.replace(/^\s*[.!#]?addtabela\b\s*/i, '');
  t = t.replace(/^\s*[.!#]?settabela\b\s*/i, '');
  t = t.replace(/^\s*[.!#]?salvartabela\b\s*/i, '');
  t = t.replace(/^\s*[.!#]?colartabela\b\s*/i, '');
  return t.replace(/^\s*\n/, ''); // tira so a linha vazia a seguir ao comando
}

function getQuotedText(msg) {
  try {
    const m = msg && msg.message;
    const ci =
      (m && m.extendedTextMessage && m.extendedTextMessage.contextInfo) ||
      (m && m.imageMessage && m.imageMessage.contextInfo) ||
      null;
    const q = ci && ci.quotedMessage;
    if (!q) return '';
    return (
      q.conversation ||
      (q.extendedTextMessage && q.extendedTextMessage.text) ||
      (q.imageMessage && q.imageMessage.caption) ||
      ''
    );
  } catch (_) {
    return '';
  }
}

module.exports = [
  {
    name: 'addtabela',
    aliases: ['settabela', 'salvartabela', 'colartabela'],
    category: 'internet',
    description: 'Cola qualquer tabela neste grupo (preserva formato)',
    groupOnly: true,
    handler: async (ctx) => {
      if (!(await canManage(ctx))) {
        return ctx.reply('❌ Só admin/dono.');
      }
      const g = scopeGroup(ctx);

      // 1) corpo RAW da mensagem (com \n)
      let raw = stripCommand(getRawBody(ctx.msg));

      // 2) se quase vazio, tenta mensagem citada (tabela completa)
      if (!raw || raw.trim().length < 3) {
        raw = getQuotedText(ctx.msg);
      }

      // 3) fallback ctx.text (pode vir sem quebras)
      if (!raw || raw.trim().length < 3) {
        raw = (ctx.text || '').trim();
      }

      if (!raw || raw.trim().length < 3) {
        return ctx.reply(
          '📋 *addtabela*\n\n' +
            'Escreve assim (tudo na mesma mensagem):\n\n' +
            'addtabela\n' +
            '✨ MEGA PROMO ✨\n' +
            '100MB ➤ 4MT\n' +
            '1GB ➤ 24MT\n\n' +
            'Ou *responde* à mensagem da tabela com:\n*addtabela*'
        );
      }

      // normaliza so \r\n -> \n (nao junta linhas)
      raw = String(raw).replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();

      setGroupSetting(g, 'custom_tabela', raw);
      await ctx.reply(
        '✅ Tabela salva neste grupo (' + raw.split('\n').length + ' linhas).\n' +
          'Use *vertabela* / *megas* / *catalogo* para ver.'
      );
    }
  },
  {
    name: 'deltabela',
    aliases: ['removetabela', 'apagartabela'],
    category: 'internet',
    description: 'Remove tabela livre do grupo',
    groupOnly: true,
    handler: async (ctx) => {
      if (!(await canManage(ctx))) {
        return ctx.reply('❌ Só admin/dono.');
      }
      setGroupSetting(scopeGroup(ctx), 'custom_tabela', '');
      await ctx.reply('🗑️ Tabela livre removida deste grupo.');
    }
  },
  {
    name: 'vertabela',
    aliases: [
      't',
      'T',
      'net',
      'Net',
      'NET',
      'catalogo',
      'catálogo',
      'megas',
      'Megas',
      'MEGAS',
      'mostrartabela',
      'tabelalivre'
    ],
    category: 'internet',
    description: 'Mostra a tabela livre deste grupo',
    handler: async (ctx) => {
      const g = scopeGroup(ctx);
      let custom = '';
      try {
        custom = getGroupSetting(g, 'custom_tabela', '') || '';
      } catch (_) {}

      custom = String(custom).replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();

      if (!custom) {
        return ctx.reply(
          '📋 Sem tabela neste grupo.\n' +
            'Admin: use *addtabela* e cole a tabela com quebras de linha.'
        );
      }

      // envia em blocos se for muito grande (WhatsApp \~4000)
      if (custom.length <= 3500) {
        return ctx.reply(custom);
      }
      const parts = [];
      let buf = '';
      const lines = custom.split('\n');
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if ((buf + line + '\n').length > 3400) {
          parts.push(buf.trim());
          buf = '';
        }
        buf += line + '\n';
      }
      if (buf.trim()) parts.push(buf.trim());
      for (let p = 0; p < parts.length; p++) {
        await ctx.reply(parts[p]);
      }
    }
  }
];
