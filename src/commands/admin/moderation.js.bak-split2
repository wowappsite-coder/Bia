/**
 * Comandos de administração de grupo
 */

const db = require('../../database');

function formatRegrasText(raw) {
  if (!raw) return '';
  var t = String(raw);
  t = t.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
  t = t.replace(/^\s*setregras\s*/i, '');
  t = t.replace(/^\s*!?\s*descgp\s*/i, '');

  // Quebra ANTES de 1• 2• 3• ou 1. 2. 3. (ASCII)
  t = t.replace(/(\d+)\s*[\u2022\u00B7\u2027\u2219\u25CF\u25E6]\s*/g, '\n\n$1. ');
  t = t.replace(/(\d+)\s*[.)]\s+/g, '\n\n$1. ');
  t = t.replace(/(\d+)\s*[\-]\s+/g, '\n\n$1. ');

  // Emojis de item
  t = t.replace(/\s*(\u2705|\u2611|\u2714|\u274C|\uD83D\uDEAB|\u26D4|\uD83D\uDCCC)/g, '\n\n$1');
  t = t.replace(/\s*(✅|❌|🚫|⛔|📌|💡|📩|✉️)/g, '\n\n$1');

  t = t.split('\n').map(function (l) { return l.trim(); }).filter(function (l) {
    return l.length > 0;
  }).join('\n\n');

  return t.trim();
}





async function requireGroupAdmin(ctx) {
  if (!ctx.isGroup) {
    await ctx.reply('❌ Apenas em grupos.');
    return false;
  }
  const isAdmin = await ctx.isGroupAdmin() || ctx.isOwner() || ctx.isBotAdmin();
  if (!isAdmin) {
    await ctx.reply('❌ Apenas administradores.');
    return false;
  }
  return true;
}

async function getTargetUser(ctx) {
  const target = ctx.getMentionedOrQuoted();
  if (!target) {
    await ctx.reply('❌ Marque ou responda a mensagem do usuário.');
    return null;
  }
  return target;
}

