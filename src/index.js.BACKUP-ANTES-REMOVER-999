function isCommandBlocked(ctx, cmdName) {
  if (!cmdName) return false;
  try {
    if (ctx.isOwner && ctx.isOwner()) return false;
  } catch (_) {}
  const name = String(cmdName).toLowerCase();
  // global
  try {
    const { getSetting } = require('./database');
    let glob = [];
    try { glob = JSON.parse(getSetting('blocked_cmds_global', '[]') || '[]'); } catch (_) {}
    if (Array.isArray(glob) && (glob.includes(name) || glob.includes(cmdName))) return true;
  } catch (_) {}
  // grupo
  if (ctx.isGroup) {
    try {
      const g = ctx.group;
      let blocked = [];
      try { blocked = JSON.parse((g && g.blocked_cmds) || '[]'); } catch (_) {}
      if (Array.isArray(blocked) && (blocked.includes(name) || blocked.includes(cmdName))) return true;
    } catch (_) {}
  }
  return false;
}

