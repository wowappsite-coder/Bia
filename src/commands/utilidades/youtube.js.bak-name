/**
 * YouTube download — yt (video) / yta (audio)
 * Limite: 50MB | Requer: yt-dlp + ffmpeg
 */
const { execFile } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { promisify } = require('util');
const execFileAsync = promisify(execFile);

const MAX_BYTES = 50 * 1024 * 1024; // 50MB
const MAX_MB = 50;

function tmpDir() {
  const d = path.join(os.tmpdir(), 'beatriz_yt_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8));
  fs.mkdirSync(d, { recursive: true });
  return d;
}

function isYoutubeUrl(text) {
  if (!text) return false;
  return /(?:youtube\.com|youtu\.be|youtube-nocookie\.com)/i.test(text);
}

function extractUrl(text) {
  if (!text) return null;
  const m = String(text).match(/https?:\/\/[^\s<>"']+/i);
  if (!m) return null;
  return m[0].replace(/[)\].,;]+$/, '');
}

async function whichYtdlp() {
  const candidates = ['yt-dlp', 'yt-dlp_linux', path.join(process.env.HOME || '', '.local/bin/yt-dlp')];
  for (const c of candidates) {
    try {
      await execFileAsync(c, ['--version'], { timeout: 8000 });
      return c;
    } catch (_) {}
  }
  return null;
}

function findOutputFile(dir) {
  const files = fs.readdirSync(dir).map((f) => path.join(dir, f));
  const media = files.filter((f) => /\.(mp4|m4a|mp3|webm|mkv|opus|ogg)$/i.test(f));
  if (!media.length) return null;
  media.sort((a, b) => fs.statSync(b).size - fs.statSync(a).size);
  return media[0];
}

function cleanup(dir) {
  try {
    if (!dir || !fs.existsSync(dir)) return;
    for (const f of fs.readdirSync(dir)) {
      try { fs.unlinkSync(path.join(dir, f)); } catch (_) {}
    }
    fs.rmdirSync(dir);
  } catch (_) {}
}

async function download(url, mode) {
  const bin = await whichYtdlp();
  if (!bin) {
    return { ok: false, error: 'yt-dlp nao encontrado.\nNo Termux: pip install -U yt-dlp' };
  }

  const dir = tmpDir();
  const outTpl = path.join(dir, 'media.%(ext)s');

  const args = [
    '--no-playlist',
    '--no-warnings',
    '--newline',
    '-o', outTpl,
    '--max-filesize', MAX_MB + 'M'
  ];

  if (mode === 'audio') {
    args.push(
      '-x',
      '--audio-format', 'mp3',
      '--audio-quality', '0',
      '-f', 'bestaudio/best'
    );
  } else {
    // video: prefer mp4 ate 50MB
    args.push(
      '-f', 'bv*[filesize<50M]+ba/b[filesize<50M]/b',
      '--merge-output-format', 'mp4'
    );
  }

  args.push(url);

  try {
    await execFileAsync(bin, args, {
      timeout: 180000,
      maxBuffer: 8 * 1024 * 1024,
      env: process.env
    });
  } catch (e) {
    const msg = (e.stderr || e.message || '').toString();
    cleanup(dir);
    if (/max.filesize|File is larger|too large/i.test(msg)) {
      return { ok: false, error: 'Arquivo maior que ' + MAX_MB + 'MB. Escolhe outro video mais curto/leve.' };
    }
    if (/Private|unavailable|not available|Sign in/i.test(msg)) {
      return { ok: false, error: 'Video indisponivel ou privado.' };
    }
    return { ok: false, error: 'Falha no download.\n' + msg.slice(0, 180) };
  }

  const file = findOutputFile(dir);
  if (!file || !fs.existsSync(file)) {
    cleanup(dir);
    return { ok: false, error: 'Download falhou (sem ficheiro). Tenta outro link.' };
  }

  const size = fs.statSync(file).size;
  if (size > MAX_BYTES) {
    cleanup(dir);
    return { ok: false, error: 'Arquivo final > ' + MAX_MB + 'MB. Nao enviado.' };
  }
  if (size < 1000) {
    cleanup(dir);
    return { ok: false, error: 'Arquivo vazio/invalido.' };
  }

  const buf = fs.readFileSync(file);
  const ext = path.extname(file).toLowerCase();
  cleanup(dir);
  return { ok: true, buffer: buf, size, ext, fileName: path.basename(file) };
}

function getInputUrl(ctx) {
  const fromArgs = (ctx.args || []).join(' ').trim();
  let url = extractUrl(fromArgs) || extractUrl(ctx.text || '') || extractUrl(ctx.parsed && ctx.parsed.body);
  if (url && isYoutubeUrl(url)) return url;

  // quoted text
  try {
    const q = ctx.quoted;
    if (q) {
      const qt =
        q.conversation ||
        (q.extendedTextMessage && q.extendedTextMessage.text) ||
        (q.imageMessage && q.imageMessage.caption) ||
        '';
      url = extractUrl(qt);
      if (url && isYoutubeUrl(url)) return url;
    }
  } catch (_) {}
  return null;
}

async function runDownload(ctx, mode) {
  const url = getInputUrl(ctx);
  if (!url) {
    return ctx.reply(
      '╭──〔 ▶️ YOUTUBE 〕──╮\n' +
        '> Uso:\n' +
        '◈┃ *yt <link>* — video\n' +
        '◈┃ *yta <link>* — audio\n' +
        '╰──────────────────╯\n' +
        '> Limite: *' + MAX_MB + 'MB*\n' +
        '> Ou responde a uma msg com o link.'
    );
  }

  await ctx.reply(mode === 'audio' ? '🎧 A baixar audio...' : '🎬 A baixar video...');

  const result = await download(url, mode);
  if (!result.ok) {
    return ctx.reply('❌ ' + result.error);
  }

  const sizeMb = (result.size / (1024 * 1024)).toFixed(1);

  try {
    if (mode === 'audio') {
      await ctx.sock.sendMessage(
        ctx.jid,
        {
          audio: result.buffer,
          mimetype: 'audio/mpeg',
          fileName: result.fileName || 'audio.mp3',
          ptt: false
        },
        { quoted: ctx.msg }
      );
      await ctx.reply('✅ Audio enviado (' + sizeMb + ' MB)');
    } else {
      await ctx.sock.sendMessage(
        ctx.jid,
        {
          video: result.buffer,
          mimetype: 'video/mp4',
          fileName: result.fileName || 'video.mp4',
          caption: '🎬 YouTube · ' + sizeMb + ' MB (max ' + MAX_MB + 'MB)'
        },
        { quoted: ctx.msg }
      );
    }
  } catch (e) {
    await ctx.reply('❌ Erro ao enviar: ' + (e.message || e).toString().slice(0, 120));
  }
}

module.exports = [
  {
    name: 'yt',
    aliases: ['ytv', 'ytvideo', 'youtube'],
    category: 'utilidades',
    description: 'Baixa video do YouTube (max 50MB)',
    handler: async (ctx) => runDownload(ctx, 'video')
  },
  {
    name: 'yta',
    aliases: ['ytaudio', 'ytaudio', 'mp3yt'],
    category: 'utilidades',
    description: 'Baixa audio do YouTube (max 50MB)',
    handler: async (ctx) => runDownload(ctx, 'audio')
  }
];
