                '📢 *Canal oficial:*\n' +
                'https://whatsapp.com/channel/0029Vb6PhNkATRSjN3udCi26\n\n' +
                '👥 *Grupo oficial:*\n' +
                'https://chat.whatsapp.com/IBGTzlxazMP6DQOckdfZR0'
            }, { quoted: msg }).catch(() => {});
            return;
          }
        }
      }
    }
  }

  // Atualiza user stats (+ contagem por tipo de midia) — BEATRIZ_STATS_FIX
  try {
    const scopeG = (jid && String(jid).endsWith('@g.us')) ? jid : 'global';
    // preferir numero real (Pn) quando existir, senao participant/lid
    const statJid = msg.key.participantPn || msg.key.participant || sender;
    const user = getUser(statJid, scopeG);
    // desembrulha ephemeral / viewOnce
    let m = msg.message || {};
    try {
      if (m.ephemeralMessage && m.ephemeralMessage.message) m = m.ephemeralMessage.message;
      if (m.viewOnceMessage && m.viewOnceMessage.message) m = m.viewOnceMessage.message;
      if (m.viewOnceMessageV2 && m.viewOnceMessageV2.message) m = m.viewOnceMessageV2.message;
      if (m.documentWithCaptionMessage && m.documentWithCaptionMessage.message) m = m.documentWithCaptionMessage.message;
    } catch (_) {}
    const patch = {
      messages: (user.messages || 0) + 1,
      xp: (user.xp || 0) + (config.xpPerMessage || 1),
      level: Math.floor(((user.xp || 0) + (config.xpPerMessage || 1)) / 100) + 1,
      pushname: msg.pushName || user.pushname
    };
    if (m.stickerMessage) patch.msg_stickers = (user.msg_stickers || 0) + 1;
    if (m.imageMessage) patch.msg_images = (user.msg_images || 0) + 1;
    if (m.audioMessage || m.pttMessage) patch.msg_audios = (user.msg_audios || 0) + 1;
    if (m.videoMessage) patch.msg_videos = (user.msg_videos || 0) + 1;
    updateUser(statJid, patch, scopeG);
    // se Pn e participant diferem, espelha no outro jid (LID)
    if (msg.key.participantPn && msg.key.participant && msg.key.participantPn !== msg.key.participant) {
      try {
        const u2 = getUser(msg.key.participant, scopeG);
        const p2 = {
          messages: (u2.messages || 0) + 1,
          xp: (u2.xp || 0) + (config.xpPerMessage || 1),
          level: Math.floor(((u2.xp || 0) + (config.xpPerMessage || 1)) / 100) + 1,
          pushname: msg.pushName || u2.pushname
        };
        if (m.stickerMessage) p2.msg_stickers = (u2.msg_stickers || 0) + 1;
        if (m.imageMessage) p2.msg_images = (u2.msg_images || 0) + 1;
        if (m.audioMessage || m.pttMessage) p2.msg_audios = (u2.msg_audios || 0) + 1;
        if (m.videoMessage) p2.msg_videos = (u2.msg_videos || 0) + 1;
        updateUser(msg.key.participant, p2, scopeG);
      } catch (_) {}
    }
  } catch (e) {
    console.error('[STATS]', e && e.message);
  }

  // Parse
  
  try {
    if (global.BOT_READY_AT && msg.messageTimestamp) {
      const ts = Number(msg.messageTimestamp) * (String(msg.messageTimestamp).length <= 10 ? 1000 : 1);
      if (ts && ts < global.BOT_READY_AT - 3000) return; // BEATRIZ_STABLE_V1
    }
  } catch (_) {}
  const parsed = parseMessage(msg);

  // --- numero megas apos pagamento (84/85 9 digitos) ---
  try {
    const bodyTxt = (parsed && (parsed.text || parsed.body)) || '';
    if (jid.endsWith('@g.us') && bodyTxt) {
      console.log('[PENDING] try number', bodyTxt, 'from', sender);
      const doneNum = await handlePendingNumber(sock, msg, sender, jid, bodyTxt);
      if (doneNum) return;
    }
  } catch (e) { console.error('[PENDING handle]', e); }

  if (!parsed) {
    try {
      const { extractText } = require('./utils/parser');
      const t = extractText(msg) || '';
      if (jid.endsWith('@g.us') && t) {
        const done2 = await handlePendingNumber(sock, msg, sender, jid, t);
        if (done2) return;
      }
    } catch (_) {}
    return;
  }

  // === PREFIX_ONLY_FILTER ===
  try {
    if (parsed && parsed.command && !parsed.hasPrefix && !parsed.isPayment) {
      const j = msg.key.remoteJid;
      if (j && String(j).endsWith('@g.us')) {
        let only = false;
        try {
          const { getGroupSetting } = require('./database');
          const v = getGroupSetting(j, 'prefix_only', '0');
          only = String(v) === '1' || v === 1;
        } catch (_) {}
        if (only) {
          console.log('[PREFIX_ONLY] bloqueado sem prefixo:', parsed.command);
          return;
        }
      }
    }
  } catch (e) {
    console.error('[PREFIX_ONLY]', e && e.message);
  }

// Pagamento sem prefixo
  if (parsed.isPayment && parsed.paymentData) {
    const analysis = analyzePayment(parsed.paymentData, sender, jid.endsWith("@g.us") ? jid : null);
    const reply = formatDetectionReply(parsed.paymentData, analysis);
    await sock.sendMessage(msg.key.remoteJid, { text: reply }, { quoted: msg });
    log('payment', analysis.status, sender, parsed.paymentData);
    try {
      if (analysis.status === 'PAGAMENTO_VALIDO') {
        const pd = parsed.paymentData || {};
        setPendingMegas(msg.key.remoteJid, sender, {
          value: pd.value,
          transactionId: pd.transactionId,
          provider: pd.provider,
          providerName: ({ mpesa: 'M-Pesa', emola: 'E-Mola', mkash: 'M-Kash' })[pd.provider] || pd.provider
        });
      }
    } catch (e) { console.error('[pending megas]', e.message); }
    return;
  }

  try {
    if (jid.endsWith('@g.us') && parsed && !parsed.command && (parsed.text || parsed.body)) {
      const txt = parsed.text || parsed.body || '';
      const done = await handlePendingNumber(sock, msg, sender, jid, txt);
      if (done) return;
    }
  } catch (e) { console.error('[handlePendingNumber]', e.message); }

  if (!parsed.command) return;

  const cmd = registry.get(parsed.command);
  if (!cmd) return;

  // Contexto
  const ctx = new Context(sock, msg, parsed);

  // BEATRIZ_MODOADM_GATE — membros ignorados se modoadm on
  try {
    if (ctx.isGroup) {
      let __modoAdm = false;
      try {
        const { getGroupSetting } = require('./database');
        const v = getGroupSetting(ctx.jid, 'modoadm', '0');
        __modoAdm = v === true || v === 1 || v === '1' || v === 'on' || v === 'true';
      } catch (_) {
        try {
          const { isModoAdmOn } = require('./commands/admin/modoadm');
          __modoAdm = !!isModoAdmOn(ctx.jid);
        } catch (_2) {}
      }
      if (__modoAdm) {
        const __staff =
          (typeof ctx.isOwner === 'function' && ctx.isOwner()) ||
          (typeof ctx.isBotAdmin === 'function' && ctx.isBotAdmin()) ||
          (typeof ctx.isGroupAdmin === 'function' && (await ctx.isGroupAdmin()));
        // permite o proprio comando modoadm para staff (ja coberto); membros: silencio
        if (!__staff) return;
      }
    }
  } catch (__madm) { console.error('modoadm gate', __madm.message); }



  // Checks de permissão
  if (cmd.ownerOnly && !ctx.isOwner()) {
    return ctx.reply('❌ Apenas o dono.');
  }
  if (cmd.botAdminOnly && !ctx.isBotAdmin()) {
    return ctx.reply('❌ Apenas administradores do bot.');
  }
  if (cmd.groupOnly && !ctx.isGroup) {
    return ctx.reply('❌ Apenas em grupos.');
  }
  if (cmd.privateOnly && ctx.isGroup) {
    return ctx.reply('❌ Apenas no privado.');
  }
  if (cmd.adminOnly && ctx.isGroup) {
    const isAdm = await ctx.isGroupAdmin() || ctx.isOwner() || ctx.isBotAdmin();
    if (!isAdm) return ctx.reply('❌ Apenas administradores do grupo.');
  }

  // Comandos bloqueados (grupo + global)
  try {
    if (isCommandBlocked(ctx, cmd.name) || isCommandBlocked(ctx, parsed && parsed.command)) {
      return ctx.reply(pickBlockedCmdMsg());
    }
  } catch (_) {}

  // Mute / grupo extras
  if (ctx.isGroup) {
    try {
      const g = ctx.group;
      // Mute
      let mutados = [];
      try { mutados = JSON.parse(g.mutados || '[]'); } catch {}
      if (mutados.includes(sender)) return;
    } catch {}
  }


  // Modo Internet: so categoria internet (+ excecoes) neste grupo
  try {
    if (ctx.isGroup && !(ctx.isOwner && ctx.isOwner())) {
      const { getGroupSetting } = require('./database');
      const modo = String(getGroupSetting(ctx.jid, 'modo_internet', '0') || '0');
      if (modo === '1') {
        const cat = String((cmd && cmd.category) || '').toLowerCase();
        const nome = String((cmd && cmd.name) || '').toLowerCase();
        const freeNames = [
          'ping', 'menu', 'menuinternet', 'menualuguel', 'aluguel', 'assinatura',
          'planosaluguel', 'owner', 'dono', 'info', 'tabela', 'vertabela', 'net',
          'megas', 'catalogo', 't', 'planos', 'produtos', 'pedido', 'compra',
          'addproduto', 'addtabela', 'deltabela', 'delproduto', 'tabelapadrao',
          'limpartabela', 'configpagamento', 'pagamento', 'modointernet'
        , 'resgatarcodigo', 'redeem', 'usarcodigo', 'ativarcodigo'];
        const okCat = cat === 'internet' || cat === 'aluguel';
        const okName = freeNames.indexOf(nome) >= 0;
        if (!okCat && !okName) {
          return; // modo internet: silencioso
        }
      }
    }
  } catch (e) {
    console.error('[modointernet]', e.message);
  }

  // MEDIA_RATE_LIMIT — 3/5min user, 6/5min adm, owner ilimitado (global por user)
  try {
    if (mediaRateLimit.isHeavyCommand(cmd, parsed && parsed.command)) {
      let role = 'user';
      if (typeof ctx.isOwner === 'function' && ctx.isOwner()) role = 'owner';
      else {
        let isAdm = false;
        try { if (typeof ctx.isBotAdmin === 'function' && ctx.isBotAdmin()) isAdm = true; } catch (_) {}
        try {
          if (!isAdm && ctx.isGroup && typeof ctx.isGroupAdmin === 'function') {
            isAdm = !!(await ctx.isGroupAdmin());
          }
        } catch (_) {}
        if (isAdm) role = 'admin';
      }
      const rl = mediaRateLimit.checkAndConsume(ctx.sender || sender, role);
      if (!rl.ok) {
        return ctx.reply(rl.msg);
      }
    }
  } catch (e) {


  // XP comando
  try {
    const u = ctx.user;
    updateUser(sender, {
      commands_used: (u.commands_used || 0) + 1,
      xp: (u.xp || 0) + config.xpPerCommand
    });
  } catch {}


  // AUTO_REACT_FILTER — so comandos essenciais
  try {
    var essential = {
      menu:1, menudono:1, menuadm:1, menugrupo:1, menuinternet:1, menubn:1,
      menudiversao:1, menustickers:1, menuimagem:1, menuseguranca:1, menuutilidades:1,
      menurpg:1, menuxp:1, menueconomia:1, menualuguel:1, menudownload:1, menumodos:1,
      ping:1, info:1, dono:1, owner:1, aluguel:1, planosaluguel:1, ajuda:1, help:1
    };
    var cname = String((cmd && cmd.name) || (parsed && parsed.command) || '').toLowerCase();
    if (essential[cname] || (cname.indexOf('menu') === 0)) {
      var AUTO_REACT_EMOJIS = require('./utils/autoReactEmojis');
      var emoji = AUTO_REACT_EMOJIS[Math.floor(Math.random() * AUTO_REACT_EMOJIS.length)];
      ctx.react(emoji).catch(function () {});
    }
  } catch (_) {}


  // Executa
  try {
    let mediaWrap = null;
  try { mediaWrap = commandMedia.wrapContext(ctx, cmd.name, (parsed && parsed.args) || [], [cmd.name].concat(cmd.aliases || []).concat([(parsed && parsed.command) || ''])); } catch (_) {}
  
  // BEATRIZ_BUSY_SILENT — se o user ja tem comando pesado a correr, ignora os outros (sem resposta)
  try {
    if (!global.__userBusy) global.__userBusy = {};
    const HEAVY = /^(ytd|yta|ytplay|ytplay2|play|spotify|tk|ig|fb|kw|pin|pint|vk|twitter|twitch|reddit|vimeo|rumble|dailymotion|bilibili|multidl|mediafire|gdrive|capcut|fdroid|anime|dwdanimeep|filme|serie|fs|dwfilme|vta|sticker|s|toimg|gif|pack|gerarlink|crad|criaraudio|pint)$/i;
    const cn = String((cmd && cmd.name) || (parsed && parsed.command) || '');
    const who = String((ctx && (ctx.sender || ctx.senderPn)) || '')
      .replace(/\D/g, '')
      .slice(-12);
    if (who && HEAVY.test(cn)) {
      const now = Date.now();
      // limpeza de locks antigos (> 4 min)
      Object.keys(global.__userBusy).forEach(function (k) {
        if (now - global.__userBusy[k] > 240000) delete global.__userBusy[k];
      });
      if (false && global.__userBusy[who]) {
        return; // silencioso ate o primeiro terminar
      }
      global.__userBusy[who] = now;
      const _origReply = ctx.reply && ctx.reply.bind(ctx);
      const _clear = function () {
        try { delete global.__userBusy[who]; } catch (_) {}
      };
      // libertar lock no fim do handler
      const _run = cmd.handler;
      cmd = Object.assign({}, cmd, {
        handler: async function (c) {
          try {
            return await _run(c);
          } finally {
            _clear();
          }
        }
      });
    }
  } catch (_bs) {
    console.error('[busy silent]', _bs.message);
  }

  
    // === GUARD MENUS SENSIVEIS (adm/dono/modos) ===
    try {
      const _raw = String(typeof bodyText !== 'undefined' ? bodyText : (typeof text !== 'undefined' ? text : (typeof body !== 'undefined' ? body : ''))).trim();
      const _low = _raw.toLowerCase().replace(/^[!#./]+/, '').replace(/\s+/g, '');
      const _cmd = String(typeof cmd !== 'undefined' ? cmd : (typeof command !== 'undefined' ? command : (typeof cmdName !== 'undefined' ? cmdName : ''))).toLowerCase().replace(/\s+/g, '');
      const _name = _cmd || _low.split(/\s+/)[0] || '';
      const _full = (_cmd || _low);
      let _tipo = null;
      if (/^(menuadm|menua|admmenu)$/.test(_name) || _full.includes('menuadm') || /^menuadm/.test(_low) || _raw.toLowerCase().replace(/^[!#./]+/,'').trim().startsWith('menu adm')) _tipo = 'adm';
      if (/^(menudono|menud|donomenu)$/.test(_name) || _full.includes('menudono') || /^menudono/.test(_low) || _raw.toLowerCase().replace(/^[!#./]+/,'').trim().startsWith('menu dono')) _tipo = 'dono';
      if (/^(menumodos|menumodo|modosmenu)$/.test(_name) || _full.includes('menumodos') || /^menumodos/.test(_low) || _raw.toLowerCase().replace(/^[!#./]+/,'').trim().startsWith('menu modos')) _tipo = 'modos';
      if (_tipo) {
        const _ctxGuard = typeof ctx !== 'undefined' ? ctx : {
          reply: async (t) => { try { await sock.sendMessage(jid, { text: t }, { quoted: msg }); } catch(e){} },
          sender: typeof sender !== 'undefined' ? sender : (msg.key.participant || msg.key.remoteJid),
          pushName: msg.pushName || '',
          isOwner: typeof isOwner !== 'undefined' ? isOwner : false,
          isAdmin: typeof isAdmin !== 'undefined' ? isAdmin : (typeof senderIsAdmin !== 'undefined' ? senderIsAdmin : false),
          sock, msg, jid
        };
        // reforcar isOwner / isAdmin a partir de variaveis locais se existirem
        if (typeof isOwner !== 'undefined') _ctxGuard.isOwner = isOwner;
        if (typeof senderIsAdmin !== 'undefined') _ctxGuard.isAdmin = senderIsAdmin;
        if (typeof isGroupAdmin !== 'undefined') _ctxGuard.isAdmin = _ctxGuard.isAdmin || isGroupAdmin;
        const ok = await guardMenu(_ctxGuard, _tipo);
        if (!ok) return;
      }
    } catch (eGuard) { console.log('guardMenu err', eGuard && eGuard.message); }
    // === FIM GUARD ===

    await cmd.handler(ctx);
    try { await commandLinks.sendLink(ctx, cmd.name, cmd.aliases || []); } catch (e3) { console.error('[commandLinks]', e3.message); }
    try { /* SEC_CMD_LOG */ const st = sendQueue.stats(); if (st.burstEvents && st.chainLen > 1) console.log('[SEC] cmd', parsed.command, st); } catch (_) {}
    try {
      const aInfo = commandAudio.resolve(cmd.name, (parsed && parsed.args) || [], [cmd.name].concat(cmd.aliases || []).concat([(parsed && parsed.command) || '']));
      if (aInfo) await commandAudio.sendAudio(ctx, aInfo);
    } catch (e3) { console.error('[commandAudio]', e3.message); }
    try {
      if (mediaWrap && mediaWrap.info && !mediaWrap.used && !mediaWrap.hadError) {
        await commandMedia.sendOnly(ctx, mediaWrap.info);
      }
    } catch (e2) { console.error('[commandMedia]', e2.message); }
  } catch (e) {
    console.error(`[CMD ERROR] ${cmd.name}:`, e);
    log('cmd_error', `${cmd.name}: ${e.message}`, sender);
    await ctx.reply('❌ Erro no comando: ' + (cmd && cmd.name ? cmd.name : '?') + '\n↳ ' + String((e && e.message) || e).slice(0, 120)).catch(function () {});
  }
}

// Start
startBot().catch(e => {
  console.error('Falha ao iniciar:', e);
  process.exit(1);
});

