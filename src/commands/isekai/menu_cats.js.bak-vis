const SUB = {
  personagem: ['iskstatus', 'iskpersonagem', 'iskatributos', 'iskhabilidades', 'iskvidas', 'iskhistorico', 'isktitulos', 'isknivel'],
  aventura: ['isklutar', 'iskboss', 'iskdungeon', 'iskatacar', 'iskusar', 'iskdefender', 'iskfugir', 'iskduelo', 'iskbatalha', 'iskexplorar'],
  inventario: ['iskinventario', 'iskequipar', 'iskdesequipar', 'iskconsumir', 'iskcraft'],
  economia: ['isksaldo', 'iskloja', 'iskcomprar', 'iskvender'],
  profissoes: ['iskprofissoes', 'iskfazenda', 'iskplantar', 'iskcolher', 'iskpescar', 'iskminerar', 'iskforjar'],
  guilda: ['iskguilda', 'iskguilda_entrar', 'iskquest', 'iskqueststatus', 'iskranking'],
  mundo: ['iskmundo', 'iskmapa', 'isklocal', 'iskcidade', 'iskviajar', 'iskexplorar', 'iskeventos', 'iskrumores', 'iskreinos'],
  npcs: ['isknpc', 'iskfalar', 'iskrelacoes'],
  social: ['iskrelacoes', 'iskdar', 'isknamorar', 'iskcasar', 'iskfamilia', 'iskescolhas'],
  party: ['iskparty', 'iskconvidar', 'iskexpulsar', 'iskacampamento'],
  vida: ['iskferimentos', 'iskcura', 'iskmorte', 'isklegado', 'iskreencarnar', 'iskvidas'],
  magia: ['iskmagia', 'iskescola', 'iskaula', 'isktreinar'],
  divino: ['iskdeuses', 'iskorar', 'iskoferecer', 'iskpacto', 'iskbencaos', 'isktranscender', 'iskfavor'],
  destino: ['iskdestino', 'iskalinhamento', 'iskheroi', 'iskvilao', 'iskreputacao'],
  ranking: ['iskranking', 'isknivel'],
  assistente: ['iskajuda', 'iskdica', 'iskpainel'],
  sistema: ['iskiniciar', 'iskmodo', 'iskmodo_off', 'iskmenu']
};

const META = {
  personagem: '🌌', aventura: '⚔️', inventario: '🎒', economia: '💰',
  profissoes: '🌾', guilda: '🏰', mundo: '🗺️', npcs: '👥', social: '❤️',
  party: '⚔️', vida: '☠️', magia: '✨', divino: '🙏', destino: '👑',
  ranking: '🏆', assistente: '🧠', sistema: '⚙️'
};

function panel(key) {
  const list = SUB[key];
  if (!list) return 'Usa: iskmenu';
  const em = META[key] || '◇';
  let t = '╭──〔 ' + em + ' ' + key.toUpperCase() + ' 〕──╮\n';
  list.forEach(function (c) { t += '◈┃ ' + c + '\n'; });
  t += '╰──────────────────╯\n';
  t += '> 🥏┃ Total: ' + list.length + ' comandos\n';
  t += '❀────────────────❀\n';
  t += '> iskmenu';
  return t;
}

function h(key) {
  return async function (ctx) {
    await ctx.reply(panel(key));
  };
}

module.exports = [
  { name: 'iskpersonagem', aliases: [], category: 'isekai', handler: h('personagem') },
  { name: 'iskaventura', aliases: [], category: 'isekai', handler: h('aventura') },
  { name: 'iskinventario_menu', aliases: [], category: 'isekai', handler: h('inventario') },
  { name: 'iskeconomia', aliases: [], category: 'isekai', handler: h('economia') },
  { name: 'iskprofissoes', aliases: ['iskprofissao'], category: 'isekai', handler: h('profissoes') },
  { name: 'iskguilda_menu', aliases: [], category: 'isekai', handler: h('guilda') },
  { name: 'iskmundo', aliases: [], category: 'isekai', handler: h('mundo') },
  { name: 'isknpcs', aliases: [], category: 'isekai', handler: h('npcs') },
  { name: 'isksocial', aliases: [], category: 'isekai', handler: h('social') },
  { name: 'iskparty_menu', aliases: [], category: 'isekai', handler: h('party') },
  { name: 'iskvida', aliases: [], category: 'isekai', handler: h('vida') },
  { name: 'iskmagia_menu', aliases: [], category: 'isekai', handler: h('magia') },
  { name: 'iskdivino', aliases: [], category: 'isekai', handler: h('divino') },
  { name: 'iskdestino_menu', aliases: [], category: 'isekai', handler: h('destino') },
  { name: 'iskranking_menu', aliases: [], category: 'isekai', handler: h('ranking') },
  { name: 'iskassistente', aliases: [], category: 'isekai', handler: h('assistente') },
  { name: 'isksistema', aliases: [], category: 'isekai', handler: h('sistema') }
];
