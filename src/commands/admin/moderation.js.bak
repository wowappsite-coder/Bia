  {
    name: 'bemvindo',
    aliases: ['welcome', 'boasvindas'],
    category: 'admin',
    description: 'Ativa/desativa boas-vindas',
    groupOnly: true,
    adminOnly: true,
    usage: '!bemvindo on/off',
    handler: async (ctx) => {
      if (!(await requireGroupAdmin(ctx))) return;
      const arg = (ctx.args[0] || '').toLowerCase();
      if (arg === 'on' || arg === 'ativar') {
        db.updateGroup(ctx.jid, { welcome: 1 });
        await ctx.reply('✅ Boas-vindas ativadas.');
      } else if (arg === 'off' || arg === 'desativar') {
        db.updateGroup(ctx.jid, { welcome: 0 });
        await ctx.reply('✅ Boas-vindas desativadas.');
      } else {
        const g = ctx.group;
        await ctx.reply(`📬 Boas-vindas: ${g.welcome ? 'ATIVADO' : 'DESATIVADO'}\nUse !bemvindo on/off`);
      }
    }
