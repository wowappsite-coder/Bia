/**
 * Banco SQLite usando módulo nativo do Node (node:sqlite)
 * Não precisa compilar better-sqlite3 — ideal para Termux
 */
const { DatabaseSync } = require('node:sqlite');
const path = require('path');
const fs = require('fs');
const { SCHEMA } = require('./schema');
const config = require('../config');

let db = null;
let _currentScope = 'global';

function setScope(groupJid) {
  _currentScope = groupJid || 'global';
}
function getScope() {
  return _currentScope || 'global';
}

/** Wrapper para API parecida com better-sqlite3 */
function wrapDb(raw) {
  return {
    pragma(str) {
      try { raw.exec(`PRAGMA ${str}`); } catch (_) {}
    },
    exec(sql) {
      // executa em partes e ignora erros de "já existe" / colunas antigas
      const parts = String(sql).split(';').map(s => s.trim()).filter(Boolean);
      for (const part of parts) {
        try { raw.exec(part); } catch (e) {
          const m = String(e.message || e);
          if (/already exists|duplicate|no such column/i.test(m)) {
            // continua migração
          } else {
            console.warn('[DB]', m.slice(0, 120));
          }
        }
      }
    },
    prepare(sql) {
      const stmt = raw.prepare(sql);
      return {
        get(...params) {
          return stmt.get(...params);
        },
        all(...params) {
          return stmt.all(...params);
        },
        run(...params) {
          const r = stmt.run(...params);
          return {
            changes: r.changes,
            lastInsertRowid: Number(r.lastInsertRowid)
          };
        }
      };
    }
  };
}

function initDatabase() {
  const dbDir = path.dirname(config.dbPath);
  if (!fs.existsSync(dbDir)) {
    fs.mkdirSync(dbDir, { recursive: true });
  }

  // Garante que o caminho do banco fique no home do Termux se estiver em storage compartilhado
  let dbFile = config.dbPath;
  if (dbFile.includes('/storage/emulated/') || dbFile.includes('/sdcard/')) {
    const homeData = path.join(require('os').homedir(), 'beatriz-bot-data');
    if (!fs.existsSync(homeData)) fs.mkdirSync(homeData, { recursive: true });
    dbFile = path.join(homeData, 'beatriz.db');
    console.log('[DB] Storage compartilhado detectado. Usando:', dbFile);
  }

  const raw = new DatabaseSync(dbFile);
  db = wrapDb(raw);
  db.pragma('journal_mode = WAL');
  db.pragma('foreign_keys = ON');
  // 1) schema (tabelas)
  db.exec(SCHEMA);
  // 2) migra bancos antigos
  const alters = [
    "ALTER TABLE plans ADD COLUMN group_jid TEXT DEFAULT 'global'",
    "ALTER TABLE payments ADD COLUMN group_jid TEXT",
    "ALTER TABLE custom_commands ADD COLUMN group_jid TEXT DEFAULT 'global'",
    "ALTER TABLE relationships ADD COLUMN group_jid TEXT DEFAULT 'global'",
    "ALTER TABLE families ADD COLUMN group_jid TEXT DEFAULT 'global'",
    "ALTER TABLE pets ADD COLUMN group_jid TEXT DEFAULT 'global'",
    "ALTER TABLE orders ADD COLUMN group_jid TEXT",
  ];
  for (const a of alters) {
    try { raw.exec(a); } catch (_) {}
  }
  // 3) índices que dependem de group_jid
  const idxs = [
    "CREATE INDEX IF NOT EXISTS idx_plans_group ON plans(group_jid)",
    "CREATE INDEX IF NOT EXISTS idx_orders_group ON orders(group_jid)",
    "CREATE INDEX IF NOT EXISTS idx_purchases_group ON purchases(group_jid)",
  ];
  for (const i of idxs) {
    try { raw.exec(i); } catch (_) {}
  }
  try {
    db.exec(`CREATE TABLE IF NOT EXISTS user_group_data (
      jid TEXT NOT NULL,
      group_jid TEXT NOT NULL,
      wallet REAL DEFAULT 0,
      bank REAL DEFAULT 0,
      xp INTEGER DEFAULT 0,
      level INTEGER DEFAULT 1,
      messages INTEGER DEFAULT 0,
      inventory TEXT DEFAULT '{}',
      last_daily TEXT,
      last_work TEXT,
      last_crime TEXT,
      last_rob TEXT,
      job TEXT,
      updated_at TEXT DEFAULT (datetime('now')),
      PRIMARY KEY (jid, group_jid)
    )`);
  } catch (_) {}
  try { db.exec("ALTER TABLE relationships ADD COLUMN group_jid TEXT DEFAULT 'global'"); } catch (_) {}
  try { db.exec("ALTER TABLE families ADD COLUMN group_jid TEXT DEFAULT 'global'"); } catch (_) {}
  try { db.exec("ALTER TABLE pets ADD COLUMN group_jid TEXT DEFAULT 'global'"); } catch (_) {}
  try {
    db.exec(`CREATE TABLE IF NOT EXISTS purchases (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      group_jid TEXT NOT NULL,
      buyer_jid TEXT NOT NULL,
      buyer_number TEXT,
      product TEXT,
      amount_mb REAL NOT NULL DEFAULT 0,
      amount_label TEXT,
      price REAL DEFAULT 0,
      created_at TEXT DEFAULT (datetime('now'))
    )`);
  } catch (_) {}



  // Migrações leves (bancos antigos sem group_jid)
  try { db.exec("ALTER TABLE plans ADD COLUMN group_jid TEXT NOT NULL DEFAULT 'global'"); } catch (_) {}
  try { db.exec("ALTER TABLE custom_commands ADD COLUMN group_jid TEXT NOT NULL DEFAULT 'global'"); } catch (_) {}
  try { db.exec("ALTER TABLE payments ADD COLUMN group_jid TEXT"); } catch (_) {}
  try {
    db.exec(`CREATE TABLE IF NOT EXISTS group_settings (
      group_jid TEXT NOT NULL,
      key TEXT NOT NULL,
      value TEXT,
      PRIMARY KEY (group_jid, key)
    )`);
  } catch (_) {}


  const defaults = [
    ['payment_number', ''],
    ['payment_name', ''],
    ['bot_active', '1'],
    ['welcome_msg', 'Bem-vindo(a) @user ao grupo *{group}*!'],
    ['goodbye_msg', 'Tchau @user, sentiremos sua falta!']
  ];
  const insertSetting = db.prepare('INSERT OR IGNORE INTO settings (key, value) VALUES (?, ?)');
  defaults.forEach(([k, v]) => insertSetting.run(k, v));

  try {
    db.prepare(`INSERT OR IGNORE INTO bot_admins (jid, number, added_by) VALUES (?, ?, ?)`)
      .run(config.ownerJid, config.ownerNumber, 'system');
  } catch (_) {}

  console.log('[DB] Banco de dados inicializado:', dbFile);
  return db;
}

function getDb() {
  if (!db) initDatabase();
  return db;
}

function getUser(jid, groupJid) {
  const database = getDb();
  const g = groupJid || getScope() || 'global';
  let base = database.prepare('SELECT * FROM users WHERE jid = ?').get(jid);
  if (!base) {
    const number = String(jid).replace(/\D/g, '').slice(-12);
    database.prepare('INSERT INTO users (jid, number) VALUES (?, ?)').run(jid, number);
    base = database.prepare('SELECT * FROM users WHERE jid = ?').get(jid);
  }
  let ug = database.prepare('SELECT * FROM user_group_data WHERE jid = ? AND group_jid = ?').get(jid, g);
  if (!ug) {
    database.prepare('INSERT INTO user_group_data (jid, group_jid) VALUES (?, ?)').run(jid, g);
    ug = database.prepare('SELECT * FROM user_group_data WHERE jid = ? AND group_jid = ?').get(jid, g);
  }
  return {
    ...base,
    wallet: ug.wallet || 0,
    bank: ug.bank || 0,
    xp: ug.xp || 0,
    level: ug.level || 1,
    messages: ug.messages || 0,
    inventory: ug.inventory || '{}',
    last_daily: ug.last_daily,
    last_work: ug.last_work,
    last_crime: ug.last_crime,
    last_rob: ug.last_rob,
    job: ug.job,
    _group_jid: g
  };
}

function updateUser(jid, data, groupJid) {
  const database = getDb();
  const g = groupJid || getScope() || 'global';
  if (!data || !Object.keys(data).length) return;
  getUser(jid, g);
  const ugFields = ['wallet','bank','xp','level','messages','inventory','last_daily','last_work','last_crime','last_rob','job'];
  const ugData = {};
  const userData = {};
  for (const [k, v] of Object.entries(data)) {
    if (ugFields.includes(k)) ugData[k] = v;
    else userData[k] = v;
  }
  if (Object.keys(ugData).length) {
    const sets = Object.keys(ugData).map(k => k + ' = ?').join(', ');
    database.prepare('UPDATE user_group_data SET ' + sets + ', updated_at = datetime(\'now\') WHERE jid = ? AND group_jid = ?')
      .run(...Object.values(ugData), jid, g);
  }
  if (Object.keys(userData).length) {
    const sets = Object.keys(userData).map(k => k + ' = ?').join(', ');
    database.prepare('UPDATE users SET ' + sets + ', updated_at = datetime(\'now\') WHERE jid = ?')
      .run(...Object.values(userData), jid);
  }
}

function getGroup(jid) {
  const database = getDb();
  let group = database.prepare('SELECT * FROM groups WHERE jid = ?').get(jid);
  if (!group) {
    database.prepare(`INSERT INTO groups (jid) VALUES (?)`).run(jid);
    group = database.prepare('SELECT * FROM groups WHERE jid = ?').get(jid);
  }
  return group;
}

function updateGroup(jid, data) {
  const database = getDb();
  const keys = Object.keys(data);
  if (!keys.length) return;
  const sets = keys.map(k => `${k} = ?`).join(', ');
  const values = keys.map(k => data[k]);
  database.prepare(`UPDATE groups SET ${sets}, updated_at = datetime('now') WHERE jid = ?`)
    .run(...values, jid);
}

function isBotAdmin(jid) {
  if (config.isOwner(jid)) return true;
  const database = getDb();
  const row = database.prepare('SELECT 1 FROM bot_admins WHERE jid = ?').get(jid);
  return !!row;
}

function isBlacklisted(jid) {
  const database = getDb();
  return !!database.prepare('SELECT 1 FROM blacklist WHERE jid = ?').get(jid);
}

function getSetting(key, defaultValue = null) {
  const database = getDb();
  const row = database.prepare('SELECT value FROM settings WHERE key = ?').get(key);
  return row ? row.value : defaultValue;
}

function setSetting(key, value) {
  const database = getDb();
  database.prepare('INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)').run(key, String(value));
}

function log(type, message, jid = null, data = null) {
  try {
    const database = getDb();
    database.prepare('INSERT INTO logs (type, message, jid, data) VALUES (?, ?, ?, ?)')
      .run(type, message, jid, data ? JSON.stringify(data) : null);
  } catch (e) {
    console.error('[LOG ERROR]', e.message);
  }
}


function getGroupSetting(groupJid, key, defaultValue = null) {
  if (!groupJid) return getSetting(key, defaultValue);
  const database = getDb();
  const row = database.prepare('SELECT value FROM group_settings WHERE group_jid = ? AND key = ?').get(groupJid, key);
  if (row) return row.value;
  return getSetting(key, defaultValue); // fallback global
}

function setGroupSetting(groupJid, key, value) {
  const database = getDb();
  database.prepare(
    'INSERT OR REPLACE INTO group_settings (group_jid, key, value) VALUES (?, ?, ?)'
  ).run(groupJid, key, String(value));
}

function scopeGroup(ctx) {
  // Em grupo usa jid do grupo; no privado usa global
  if (ctx && ctx.isGroup && ctx.jid) return ctx.jid;
  return 'global';
}

module.exports = {
  setScope,
  getScope,
  initDatabase,
  getDb,
  getUser,
  updateUser,
  getGroup,
  updateGroup,
  isBotAdmin,
  isBlacklisted,
  getSetting,
  setSetting,
  getGroupSetting,
  setGroupSetting,
  scopeGroup,
  log
};
