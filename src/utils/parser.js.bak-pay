/**
 * Parser de mensagens - prefixo e sem prefixo + detecção de pagamentos
 */

const config = require('../config');
const registry = require('../commands/registry');

/**
 * Extrai texto de mensagem Baileys
 */
function extractText(msg) {
  if (!msg?.message) return '';
  const m = msg.message;
  return (
    m.conversation ||
    m.extendedTextMessage?.text ||
    m.imageMessage?.caption ||
    m.videoMessage?.caption ||
    m.documentMessage?.caption ||
    m.buttonsResponseMessage?.selectedDisplayText ||
    m.listResponseMessage?.title ||
    m.templateButtonReplyMessage?.selectedDisplayText ||
    ''
  ).trim();
}

/**
 * Detecta se a mensagem parece um comprovativo de pagamento
 * Retorna dados extraídos ou null
 */
function detectPayment(text) {
  if (!text || text.length < 30) return null;

  const lower = text.toLowerCase();

  // Identificadores comuns de provedores MZ
  let provider = null;
  if (lower.includes('mpesa') || lower.includes('m-pesa') || /id\s*trans/i.test(text) || /trans:\s*[a-z0-9.]+/i.test(text)) {
    provider = 'mpesa';
  } else if (lower.includes('e-mola') || lower.includes('emola') || lower.includes('e mola')) {
    provider = 'emola';
  } else if (lower.includes('m-kash') || lower.includes('mkash') || lower.includes('m kash')) {
    provider = 'mkash';
  }

  // Padrões genéricos de comprovativo
  const hasConfirmed = /confirmado|confirmed|enviou|recebeu|transferência|transferencia/i.test(text);
  const hasValue = /(?:valor|value|mt|mzn)[:\s]*[\d.,]+/i.test(text) || /[\d.,]+\s*(?:mt|mzn)/i.test(text);
  const hasId = /(?:id|trans|ref|código|codigo|chave)[\s:]*[a-z0-9.]+/i.test(text) || /[A-Z0-9]{8,}/.test(text);

  if (!provider && !(hasConfirmed && hasValue && hasId)) return null;
  if (!hasValue) return null;

  // Extração
  const result = {
    provider: provider || 'unknown',
    transactionId: null,
    value: null,
    fee: null,
    destinationNumber: null,
    destinationName: null,
    date: null,
    time: null,
    raw: text
  };

  // ID da transação (formatos MZ: CO260808.1125.m89748 / etc)
  const idPatterns = [
    /ID\s*Trans[:\s.]*([A-Za-z0-9.]{8,})/i,
    /(?:Trans|Ref|Código|Codigo|Chave)[:\s.]*([A-Za-z0-9.]{8,})/i,
    /\b([A-Z]{1,3}\d{6,}\.[\d.]+[A-Za-z0-9.]*)\b/,
    /\b([A-Z0-9]{10,})\b/
  ];
  for (const p of idPatterns) {
    const m = text.match(p);
    if (m) {
      result.transactionId = m[1].replace(/\.+$/, '').trim();
      break;
    }
  }

  // Valor (ex: valor: 20.00MT)
  const valuePatterns = [
    /valor[:\s]*([\d.,]+)\s*(?:mt|mzn)?/i,
    /([\d.,]+)\s*(?:mt|mzn)/i,
    /enviou[^\d]{0,40}([\d.,]+)/i
  ];
  for (const p of valuePatterns) {
    const m = text.match(p);
    if (m) {
      result.value = parseFloat(m[1].replace(',', '.'));
      break;
    }
  }

  // Taxa
  const feeMatch = text.match(/taxa[:\s]*([\d.,]+)/i);
  if (feeMatch) result.fee = parseFloat(feeMatch[1].replace(',', '.'));

  // Número destino (ex: Enviou para o MPESA 857144748)
  const numMatch = text.match(/(?:para\s+o\s+)?(?:MPESA|M-PESA|EMOLA|E-MOLA|MKASH|M-KASH)\s+(\d{8,12})/i) ||
                   text.match(/(?:para|destino)[\s:]*(\d{8,12})/i) ||
                   text.match(/\b(8[4-7]\d{7})\b/);
  if (numMatch) result.destinationNumber = numMatch[1];

  // Nome
  const nameMatch = text.match(/(?:nome|para)\s+([A-ZÁÉÍÓÚÂÊÎÔÛÃÕÇ\s]{3,40})/i);
  if (nameMatch) result.destinationName = nameMatch[1].trim();

  // Data e hora
  const dateMatch = text.match(/(\d{1,2}\/\d{1,2}\/\d{2,4})/);
  if (dateMatch) result.date = dateMatch[1];
  const timeMatch = text.match(/(\d{1,2}:\d{2}(?::\d{2})?)/);
  if (timeMatch) result.time = timeMatch[1];

  // Só considera válido se tiver pelo menos ID ou valor significativo
  if (!result.transactionId && !result.value) return null;

  return result;
}

/**
 * Parseia mensagem em comando
 * Suporta:
 *   !comando args
 *   comando args  (sem prefixo, se existir no registry)
 */
function normalizeCmd(s) {
  if (!s) return '';
  try {
    return String(s).normalize('NFC').toLowerCase().replace(/\s+/g, ' ').trim();
  } catch (_) {
    return String(s).toLowerCase().replace(/\s+/g, ' ').trim();
  }
}

function parseMessage(msg, customPrefixes = null) {
  const body = extractText(msg);
  if (!body) return null;

  const prefixes = customPrefixes || config.prefixes;
  let hasPrefix = false;
  let prefix = '';
  let rest = body;

  // Verifica prefixo
  for (const p of prefixes) {
    if (body.startsWith(p)) {
      hasPrefix = true;
      prefix = p;
      rest = body.slice(p.length).trim();
      break;
    }
  }

  if (!rest) return null;

  const parts = rest.split(/\s+/);
  const commandCandidate = normalizeCmd(parts[0]);
  const args = parts.slice(1);
  const text = args.join(' ');

  // Com prefixo: sempre tenta como comando
  if (hasPrefix) {
    return {
      body,
      command: commandCandidate,
      args,
      text,
      prefix,
      hasPrefix: true,
      isPayment: false
    };
  }

  // Sem prefixo: só se existir no registry (evita conflito com mensagens normais)
  const cmd = registry.get(commandCandidate);
  if (cmd) {
    return {
      body,
      command: commandCandidate,
      args,
      text,
      prefix: '',
      hasPrefix: false,
      isPayment: false
    };
  }

  // Verifica se é comprovativo de pagamento (sem prefixo)
  const payment = detectPayment(body);
  if (payment) {
    return {
      body,
      command: null,
      args: [],
      text: body,
      prefix: '',
      hasPrefix: false,
      isPayment: true,
      paymentData: payment
    };
  }

  return null; // mensagem normal, ignora
}

module.exports = {
  extractText,
  detectPayment,
  parseMessage,
  normalizeCmd
};
