const isekaiDb = require('../../isekai/db');
const ui = require('../../isekai/ui');
const combat = require('../../isekai/combat');

function need(ctx) {
  const g = isekaiDb.scopeGroup(ctx);
  const d = isekaiDb.getPlayerData(ctx.sender, g);
  if (!d || !d.race) return { ok: false, msg: 'Cria personagem: iskiniciar Nome' };
  return { ok: true, data: d, group: g };
}

module.exports = [
  {
    name: 'iskmenu',
    aliases: ['iskhelp', 'iskpainel'],
    category: 'isekai',
    handler: async (ctx) => {
      await ctx.reply(ui.formatMenu());
    }
  },
  {
    name: 'iskstatus',
    aliases: ['iskficha', 'iskperfil'],
    category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx);
      if (!n.ok) return ctx.reply(n.msg);
      let msg = ui.formatStatus(n.data);
      const b = combat.getBattle(ctx.sender, n.group);
      if (b && b.enemy) {
        msg += '\n\n' + ui.formatCombat(n.data, b);
      }
      await ctx.reply(msg);
    }
  },
  {
    name: 'iskdica',
    aliases: ['iskoquefazer', 'iskassistente'],
    category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx);
      if (!n.ok) return ctx.reply(n.msg);
      await ctx.reply(ui.assistant(n.data, 'geral'));
    }
  },
  {
    name: 'iskpainel',
    category: 'isekai',
    handler: async (ctx) => {
      const n = need(ctx);
      if (!n.ok) return ctx.reply(n.msg);
      const b = combat.getBattle(ctx.sender, n.group);
      if (b) return ctx.reply(ui.formatCombat(n.data, b));
      await ctx.reply(ui.formatStatus(n.data));
    }
  }
];
