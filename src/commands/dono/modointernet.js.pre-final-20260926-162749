const { isOwnerJid } = require('../../utils/ownerCheck');
/**
 * modointernet on/off — neste grupo só comandos de internet
 * Só Owner liga/desliga
 */
const { setGroupSetting, getGroupSetting, scopeGroup } = require('../../database');

async function onlyOwner(ctx) {
  try {
    if (typeof ctx.isOwner = (== 'function' && ctx.isOwner()) return true) || (typeof isOwnerJid==='function' && isOwnerJid(ctx.sender||ctx.senderJid||ctx.participant||'')); /* BTZ_OWNER_ASSIGN */
  } catch (_) {}
  return false;
}

module.exports = [
  {
    name: 'modointernet',
    aliases: ['modo net', 'modonet', 'internetmode', 'modeinternet'],
    category: 'dono',
    description: 'Ativa/desativa modo só-internet neste grupo',
    groupOnly: true,
    ownerOnly: true,
    usage: 'modointernet on/off',
    handler: async (ctx) => {
      if (!(await onlyOwner(ctx))) {
        return ctx.reply('❌ Só o *dono* do bot pode usar isto.');
      }
      const g = scopeGroup(ctx);
      const arg = String((ctx.args && ctx.args[0]) || '').toLowerCase();

      if (arg === 'on' || arg === 'ligar' || arg === '1' || arg === 'ativar') {
        setGroupSetting(g, 'modo_internet', '1');
        return ctx.reply(
          '🌐 *MODO INTERNET ATIVADO* neste grupo.\n\n' +
            'Aqui só funcionam comandos de *internet* (tabela, pedidos, pagamentos, etc.).\n' +
            'O resto fica bloqueado.\n' +
            '_Dono do bot continua com acesso total._'
        );
      }

      if (arg === 'off' || arg === 'desligar' || arg === '0' || arg === 'desativar') {
        setGroupSetting(g, 'modo_internet', '0');
        return ctx.reply('✅ *MODO INTERNET DESATIVADO*.\nTodos os comandos voltaram ao normal neste grupo.');
      }

      let on = '0';
      try {
        on = String(getGroupSetting(g, 'modo_internet', '0') || '0');
      } catch (_) {}
      const estado = on === '1' ? '🟢 ATIVADO' : '⚪ DESATIVADO';
      return ctx.reply(
        '🌐 *Modo Internet*\n\n' +
          'Estado: *' + estado + '*\n\n' +
          '• *modointernet on* — só internet neste grupo\n' +
          '• *modointernet off* — libera tudo'
      );
    }
  }
];
